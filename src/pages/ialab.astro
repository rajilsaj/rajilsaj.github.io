---
const title = 'IA Lab'
const description = 'Interactive AI Lab - Candidate selection and evaluation tool'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl =
  'https://script.google.com/macros/s/AKfycbzE1MLVDl7YWS-VZTdIbbxW94YMPWpHkgxMCSqaz28CXS3lQqcChHZ3OfGc_u2XUmM/exec'
// TODO: set the Checklist and Rapport app URLs; an empty URL shows the button as "bientôt".
const checklistUrl = ''
const reportUrl = ''
const tools = [
  { label: 'Sélection', href: appUrl, primary: true },
  { label: 'Checklist', href: checklistUrl },
  { label: 'Rapport', href: reportUrl },
  {
    label: 'Compte rendu de session',
    sub: 'par les formateurs',
    href: 'https://script.google.com/macros/s/AKfycbxmP6veZ9pfXPhZhM2FvGUv1yyRjd-GW9VDxSeoiVjr8qSi-yxhrE65WDUybv7Idb_mDA/exec',
    color: 'yellow',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --ialab-blue: #3985d1;
        /* Same hue saturation/lightness as the blue, shifted to yellow */
        --ialab-yellow: #cfaa3a;
      }
      html,
      body {
        width: 100%;
        min-height: 100%;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
          sans-serif;
        background: #fff;
      }
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 20px;
      }
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }
      footer {
        padding: 24px 0 8px;
        font-size: 0.85em;
        color: #999;
        text-align: center;
      }
      footer a {
        color: var(--ialab-blue);
        font-weight: 600;
        text-decoration: none;
      }
      footer a:hover {
        text-decoration: underline;
      }
      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 420px;
      }
      .logo {
        width: 100%;
        max-width: 320px;
        height: auto;
        margin-bottom: 20px;
      }
      p {
        font-size: 1.05em;
        color: #555;
        margin-bottom: 32px;
        line-height: 1.6;
      }
      .tubes {
        display: flex;
        flex-direction: column;
        gap: 18px;
        width: 100%;
        max-width: 360px;
      }
      /* Tube buttons. On hover the blue pill morphs: a filled button shrinks into a
         circle holding an arrow, an outlined one grows from that circle to full. */
      .tube {
        --h: 60px;
        --bw: 2.5px;
        /* --c: fill and border, --ink: text when outlined, --on: text on the fill */
        --c: var(--ialab-blue);
        --ink: var(--ialab-blue);
        --on: #fff;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: var(--h);
        padding: 0 32px;
        border: var(--bw) solid var(--c);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        font-family:
          'Nunito',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-weight: 700;
        font-size: 1.05em;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        text-decoration: none;
        isolation: isolate;
        transition:
          color 0.4s ease,
          transform 0.15s ease;
      }
      .tube::before {
        content: '';
        position: absolute;
        top: calc(-1 * var(--bw));
        bottom: calc(-1 * var(--bw));
        left: calc(-1 * var(--bw));
        z-index: -1;
        width: 0;
        border-radius: 999px;
        background: var(--c);
        transition: width 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .tube .label {
        transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .tube .arrow {
        position: absolute;
        left: calc(var(--h) / 2 - var(--bw) - 10px);
        width: 20px;
        height: 20px;
        color: var(--on);
        opacity: 0;
        transform: translateX(-10px);
        transition:
          opacity 0.3s ease,
          transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      /* Outlined -> filled */
      .tube:hover::before,
      .tube:focus-visible::before {
        width: calc(100% + 2 * var(--bw));
      }
      .tube:hover,
      .tube:focus-visible {
        color: var(--on);
      }
      /* Filled (primary) -> outlined with a circle */
      .tube.primary {
        color: var(--on);
      }
      .tube.primary::before {
        width: calc(100% + 2 * var(--bw));
      }
      .tube.primary:hover::before,
      .tube.primary:focus-visible::before {
        width: var(--h);
      }
      .tube.primary:hover,
      .tube.primary:focus-visible {
        color: var(--ink);
      }
      /* Both: arrow slides in, label makes room */
      .tube:hover .arrow,
      .tube:focus-visible .arrow {
        opacity: 1;
        transform: translateX(0);
        transition-delay: 0.15s, 0s;
      }
      .tube:hover .label,
      .tube:focus-visible .label {
        transform: translateX(14px);
      }
      .tube.yellow {
        --c: var(--ialab-yellow);
        --ink: #8a6a12;
        --on: #2e2305;
      }
      .tube .label {
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1.2;
      }
      .tube .sub {
        font-size: 0.68em;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: none;
        opacity: 0.85;
      }
      .tube:has(.sub) {
        padding: 0 24px;
        font-size: 0.92em;
        letter-spacing: 0.1em;
      }
      .tube:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--c) 35%, transparent);
        outline-offset: 4px;
      }
      .tube:active {
        transform: scale(0.97);
      }
      .tube.soon {
        border-style: dashed;
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
      }
      .tube .soon-tag {
        margin-left: 0.6em;
        font-size: 0.65em;
        letter-spacing: 0.08em;
        text-transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .tube,
        .tube::before,
        .tube .label,
        .tube .arrow {
          transition: none;
        }
      }
      .note {
        font-size: 0.9em;
        color: #999;
        margin-top: 28px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="container">
        <img class="logo" src="/ialab-logo.png" alt="ia.lab" width="768" height="237" />
        <p>
          Outil de sélection et d'évaluation des candidats avec collaboration en temps
          réel et suivi
        </p>
        <div class="tubes">
          {
            tools.map((t) =>
              t.href ? (
                <a
                  href={t.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={['tube', t.color, { primary: t.primary }]}
                >
                  <svg
                    class="arrow"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                  <span class="label">
                    {t.label}
                    {t.sub && <span class="sub">{t.sub}</span>}
                  </span>
                </a>
              ) : (
                <span class="tube soon" aria-disabled="true">
                  {t.label}
                  <span class="soon-tag">bientôt</span>
                </span>
              ),
            )
          }
        </div>
        <div class="note">
          S'ouvre dans une nouvelle fenêtre. Connectez-vous avec votre compte Google pour
          accéder.
        </div>
      </div>
    </main>
    <footer>
      Propulsé par la <a
        href="https://bantuhub.com/"
        target="_blank"
        rel="noopener noreferrer">Fondation BantuHub</a
      >
    </footer>
  </body>
</html>
