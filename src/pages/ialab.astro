---
const title = 'IA Lab'
const description = 'Interactive AI Lab - Candidate selection and evaluation tool'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl =
  'https://script.google.com/macros/s/AKfycbzE1MLVDl7YWS-VZTdIbbxW94YMPWpHkgxMCSqaz28CXS3lQqcChHZ3OfGc_u2XUmM/exec'
const checklistUrl =
  'https://script.google.com/macros/s/AKfycbzFz1azMYEbuDo8-ghYB3CnS73Q_3E4KAjNfOLEUMoX8ofXBj_67S5Bm1Xzh5bKoC5O/exec'
// Rapport has no app URL yet.
const reportUrl = ''
// `locked` tools are shown greyed and not clickable; their href is kept for later.
const groups = [
  {
    title: 'Pilotage',
    layout: 'trio',
    items: [
      { label: 'Le Casting', sub: 'sélection des candidats', href: appUrl, locked: true },
      { label: 'Tour de contrôle', sub: 'checklist', href: checklistUrl },
      { label: 'Le Grand Bilan', sub: 'rapport', href: reportUrl, locked: true },
    ],
  },
  {
    title: 'Espace formateurs',
    layout: 'solo',
    audience: 'Réservé aux formateurs',
    items: [
      {
        label: 'Compte rendu de session',
        sub: 'par les formateurs',
        href: 'https://script.google.com/macros/s/AKfycbxmP6veZ9pfXPhZhM2FvGUv1yyRjd-GW9VDxSeoiVjr8qSi-yxhrE65WDUybv7Idb_mDA/exec',
        color: 'yellow',
      },
    ],
  },
  {
    title: 'Feedback apprenants',
    layout: 'modules',
    audience: 'Réservé aux apprenants',
    items: [
      {
        label: 'Module 1',
        href: 'https://script.google.com/macros/s/AKfycbwL6T1JP7OV28c6SZh4RSnuBoOT-JieT2FjsQI-EyKEwvXBDcI6-u9qFGaFlToBkV3A/exec',
      },
      {
        label: 'Module 2',
        href: 'https://script.google.com/macros/s/AKfycbwCoMGLfHJ46hT5yWmi9HsTLFCb_bGz2VHI2Wv5gE53dWibvROhVIaB7ICC87Jw2m30hw/exec',
      },
      {
        label: 'Module 3',
        href: 'https://script.google.com/macros/s/AKfycbxUszTmn70GdNRJ_kfJZj4vFtpWUGXXMEtBoR2jplp5j7nlQ6k8NUUg20GdwdS2zRqX/exec',
      },
      {
        label: 'Module 4',
        href: 'https://script.google.com/macros/s/AKfycbxHyMkor8abWNwbJnehwIshF35t6DPrgSJ8VyOl6OlIjzdGhZ9loCyFDwQjaN9ph3Y/exec',
      },
      {
        label: 'Module 5',
        href: 'https://script.google.com/macros/s/AKfycbxlhaKm6grIJXTLFDlQ5ODklmT-Vk6fRaLBT3LB9H8ZeCxhZsgIEz1g6LMno_06WAH1qA/exec',
      },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --ialab-blue: #3985d1;
        /* Same hue saturation/lightness as the blue, shifted to yellow */
        --ialab-yellow: #cfaa3a;
      }
      html,
      body {
        width: 100%;
        min-height: 100%;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
          sans-serif;
        background: #fff;
      }
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 16px 20px;
      }
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }
      footer {
        padding: 12px 0 4px;
        font-size: 0.85em;
        color: #999;
        text-align: center;
      }
      footer a {
        color: var(--ialab-blue);
        font-weight: 600;
        text-decoration: none;
      }
      footer a:hover {
        text-decoration: underline;
      }
      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 820px;
      }
      .logo {
        width: 100%;
        max-width: 220px;
        height: auto;
        margin-bottom: 12px;
      }
      p {
        font-size: 1em;
        color: #555;
        margin-bottom: 24px;
        line-height: 1.5;
      }
      .group {
        width: 100%;
        margin-bottom: 22px;
      }
      .group:last-child {
        margin-bottom: 0;
      }
      .group-title {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 6px 10px;
        margin-bottom: 10px;
        font-family:
          'Nunito',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-size: 0.8em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #8a929c;
      }
      .audience {
        padding: 3px 10px;
        border-radius: 999px;
        background: #eef3fa;
        color: var(--ialab-blue);
        font-size: 0.85em;
        letter-spacing: 0.06em;
        text-transform: none;
      }
      .group:has(.yellow) .audience {
        background: #faf3de;
        color: #8a6a12;
      }
      .tubes {
        display: grid;
        gap: 12px;
        width: 100%;
        margin: 0 auto;
      }
      .group.trio .tubes {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .solo .tubes {
        max-width: 400px;
      }
      .group.modules .tubes {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
      /* Compact rows: smaller type, fill sweep only (no arrow circle) */
      .group.trio .tube,
      .group.modules .tube {
        padding: 0 12px;
        font-size: 0.85em;
        letter-spacing: 0.1em;
      }
      .group.trio .tube .arrow,
      .group.modules .tube .arrow {
        display: none;
      }
      .group.trio .tube .label,
      .group.modules .tube .label {
        transform: none !important;
      }
      .group.trio .tube .arrow ~ .label {
        padding-left: 18px;
      }
      /* Tube buttons. On hover the blue pill morphs: a filled button shrinks into a
         circle holding an arrow, an outlined one grows from that circle to full. */
      .tube {
        --h: 52px;
        --bw: 2.5px;
        /* --c: fill and border, --ink: text when outlined, --on: text on the fill */
        --c: var(--ialab-blue);
        --ink: var(--ialab-blue);
        --on: #fff;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: var(--h);
        padding: 0 32px;
        border: var(--bw) solid var(--c);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        font-family:
          'Nunito',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-weight: 700;
        font-size: 1.05em;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        text-decoration: none;
        isolation: isolate;
        transition:
          color 0.4s ease,
          transform 0.15s ease;
      }
      .tube::before {
        content: '';
        position: absolute;
        top: calc(-1 * var(--bw));
        bottom: calc(-1 * var(--bw));
        left: calc(-1 * var(--bw));
        z-index: -1;
        width: 0;
        border-radius: 999px;
        background: var(--c);
        transition: width 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .tube .label {
        transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .tube .arrow {
        position: absolute;
        left: calc(var(--h) / 2 - var(--bw) - 10px);
        width: 20px;
        height: 20px;
        color: var(--on);
        opacity: 0;
        transform: translateX(-10px);
        transition:
          opacity 0.3s ease,
          transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
      }
      /* Outlined -> filled */
      .tube:hover::before,
      .tube:focus-visible::before {
        width: calc(100% + 2 * var(--bw));
      }
      .tube:hover,
      .tube:focus-visible {
        color: var(--on);
      }
      /* Filled (primary) -> outlined with a circle */
      .tube.primary {
        color: var(--on);
      }
      .tube.primary::before {
        width: calc(100% + 2 * var(--bw));
      }
      .tube.primary:hover::before,
      .tube.primary:focus-visible::before {
        width: var(--h);
      }
      .tube.primary:hover,
      .tube.primary:focus-visible {
        color: var(--ink);
      }
      /* Both: arrow slides in, label makes room */
      .tube:hover .arrow,
      .tube:focus-visible .arrow {
        opacity: 1;
        transform: translateX(0);
        transition-delay: 0.15s, 0s;
      }
      .tube:hover .label,
      .tube:focus-visible .label {
        transform: translateX(14px);
      }
      .tube.yellow {
        --c: var(--ialab-yellow);
        --ink: #8a6a12;
        --on: #2e2305;
      }
      .tube .label {
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1.2;
      }
      .tube .sub {
        font-size: 0.68em;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: none;
        opacity: 0.85;
      }
      .tube:has(.sub) {
        padding: 0 24px;
        font-size: 0.92em;
        letter-spacing: 0.1em;
      }
      .tube:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--c) 35%, transparent);
        outline-offset: 4px;
      }
      .tube:active {
        transform: scale(0.97);
      }
      /* Locked: greyed, no hover morph, a padlock where the arrow would be */
      .tube.locked {
        --c: #c3c8cf;
        --ink: #9aa1ab;
        cursor: not-allowed;
        user-select: none;
      }
      .tube.locked:hover::before {
        width: 0;
      }
      .tube.locked:hover {
        color: var(--ink);
      }
      .tube.locked:hover .label {
        transform: none;
      }
      .group.trio .tube.locked .arrow {
        display: block;
        left: 14px;
        width: 16px;
        height: 16px;
      }
      .tube.locked .arrow {
        color: var(--ink);
        opacity: 1;
        transform: none;
      }
      @media (max-width: 640px) {
        .logo {
          max-width: 170px;
        }
        p {
          font-size: 0.9em;
          margin-bottom: 18px;
        }
        .group {
          margin-bottom: 16px;
        }
        .tubes {
          gap: 8px;
        }
        .group.modules .tubes {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .group.trio .tube,
        .group.modules .tube {
          padding: 0 6px;
          font-size: 0.72em;
          letter-spacing: 0.05em;
        }
        .group.trio .tube .sub,
        .group.trio .tube.locked .arrow {
          display: none;
        }
        .group.trio .tube .arrow ~ .label {
          padding-left: 0;
        }
        .tube:has(.sub) {
          font-size: 0.85em;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .tube,
        .tube::before,
        .tube .label,
        .tube .arrow {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="container">
        <img class="logo" src="/ialab-logo.png" alt="ia.lab" width="768" height="237" />
        <p>
          Outil de sélection et d'évaluation des candidats avec collaboration en temps
          réel et suivi
        </p>
        {
          groups.map((g) => (
            <section class:list={['group', g.layout]}>
              <h2 class="group-title">
                {g.title}
                {g.audience && <span class="audience">{g.audience}</span>}
              </h2>
              <div class="tubes">
                {g.items.map((t) =>
                  t.href && !t.locked ? (
                    <a
                      href={t.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={['tube', t.color, { primary: t.primary }]}
                    >
                      <svg
                        class="arrow"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                      <span class="label">
                        {t.label}
                        {t.sub && <span class="sub">{t.sub}</span>}
                      </span>
                    </a>
                  ) : (
                    <span
                      class="tube locked"
                      aria-disabled="true"
                      title="Accès fermé"
                      data-href={t.href || undefined}
                    >
                      <svg
                        class="arrow"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="5" y="11" width="14" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                      </svg>
                      <span class="label">
                        {t.label}
                        {t.sub && <span class="sub">{t.sub}</span>}
                      </span>
                    </span>
                  ),
                )}
              </div>
            </section>
          ))
        }
      </div>
    </main>
    <footer>
      Propulsé par la <a
        href="https://bantuhub.com/"
        target="_blank"
        rel="noopener noreferrer">Fondation BantuHub</a
      >
    </footer>
  </body>
</html>
