---
const title = 'IA Lab'
const description = 'Interactive AI Lab - Candidate selection and evaluation tool'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl = 'https://script.google.com/macros/s/AKfycbzE1MLVDl7YWS-VZTdIbbxW94YMPWpHkgxMCSqaz28CXS3lQqcChHZ3OfGc_u2XUmM/exec'
// TODO: set the Checklist and Rapport app URLs; an empty URL shows the button as "bientôt".
const checklistUrl = ''
const reportUrl = ''
const tools = [
  { label: 'Sélection', icon: '🧑‍🔬', href: appUrl },
  { label: 'Checklist', icon: '✅', href: checklistUrl },
  { label: 'Rapport', icon: '📊', href: reportUrl },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100%;
        height: 100%;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .container {
        text-align: center;
        background: white;
        border-radius: 12px;
        padding: 60px 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        max-width: 720px;
        width: 100%;
      }
      h1 {
        font-size: 2.5em;
        color: #333;
        margin-bottom: 16px;
        font-weight: 700;
      }
      p {
        font-size: 1.1em;
        color: #666;
        margin-bottom: 32px;
        line-height: 1.6;
      }
      .tubes {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
      }
      /* Tube buttons: capsule shape with cylindrical shading and a glass highlight */
      .tube {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 170px;
        padding: 16px 28px;
        border-radius: 999px;
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05em;
        letter-spacing: 0.02em;
        background: linear-gradient(
          180deg,
          #8fa2f5 0%,
          #667eea 22%,
          #5a4fc4 55%,
          #764ba2 85%,
          #5b3a80 100%
        );
        border: 1px solid rgba(80, 60, 160, 0.6);
        box-shadow:
          inset 0 -4px 8px rgba(0, 0, 0, 0.25),
          inset 0 2px 2px rgba(255, 255, 255, 0.35),
          0 6px 16px rgba(102, 126, 234, 0.45);
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s, filter 0.2s;
      }
      .tube::before {
        content: '';
        position: absolute;
        top: 3px;
        left: 14px;
        right: 14px;
        height: 42%;
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
        pointer-events: none;
      }
      .tube:hover {
        transform: translateY(-2px);
        filter: brightness(1.08);
        box-shadow:
          inset 0 -4px 8px rgba(0, 0, 0, 0.25),
          inset 0 2px 2px rgba(255, 255, 255, 0.35),
          0 10px 22px rgba(102, 126, 234, 0.6);
      }
      .tube:active {
        transform: translateY(0);
      }
      .tube.soon {
        filter: grayscale(0.7);
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;
      }
      .tube .soon-tag {
        font-size: 0.7em;
        font-weight: 500;
        opacity: 0.9;
      }
      .icon {
        font-size: 3em;
        margin-bottom: 20px;
      }
      .note {
        font-size: 0.9em;
        color: #999;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #eee;
      }
      @media (max-width: 600px) {
        .container {
          padding: 40px 24px;
        }
        h1 {
          font-size: 2em;
        }
        p {
          font-size: 1em;
        }
        .tubes {
          flex-direction: column;
          align-items: stretch;
        }
        .tube {
          padding: 14px 24px;
          font-size: 1em;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon">🔬</div>
      <h1>IA Lab</h1>
      <p>Outil de sélection et d'évaluation des candidats avec collaboration en temps réel et suivi</p>
      <div class="tubes">
        {tools.map((t) =>
          t.href ? (
            <a href={t.href} target="_blank" rel="noopener noreferrer" class="tube">
              <span>{t.icon}</span> {t.label}
            </a>
          ) : (
            <span class="tube soon" aria-disabled="true">
              <span>{t.icon}</span> {t.label} <span class="soon-tag">(bientôt)</span>
            </span>
          ),
        )}
      </div>
      <div class="note">
        S'ouvre dans une nouvelle fenêtre. Connectez-vous avec votre compte Google pour accéder.
      </div>
    </div>
  </body>
</html>
