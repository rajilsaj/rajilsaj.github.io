---
const title = 'IA Lab'
const description = 'Interactive AI Lab - Candidate selection and evaluation tool'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl = 'https://script.google.com/macros/s/AKfycbzE1MLVDl7YWS-VZTdIbbxW94YMPWpHkgxMCSqaz28CXS3lQqcChHZ3OfGc_u2XUmM/exec'
// TODO: set the Checklist and Rapport app URLs; an empty URL shows the button as "bientôt".
const checklistUrl = ''
const reportUrl = ''
const tools = [
  { label: 'Sélection', icon: '🧑‍🔬', href: appUrl },
  { label: 'Checklist', icon: '✅', href: checklistUrl },
  { label: 'Rapport', icon: '📊', href: reportUrl },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --ialab-blue: #3985d1;
      }
      html, body {
        width: 100%;
        min-height: 100%;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: #fff;
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 420px;
      }
      .logo {
        width: 100%;
        max-width: 320px;
        height: auto;
        margin-bottom: 20px;
      }
      p {
        font-size: 1.05em;
        color: #555;
        margin-bottom: 32px;
        line-height: 1.6;
      }
      .tubes {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: 100%;
        max-width: 300px;
      }
      /* Tube buttons: flat capsule in the logo blue */
      .tube {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px 28px;
        border-radius: 999px;
        background: var(--ialab-blue);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05em;
        letter-spacing: 0.02em;
        transition: filter 0.2s, transform 0.2s;
      }
      .tube:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
      }
      .tube:active {
        transform: translateY(0);
      }
      .tube.soon {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
      }
      .tube .soon-tag {
        font-size: 0.75em;
        font-weight: 500;
      }
      .note {
        font-size: 0.9em;
        color: #999;
        margin-top: 28px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img class="logo" src="/ialab-logo.png" alt="ia.lab" width="768" height="237" />
      <p>Outil de sélection et d'évaluation des candidats avec collaboration en temps réel et suivi</p>
      <div class="tubes">
        {tools.map((t) =>
          t.href ? (
            <a href={t.href} target="_blank" rel="noopener noreferrer" class="tube">
              <span>{t.icon}</span> {t.label}
            </a>
          ) : (
            <span class="tube soon" aria-disabled="true">
              <span>{t.icon}</span> {t.label} <span class="soon-tag">(bientôt)</span>
            </span>
          ),
        )}
      </div>
      <div class="note">
        S'ouvre dans une nouvelle fenêtre. Connectez-vous avec votre compte Google pour accéder.
      </div>
    </div>
  </body>
</html>
