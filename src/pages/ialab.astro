---
const title = 'IA Lab'
const description = 'Interactive AI Lab - Candidate selection and evaluation tool'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl = 'https://script.google.com/macros/s/AKfycbzE1MLVDl7YWS-VZTdIbbxW94YMPWpHkgxMCSqaz28CXS3lQqcChHZ3OfGc_u2XUmM/exec'
// TODO: set the Checklist and Rapport app URLs; an empty URL shows the button as "bientôt".
const checklistUrl = ''
const reportUrl = ''
const tools = [
  { label: 'Sélection', href: appUrl, primary: true },
  { label: 'Checklist', href: checklistUrl },
  { label: 'Rapport', href: reportUrl },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap" rel="stylesheet" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --ialab-blue: #3985d1;
      }
      html, body {
        width: 100%;
        min-height: 100%;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: #fff;
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 420px;
      }
      .logo {
        width: 100%;
        max-width: 320px;
        height: auto;
        margin-bottom: 20px;
      }
      p {
        font-size: 1.05em;
        color: #555;
        margin-bottom: 32px;
        line-height: 1.6;
      }
      .tubes {
        display: flex;
        flex-direction: column;
        gap: 18px;
        width: 100%;
        max-width: 320px;
      }
      /* Tube buttons: rounded pill, outlined by default; the fill sweeps in on hover */
      .tube {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        padding: 0 32px;
        border: 2.5px solid var(--ialab-blue);
        border-radius: 999px;
        background: transparent;
        color: var(--ialab-blue);
        font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-weight: 700;
        font-size: 1.05em;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        text-decoration: none;
        overflow: hidden;
        isolation: isolate;
        transition: color 0.3s ease, transform 0.15s ease, box-shadow 0.3s ease;
      }
      .tube::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--ialab-blue);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .tube.primary,
      .tube:hover,
      .tube:focus-visible {
        color: #fff;
      }
      .tube.primary::before,
      .tube:hover::before,
      .tube:focus-visible::before {
        transform: scaleX(1);
      }
      .tube:hover {
        box-shadow: 0 8px 20px rgba(57, 133, 209, 0.3);
      }
      .tube:focus-visible {
        outline: 3px solid rgba(57, 133, 209, 0.35);
        outline-offset: 3px;
      }
      .tube:active {
        transform: scale(0.97);
      }
      .tube.soon {
        border-style: dashed;
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
      }
      .tube .soon-tag {
        margin-left: 0.6em;
        font-size: 0.65em;
        letter-spacing: 0.08em;
        text-transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .tube,
        .tube::before {
          transition: none;
        }
      }
      .note {
        font-size: 0.9em;
        color: #999;
        margin-top: 28px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img class="logo" src="/ialab-logo.png" alt="ia.lab" width="768" height="237" />
      <p>Outil de sélection et d'évaluation des candidats avec collaboration en temps réel et suivi</p>
      <div class="tubes">
        {tools.map((t) =>
          t.href ? (
            <a href={t.href} target="_blank" rel="noopener noreferrer" class:list={['tube', { primary: t.primary }]}>
              {t.label}
            </a>
          ) : (
            <span class="tube soon" aria-disabled="true">
              {t.label}<span class="soon-tag">bientôt</span>
            </span>
          ),
        )}
      </div>
      <div class="note">
        S'ouvre dans une nouvelle fenêtre. Connectez-vous avec votre compte Google pour accéder.
      </div>
    </div>
  </body>
</html>
