---
const title = 'Happy Birthday, my friend! 🎂'
const description = 'A little birthday surprise for you'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/hbd-myfriend/puppy.gif" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', Arial, sans-serif;
      }
      body {
        background: linear-gradient(-45deg, #ff9a9e, #fad0c4, #a18cd1, #fbc2eb, #ffecd2, #fcb69f);
        background-size: 400% 400%;
        animation: gradient 14s ease infinite;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3b2a4a;
        text-align: center;
      }
      @keyframes gradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      canvas#confetti {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 2;
      }

      .stage {
        position: relative;
        z-index: 3;
        padding: 24px 16px;
        max-width: 720px;
        width: 100%;
      }
      h1 {
        font-size: clamp(2.2rem, 7vw, 4.5rem);
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.02em;
        text-shadow: 0 4px 24px rgba(255, 255, 255, 0.6);
        animation: pop 1.2s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
      }
      h1 span {
        display: inline-block;
        animation: bounce 1.6s ease-in-out infinite;
      }
      h1 span:nth-child(2n) { animation-delay: 0.15s; }
      h1 span:nth-child(3n) { animation-delay: 0.3s; }
      @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
      }
      @keyframes pop {
        from { transform: scale(0.6); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      .puppy {
        margin: 20px auto;
        width: min(70vw, 360px);
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18), 0 0 0 10px rgba(255, 255, 255, 0.5);
        overflow: hidden;
        display: grid;
        place-items: center;
        animation: float 3s ease-in-out infinite;
      }
      .puppy img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.12);
      }
      @keyframes float {
        0%, 100% { transform: translateY(0) rotate(-2deg); }
        50% { transform: translateY(-14px) rotate(2deg); }
      }

      .msg {
        font-size: clamp(1.1rem, 3vw, 1.5rem);
        font-weight: 500;
        line-height: 1.5;
        margin-top: 8px;
        text-shadow: 0 2px 12px rgba(255, 255, 255, 0.6);
      }

      .controls {
        margin-top: 22px;
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      button {
        appearance: none;
        border: none;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.85);
        color: #3b2a4a;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        transition: transform 0.15s, box-shadow 0.15s;
      }
      button:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(0, 0, 0, 0.2); }
      button:active { transform: translateY(0); }

      .balloon {
        position: fixed;
        bottom: -160px;
        width: 60px;
        height: 76px;
        border-radius: 50% 50% 50% 50% / 45% 45% 55% 55%;
        opacity: 0.85;
        z-index: 1;
        animation: rise linear infinite;
      }
      .balloon::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 100%;
        width: 2px;
        height: 70px;
        background: rgba(0, 0, 0, 0.25);
        transform: translateX(-50%);
      }
      @keyframes rise {
        from { transform: translateY(0) rotate(-4deg); }
        to { transform: translateY(-130vh) rotate(4deg); }
      }

      #gate {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: grid;
        place-items: center;
        background: rgba(59, 42, 74, 0.55);
        backdrop-filter: blur(6px);
        cursor: pointer;
        transition: opacity 0.4s;
      }
      #gate.hidden { opacity: 0; pointer-events: none; }
      #gate .card {
        background: #fff;
        border-radius: 20px;
        padding: 36px 32px;
        max-width: 360px;
        margin: 16px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        animation: pop 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
      }
      #gate .card .emoji { font-size: 3.5rem; margin-bottom: 8px; }
      #gate .card h2 { font-size: 1.5rem; margin-bottom: 8px; }
      #gate .card p { color: #666; margin-bottom: 20px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <canvas id="confetti"></canvas>

    <div id="gate" role="button" aria-label="Start the celebration">
      <div class="card">
        <div class="emoji">🎁</div>
        <h2>A surprise for you!</h2>
        <p>Turn your sound on and tap anywhere to open it.</p>
        <button type="button">Tap to celebrate 🎉</button>
      </div>
    </div>

    <main class="stage">
      <h1 aria-label="Happy Birthday!">
        {'Happy Birthday!'.split('').map((c) => (c === ' ' ? ' ' : <span>{c}</span>))}
      </h1>
      <div class="puppy">
        <img src="/hbd-myfriend/puppy.gif" alt="A happy dancing puppy" />
      </div>
      <p class="msg">
        Wishing you a day full of joy, cake, and puppy dances. 🐶🎂<br />
        You deserve all the good things, my friend! 💛
      </p>
      <div class="controls">
        <button id="mute" type="button" aria-pressed="false">🔊 Music on</button>
        <button id="more" type="button">🎊 More confetti!</button>
      </div>
    </main>

    <script>
      // ---------- Balloons ----------
      const colors = ['#ff6b6b', '#ffd93d', '#6bcB77', '#4d96ff', '#ff8fab', '#c77dff', '#ffa94d']
      for (let i = 0; i < 12; i++) {
        const b = document.createElement('div')
        b.className = 'balloon'
        b.style.left = Math.random() * 100 + 'vw'
        b.style.background = colors[i % colors.length]
        b.style.animationDuration = 9 + Math.random() * 8 + 's'
        b.style.animationDelay = -Math.random() * 14 + 's'
        b.style.transform = `scale(${0.7 + Math.random() * 0.7})`
        document.body.appendChild(b)
      }

      // ---------- Confetti ----------
      const canvas = document.getElementById('confetti') as HTMLCanvasElement
      const ctx = canvas.getContext('2d')!
      type Piece = { x: number; y: number; w: number; h: number; c: string; vx: number; vy: number; r: number; vr: number }
      let pieces: Piece[] = []
      function resize() {
        canvas.width = window.innerWidth * devicePixelRatio
        canvas.height = window.innerHeight * devicePixelRatio
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0)
      }
      window.addEventListener('resize', resize)
      resize()
      function burst(n = 180) {
        const W = window.innerWidth
        for (let i = 0; i < n; i++) {
          pieces.push({
            x: Math.random() * W,
            y: -20 - Math.random() * 200,
            w: 6 + Math.random() * 8,
            h: 8 + Math.random() * 10,
            c: colors[(Math.random() * colors.length) | 0],
            vx: -1.5 + Math.random() * 3,
            vy: 2 + Math.random() * 3.5,
            r: Math.random() * Math.PI,
            vr: -0.15 + Math.random() * 0.3,
          })
        }
      }
      function tick() {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight)
        const H = window.innerHeight
        pieces = pieces.filter((p) => p.y < H + 40)
        for (const p of pieces) {
          p.x += p.vx + Math.sin(p.y / 30) * 0.6
          p.y += p.vy
          p.r += p.vr
          ctx.save()
          ctx.translate(p.x, p.y)
          ctx.rotate(p.r)
          ctx.fillStyle = p.c
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h)
          ctx.restore()
        }
        requestAnimationFrame(tick)
      }
      tick()

      // ---------- Happy Birthday music (Web Audio, no file needed) ----------
      const G4 = 392.0, A4 = 440.0, B4 = 493.88, C5 = 523.25, D5 = 587.33, E5 = 659.25, F5 = 698.46, G5 = 783.99
      // [frequency, beats]
      const melody: [number, number][] = [
        [G4, 0.75], [G4, 0.25], [A4, 1], [G4, 1], [C5, 1], [B4, 2],
        [G4, 0.75], [G4, 0.25], [A4, 1], [G4, 1], [D5, 1], [C5, 2],
        [G4, 0.75], [G4, 0.25], [G5, 1], [E5, 1], [C5, 1], [B4, 1], [A4, 2],
        [F5, 0.75], [F5, 0.25], [E5, 1], [C5, 1], [D5, 1], [C5, 2],
        [0, 1.5],
      ]
      const BEAT = 0.5 // seconds per beat
      let audio: AudioContext | null = null
      let master: GainNode | null = null
      let loopTimer: number | undefined
      let muted = false

      function playNote(freq: number, start: number, dur: number) {
        if (!audio || !master || freq === 0) return
        const osc = audio.createOscillator()
        const osc2 = audio.createOscillator()
        const g = audio.createGain()
        osc.type = 'triangle'
        osc2.type = 'sine'
        osc.frequency.value = freq
        osc2.frequency.value = freq * 2
        g.gain.setValueAtTime(0.0001, start)
        g.gain.exponentialRampToValueAtTime(0.35, start + 0.02)
        g.gain.exponentialRampToValueAtTime(0.12, start + dur * 0.6)
        g.gain.exponentialRampToValueAtTime(0.0001, start + dur * 0.95)
        osc.connect(g)
        osc2.connect(g)
        g.connect(master)
        osc.start(start)
        osc2.start(start)
        osc.stop(start + dur)
        osc2.stop(start + dur)
      }
      function scheduleSong() {
        if (!audio) return
        let t = audio.currentTime + 0.1
        for (const [f, beats] of melody) {
          playNote(f, t, beats * BEAT)
          t += beats * BEAT
        }
        const total = (t - audio.currentTime) * 1000
        loopTimer = window.setTimeout(scheduleSong, total - 150)
      }
      function startMusic() {
        if (audio) return
        const Ctx = window.AudioContext || (window as any).webkitAudioContext
        audio = new Ctx()
        master = audio.createGain()
        master.gain.value = 0.6
        master.connect(audio.destination)
        scheduleSong()
      }

      // ---------- Controls ----------
      const gate = document.getElementById('gate')!
      const muteBtn = document.getElementById('mute')!
      const moreBtn = document.getElementById('more')!

      function celebrate() {
        gate.classList.add('hidden')
        startMusic()
        burst(260)
        setTimeout(() => burst(120), 1200)
      }
      gate.addEventListener('click', celebrate)

      muteBtn.addEventListener('click', () => {
        if (!audio || !master) return
        muted = !muted
        master.gain.setTargetAtTime(muted ? 0 : 0.6, audio.currentTime, 0.05)
        muteBtn.textContent = muted ? '🔇 Music off' : '🔊 Music on'
        muteBtn.setAttribute('aria-pressed', String(muted))
      })
      moreBtn.addEventListener('click', () => burst(220))

      document.addEventListener('visibilitychange', () => {
        if (!audio) return
        if (document.hidden) audio.suspend()
        else audio.resume()
      })
    </script>
  </body>
</html>
