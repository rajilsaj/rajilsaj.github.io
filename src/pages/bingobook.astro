---
import ChallengeLayout from '~/layouts/ChallengeLayout.astro'
import { LEVELS, runsByDay, levelOf, nextLevel, latestPacedRun, toSec, fmtPace, fmtDate } from '~/data/runs'
import type { Level } from '~/data/runs'
import { ICONS } from '~/data/levelIcons'

const title = 'Bingo Book · 100 Days Challenge'
const description = 'The level ladder of the 100 Days Challenge: what each rank means and how to earn it.'

const runs = runsByDay()
const lastPaced = latestPacedRun()
const current = lastPaced ? levelOf(lastPaced) : null
const upNext = current ? nextLevel(current) : null
const isBottom = (l: Level) => l === LEVELS[LEVELS.length - 1]

// ladder from slowest (entry 1) to fastest, with the runs that earned each level
const ladder = [...LEVELS].reverse().map((l, i) => ({
  level: l,
  no: i + 1,
  earned: runs.filter((r) => levelOf(r) === l),
  rank: LEVELS.length - i, // 1 = top
}))
const req = (l: Level) => (isBottom(l) ? 'Any average pace' : `Average pace under ${fmtPace(toSec(l.under))} per mile`)
---

<ChallengeLayout title={title} description={description} badge="📖" heading="Bingo Book" subtitle="Every level of the 100 Days Challenge and how to earn it">
  <style is:global>
    .intro { background: linear-gradient(135deg, var(--card) 0%, var(--card-2) 100%); border: 1px solid var(--track); border-radius: 18px; padding: 18px 20px; margin-bottom: 14px; }
    .intro p { color: var(--muted); font-size: 0.92rem; line-height: 1.45; }
    .intro p + p { margin-top: 8px; }
    .intro b { color: var(--text); font-weight: 600; }
    .status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; color: var(--muted); font-size: 0.85rem; }
    .status .lvl { font-size: 0.85rem; padding: 6px 11px 6px 7px; background: var(--bar-pill-bg); border-color: transparent; color: var(--bar-pill-text); }
    .status .lvl svg { width: 18px; height: 18px; }
    .status b { color: var(--text); font-weight: 600; }

    .book { display: grid; grid-template-columns: 1fr; gap: 10px; }
    @media (min-width: 600px) { .book { grid-template-columns: 1fr 1fr; } }
    .entry { position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 4px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px; min-width: 0; }
    .entry .icon { grid-row: 1 / span 4; width: 56px; height: 56px; border-radius: 14px; background: var(--card-2); display: grid; place-items: center; }
    .entry .icon svg { width: 34px; height: 34px; }
    .entry .no { color: var(--muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
    .entry .name { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .entry .name .smile { font-size: 1.2rem; font-weight: 400; }
    .entry .from { color: var(--muted); font-size: 0.82rem; }
    .entry .req { font-size: 0.88rem; margin-top: 6px; }
    .entry .req b { font-weight: 700; }
    .entry .earned { grid-column: 1 / -1; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
    .entry .earned .day { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 999px; background: var(--card-2); border: 1px solid var(--line); color: var(--text); font-weight: 600; font-size: 0.78rem; white-space: nowrap; }
    .entry .earned .day small { color: var(--muted); font-weight: 400; }
    .entry.locked .icon { filter: grayscale(1) brightness(0.9); opacity: 0.55; }
    .entry.locked .name { color: var(--muted); }
    .entry.current { border-color: var(--lime); box-shadow: inset 0 0 0 1px var(--lime); }
    .tag { position: absolute; top: 12px; right: 12px; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 8px; border-radius: 999px; background: var(--bar-pill-bg); color: var(--bar-pill-text); }
    .tag.next { background: transparent; color: var(--muted); border: 1px dashed var(--line); }
    .actions { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 10px; }
  </style>

  <section class="intro" aria-label="How levels work">
    <p>Every run in the challenge earns a level from its <b>average pace</b>. Faster pace, higher level. The ladder borrows its ranks from Dragon Ball Z, Harry Potter, Star Wars, Naruto, Pokémon and The Lord of the Rings.</p>
    <p>A level is <b>unlocked</b> the first time a run beats its pace. The current level is always the one earned by the latest run, so it can go down as well as up.</p>
    {current ? (
      <div class="status">
        <span>Current level</span>
        <span class="lvl">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[current.icon]} />
          {current.name}
          <span class="smile">{current.smiley}</span>
        </span>
        {upNext ? (
          <span>next: <b>{upNext.name}</b> under {fmtPace(toSec(upNext.under))}/mi</span>
        ) : (
          <span>top level reached 🏆</span>
        )}
      </div>
    ) : (
      <div class="status"><span>No paced run logged yet.</span></div>
    )}
  </section>

  <h2>The ladder</h2>
  <div class="book" aria-label="Levels, slowest to fastest">
    {ladder.map(({ level: l, no, earned, rank }) => {
      const state = l === current ? 'current' : earned.length ? 'unlocked' : 'locked'
      return (
        <article class={`entry ${state}`} aria-label={`Level ${no}: ${l.name}`}>
          <div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[l.icon]} /></div>
          <div class="no">Level {no} of {LEVELS.length} · rank {rank}</div>
          <div class="name">{l.name} <span class="smile" aria-label="mood">{l.smiley}</span></div>
          <div class="from">{l.from}</div>
          <div class="req"><b>{req(l)}</b></div>
          {l === current && <span class="tag">Current</span>}
          {l === upNext && <span class="tag next">Next target</span>}
          <div class="earned">
            {earned.length ? (
              <>
                <span>Unlocked on</span>
                {earned.map((r) => (
                  <span class="day">
                    Day {r.day} <small>{fmtDate(r.date, { month: 'short', day: 'numeric' })} · {fmtPace(toSec(r.avgPace!))}/mi</small>
                  </span>
                ))}
              </>
            ) : (
              <span>🔒 Locked · not reached yet</span>
            )}
          </div>
        </article>
      )
    })}
  </div>
  <p class="note">Pace thresholds are strict: a run at exactly the limit earns the level below.</p>

  <div class="actions">
    <a class="btn" href="/run">← Back to the challenge</a>
  </div>
</ChallengeLayout>
