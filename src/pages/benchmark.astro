---
import Layout from '~/layouts/Layout.astro'

// ---------------------------------------------------------------------------
// Benchmark model upload — UNLISTED, full-screen page.
// Reachable only via the /benchmark URL (absent from navLinks in
// src/site.config.ts) and rendered without the site header/footer.
//
// Static GitHub Pages cannot write to the repo itself. Point UPLOAD_ENDPOINT
// at the Cloudflare Worker in /worker (which holds the GitHub token) and it
// commits uploads into /benchmark-models via the GitHub Contents API.
// While empty, files are validated + previewed but have nowhere to go.
// ---------------------------------------------------------------------------
const UPLOAD_ENDPOINT = '' // e.g. 'https://rajil-benchmark-upload.<subdomain>.workers.dev'

const MAX_BYTES = 100 * 1024 * 1024 // GitHub Contents API hard limit

const ACCEPTED = [
  '.pt',
  '.pth',
  '.onnx',
  '.safetensors',
  '.gguf',
  '.h5',
  '.keras',
  '.pb',
  '.tflite',
  '.pkl',
  '.joblib',
  '.ckpt',
  '.bin',
  '.mar',
  '.zip',
]
---

<Layout
  bare
  fullScreen
  title="Benchmark — Upload a model"
  description="Upload an ML model for benchmarking."
>
  <div
    id="stage"
    class="stage"
    data-endpoint={UPLOAD_ENDPOINT}
    data-max-bytes={MAX_BYTES}
    data-accepted={ACCEPTED.join(',')}
  >
    <div id="card" class="card">
      <!-- Left: dropzone -->
      <div class="drop">
        <svg class="drop-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path
            d="M12 4h18l8 8v32a0 0 0 0 1 0 0H12a0 0 0 0 1 0 0z"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"></path>
          <path d="M30 4v8h8" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"
          ></path>
          <path
            d="M24 34V21m0 0-5 5m5-5 5 5"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p class="drop-title">Drag and drop file</p>
        <p class="drop-or">or</p>
        <button type="button" id="browse" class="browse">Browse</button>
        <input id="file-input" type="file" class="sr-only" multiple accept={ACCEPTED.join(',')} />
      </div>

      <!-- Right: file list -->
      <ul id="file-list" class="list" aria-live="polite">
        <li id="empty" class="empty">No files yet — drop a model or click Browse.</li>
      </ul>
    </div>
  </div>
</Layout>

<style>
  .stage {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: #3b8ef6;
    color: #3a4a63;
    font-family:
      'Inter',
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(760px, 94vw);
    height: min(500px, 84vh);
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 30px 70px -25px rgba(20, 50, 100, 0.5);
    overflow: hidden;
    outline: 2px dashed transparent;
    outline-offset: -12px;
    transition: outline-color 0.15s ease;
  }
  .card.dragging {
    outline-color: #3b8ef6;
  }

  /* Left dropzone */
  .drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 2rem;
    border-right: 1px solid #eef1f5;
  }
  .drop-icon {
    width: 62px;
    height: 62px;
    color: #3b8ef6;
    margin-bottom: 1.25rem;
  }
  .drop-title {
    margin: 0;
    font-size: 1.05rem;
    color: #aeb8c4;
    font-weight: 400;
  }
  .drop-or {
    margin: 0.4rem 0;
    font-size: 0.85rem;
    color: #c4ccd6;
  }
  .browse {
    margin-top: 0.35rem;
    border: none;
    background: #3b8ef6;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.65rem 2.6rem;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: 0 8px 18px -8px rgba(59, 142, 246, 0.8);
    transition:
      background 0.15s ease,
      transform 0.05s ease;
  }
  .browse:hover {
    background: #2f80ea;
  }
  .browse:active {
    transform: translateY(1px);
  }

  /* Right list */
  .list {
    margin: 0;
    padding: 0.5rem 0.25rem 0.5rem 0;
    list-style: none;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .list::-webkit-scrollbar {
    width: 6px;
  }
  .list::-webkit-scrollbar-thumb {
    background: #d9e0e8;
    border-radius: 3px;
  }
  .list {
    scrollbar-width: thin;
    scrollbar-color: #d9e0e8 transparent;
  }

  .empty {
    padding: 2rem 1.5rem;
    text-align: center;
    color: #c4ccd6;
    font-size: 0.85rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1.25rem;
    animation: fade 0.18s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .badge {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #3b8ef6;
    background: #eaf3fe;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .meta {
    flex: 1;
    min-width: 0;
  }
  .name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #3a4a63;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .prog {
    margin-top: 0.15rem;
    font-size: 0.72rem;
    color: #aeb8c4;
  }
  .row[data-status='error'] .prog {
    color: #ef6b64;
  }
  .status {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
  }
  .status svg {
    width: 100%;
    height: 100%;
  }
  .check {
    color: #3b8ef6;
  }
  .remove {
    color: #cfd6df;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
  }
  .remove:hover {
    color: #ef6b64;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: min(560px, 88vh);
    }
    .drop {
      border-right: none;
      border-bottom: 1px solid #eef1f5;
      padding: 1.75rem;
    }
    .drop-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row {
      animation: none;
    }
  }
</style>

<script>
  const stage = document.getElementById('stage') as HTMLDivElement
  const card = document.getElementById('card') as HTMLDivElement
  const input = document.getElementById('file-input') as HTMLInputElement
  const browse = document.getElementById('browse') as HTMLButtonElement
  const list = document.getElementById('file-list') as HTMLUListElement
  const emptyEl = document.getElementById('empty') as HTMLLIElement

  const endpoint = stage.dataset.endpoint || ''
  const maxBytes = Number(stage.dataset.maxBytes)
  const accepted = (stage.dataset.accepted || '').split(',').filter(Boolean)

  const CHECK_SVG =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" stroke="none" fill="currentColor" opacity="0.12"/><path d="m8 12 3 3 5-6"/></svg>'
  const X_SVG =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17"/></svg>'

  type Item = {
    id: string
    file: File
    status: 'queued' | 'uploading' | 'done' | 'error'
    loaded: number
    error?: string
    el?: HTMLLIElement
  }
  const items: Item[] = []
  let uploading = false
  let idCounter = 0

  const fmtSize = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`
    const units = ['KB', 'MB', 'GB']
    let v = bytes / 1024
    let i = 0
    while (v >= 1024 && i < units.length - 1) {
      v /= 1024
      i++
    }
    return `${v < 10 ? v.toFixed(2) : v.toFixed(0)} ${units[i]}`
  }

  const extOf = (name: string) => {
    const dot = name.lastIndexOf('.')
    return dot === -1 ? '' : name.slice(dot).toLowerCase()
  }
  const badgeLabel = (name: string) => extOf(name).replace('.', '').toUpperCase() || 'FILE'

  const validate = (file: File): string | null => {
    if (accepted.length && !accepted.includes(extOf(file.name))) {
      return `Unsupported type "${extOf(file.name) || '(none)'}"`
    }
    if (file.size === 0) return 'Empty file'
    if (file.size > maxBytes) return `Over ${fmtSize(maxBytes)} limit`
    return null
  }

  const syncEmpty = () => {
    emptyEl.style.display = items.length ? 'none' : ''
  }

  const progText = (item: Item) => {
    if (item.status === 'error') return item.error || 'Failed'
    return `${fmtSize(item.loaded)} / ${fmtSize(item.file.size)}`
  }

  const statusHtml = (item: Item) => {
    if (item.status === 'done') return `<span class="status check">${CHECK_SVG}</span>`
    return `<button type="button" class="remove" aria-label="Remove ${item.file.name}">${X_SVG}</button>`
  }

  const renderRow = (item: Item) => {
    const li = document.createElement('li')
    li.className = 'row'
    li.dataset.status = item.status
    li.innerHTML = `
      <span class="badge">${badgeLabel(item.file.name)}</span>
      <div class="meta">
        <div class="name">${item.file.name}</div>
        <div class="prog">${progText(item)}</div>
      </div>
      ${statusHtml(item)}
    `
    item.el = li
    li.querySelector('.remove')?.addEventListener('click', () => removeItem(item))
    list.appendChild(li)
    syncEmpty()
  }

  const updateRow = (item: Item) => {
    if (!item.el) return
    item.el.dataset.status = item.status
    ;(item.el.querySelector('.prog') as HTMLElement).textContent = progText(item)
    // Swap the trailing element (blue check when done, gray ✕ otherwise).
    const trailing = item.el.querySelector('.status, .remove') as HTMLElement
    const wrap = document.createElement('div')
    wrap.innerHTML = statusHtml(item)
    const fresh = wrap.firstElementChild as HTMLElement
    trailing.replaceWith(fresh)
    if (fresh.classList.contains('remove')) {
      fresh.addEventListener('click', () => removeItem(item))
    }
  }

  const removeItem = (item: Item) => {
    const i = items.indexOf(item)
    if (i > -1) items.splice(i, 1)
    item.el?.remove()
    syncEmpty()
  }

  const addFiles = (fileList: FileList | File[]) => {
    for (const file of Array.from(fileList)) {
      const err = validate(file)
      const item: Item = {
        id: `f${idCounter++}`,
        file,
        status: err ? 'error' : 'queued',
        loaded: 0,
        error: err || undefined,
      }
      items.push(item)
      renderRow(item)
    }
    processQueue()
  }

  const processQueue = () => {
    if (uploading) return
    const next = items.find((it) => it.status === 'queued')
    if (!next) return

    if (!endpoint) {
      next.status = 'error'
      next.error = 'No upload endpoint configured'
      updateRow(next)
      processQueue()
      return
    }

    uploading = true
    next.status = 'uploading'
    updateRow(next)

    const body = new FormData()
    body.append('model', next.file, next.file.name)

    const xhr = new XMLHttpRequest()
    xhr.open('POST', endpoint)

    xhr.upload.addEventListener('progress', (ev) => {
      if (ev.lengthComputable) {
        next.loaded = ev.loaded
        ;(next.el?.querySelector('.prog') as HTMLElement).textContent = progText(next)
      }
    })

    xhr.addEventListener('load', () => {
      uploading = false
      if (xhr.status >= 200 && xhr.status < 300) {
        next.status = 'done'
        next.loaded = next.file.size
      } else {
        next.status = 'error'
        next.error = `Failed (HTTP ${xhr.status})`
      }
      updateRow(next)
      processQueue()
    })

    xhr.addEventListener('error', () => {
      uploading = false
      next.status = 'error'
      next.error = 'Network error'
      updateRow(next)
      processQueue()
    })

    xhr.send(body)
  }

  // --- Wiring --------------------------------------------------------------
  browse.addEventListener('click', () => input.click())
  input.addEventListener('change', () => {
    if (input.files && input.files.length) addFiles(input.files)
    input.value = ''
  })

  ;['dragenter', 'dragover'].forEach((evt) =>
    card.addEventListener(evt, (e) => {
      e.preventDefault()
      card.classList.add('dragging')
    }),
  )
  ;['dragleave', 'drop'].forEach((evt) =>
    card.addEventListener(evt, (e) => {
      e.preventDefault()
      if (evt === 'dragleave' && card.contains((e as DragEvent).relatedTarget as Node)) return
      card.classList.remove('dragging')
    }),
  )
  card.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer
    if (dt && dt.files && dt.files.length) addFiles(dt.files)
  })
</script>
