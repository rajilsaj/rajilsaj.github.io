---
import Layout from '~/layouts/Layout.astro'

// ---------------------------------------------------------------------------
// Benchmark model upload — UNLISTED, full-screen page.
// Reachable only via the /benchmark URL (absent from navLinks in
// src/site.config.ts) and rendered without the site header/footer.
//
// Static GitHub Pages cannot write to the repo itself. Point UPLOAD_ENDPOINT
// at the Cloudflare Worker in /worker (which holds the GitHub token) and it
// commits uploads into /benchmark-models via the GitHub Contents API.
// While empty, files are validated + previewed but have nowhere to go.
// ---------------------------------------------------------------------------
const UPLOAD_ENDPOINT = '' // e.g. 'https://rajil-benchmark-upload.<subdomain>.workers.dev'

const MAX_BYTES = 100 * 1024 * 1024 // GitHub Contents API hard limit

const ACCEPTED = [
  '.pt',
  '.pth',
  '.onnx',
  '.safetensors',
  '.gguf',
  '.h5',
  '.keras',
  '.pb',
  '.tflite',
  '.pkl',
  '.joblib',
  '.ckpt',
  '.bin',
  '.mar',
  '.zip',
]
---

<Layout
  bare
  fullScreen
  title="Benchmark — Upload a model"
  description="Upload an ML model for benchmarking."
>
  <div
    id="stage"
    class="stage"
    data-endpoint={UPLOAD_ENDPOINT}
    data-max-bytes={MAX_BYTES}
    data-accepted={ACCEPTED.join(',')}
  >
    <div id="dropzone" class="card">
      <!-- Heading -->
      <p class="heading">Drop your files here</p>

      <!-- Center stage: idle art OR progress ring -->
      <div class="center">
        <!-- Idle cloud icon -->
        <svg id="idle-art" class="idle-art" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 8.5a4.5 4.5 0 0 1 .5 8.98"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M12 12v6m0-6-2.2 2.2M12 12l2.2 2.2"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>

        <!-- Progress ring (hidden until upload) -->
        <div id="ring-wrap" class="ring-wrap" hidden>
          <svg class="ring" viewBox="0 0 120 120">
            <circle class="ring-track" cx="60" cy="60" r="52" />
            <circle
              id="ring-progress"
              class="ring-progress"
              cx="60"
              cy="60"
              r="52"
              transform="rotate(-90 60 60)"></circle>
          </svg>
          <div class="ring-label">
            <div class="ring-pct"><span id="pct-num">0</span><span class="pct-sign">%</span></div>
            <div id="ring-file" class="ring-file"></div>
          </div>
        </div>
      </div>

      <!-- Bottom prompt -->
      <p class="prompt">
        or <button type="button" id="browse" class="browse">select a file from computer</button>
      </p>

      <input id="file-input" type="file" class="sr-only" multiple accept={ACCEPTED.join(',')} />

      <!-- File cards (stack down the right edge) -->
      <ul id="file-list" class="file-list" aria-live="polite"></ul>
    </div>
  </div>
</Layout>

<style>
  /* Fixed light backdrop that ignores the site theme, matching the design. */
  .stage {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: #edeff2;
    color: #303540;
    font-family:
      'Inter',
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
  }

  .card {
    position: relative;
    width: min(720px, 92vw);
    min-height: 380px;
    padding: 2.75rem 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-radius: 4px;
    box-shadow:
      0 24px 60px -20px rgba(40, 50, 70, 0.28),
      0 2px 8px rgba(40, 50, 70, 0.06);
    transition:
      box-shadow 0.2s ease,
      outline-color 0.2s ease;
    outline: 2px dashed transparent;
    outline-offset: -14px;
  }
  .card.dragging {
    outline-color: #ff6f61;
    box-shadow:
      0 28px 70px -20px rgba(255, 111, 97, 0.35),
      0 2px 8px rgba(40, 50, 70, 0.06);
  }

  .heading {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 300;
    letter-spacing: 0.01em;
    color: #cdd2d8;
    text-align: center;
  }

  .center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1.5rem 0;
  }

  .idle-art {
    width: 84px;
    height: 84px;
    color: #e2e5ea;
  }

  /* Progress ring */
  .ring-wrap {
    position: relative;
    width: 168px;
    height: 168px;
    display: grid;
    place-items: center;
  }
  .ring {
    width: 100%;
    height: 100%;
  }
  .ring-track {
    fill: none;
    stroke: #f0f2f5;
    stroke-width: 6;
  }
  .ring-progress {
    fill: none;
    stroke: #ff6f61;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 326.7; /* 2π·52 */
    stroke-dashoffset: 326.7;
    transition: stroke-dashoffset 0.2s ease;
  }
  .ring-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .ring-pct {
    font-size: 2rem;
    font-weight: 300;
    color: #3a3f48;
    line-height: 1;
  }
  .pct-sign {
    font-size: 0.85rem;
    color: #9aa0a8;
    margin-left: 2px;
    vertical-align: top;
  }
  .ring-file {
    margin-top: 0.4rem;
    max-width: 120px;
    font-size: 0.66rem;
    color: #b7bcc4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prompt {
    margin: 0;
    font-size: 0.95rem;
    color: #a7adb5;
  }
  .browse {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: #ff6f61;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .browse:hover {
    color: #ff5647;
    text-decoration: underline;
  }

  /* File cards stacked down the right edge, poking outside like the design */
  .file-list {
    position: absolute;
    top: 1.5rem;
    right: -52px;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 92px;
  }
  .file-card {
    position: relative;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 10px 26px -10px rgba(40, 50, 70, 0.22);
    padding: 0.85rem 0.5rem 0.55rem;
    text-align: center;
    animation: pop 0.18s ease;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .file-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 46px;
    margin: 0 auto;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .file-size {
    margin-top: 0.4rem;
    font-size: 0.6rem;
    color: #aeb4bc;
  }
  .file-x {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(40, 50, 70, 0.25);
    color: #b7bcc4;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .file-x:hover {
    color: #ff6f61;
  }
  .file-card[data-status='done'] .file-badge {
    box-shadow: 0 0 0 2px rgba(76, 175, 132, 0.15);
  }
  .file-card[data-status='error'] {
    outline: 1px solid #ffd6d1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* On smaller screens tuck the cards inside and give the card breathing room */
  @media (max-width: 640px) {
    .file-list {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      right: auto;
      margin-top: 1.25rem;
    }
    .card {
      min-height: 340px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-progress {
      transition: none;
    }
    .file-card {
      animation: none;
    }
  }
</style>

<script>
  const stage = document.getElementById('stage') as HTMLDivElement
  const card = document.getElementById('dropzone') as HTMLDivElement
  const input = document.getElementById('file-input') as HTMLInputElement
  const browse = document.getElementById('browse') as HTMLButtonElement
  const list = document.getElementById('file-list') as HTMLUListElement
  const idleArt = document.getElementById('idle-art') as unknown as SVGElement
  const ringWrap = document.getElementById('ring-wrap') as HTMLDivElement
  const ringProgress = document.getElementById('ring-progress') as unknown as SVGCircleElement
  const pctNum = document.getElementById('pct-num') as HTMLSpanElement
  const ringFile = document.getElementById('ring-file') as HTMLDivElement

  const endpoint = stage.dataset.endpoint || ''
  const maxBytes = Number(stage.dataset.maxBytes)
  const accepted = (stage.dataset.accepted || '').split(',').filter(Boolean)

  const RING_CIRCUMFERENCE = 2 * Math.PI * 52

  type Item = {
    id: string
    file: File
    status: 'queued' | 'uploading' | 'done' | 'error'
    progress: number
    error?: string
    el?: HTMLLIElement
  }
  const items: Item[] = []
  let uploading = false
  let idCounter = 0

  const fmtSize = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`
    const units = ['kb', 'mb', 'gb']
    let v = bytes / 1024
    let i = 0
    while (v >= 1024 && i < units.length - 1) {
      v /= 1024
      i++
    }
    return `${v < 10 ? v.toFixed(1) : Math.round(v)} ${units[i]}`
  }

  const extOf = (name: string) => {
    const dot = name.lastIndexOf('.')
    return dot === -1 ? '' : name.slice(dot).toLowerCase()
  }

  const badgeLabel = (name: string) => {
    const e = extOf(name).replace('.', '').toUpperCase()
    return e || 'FILE'
  }

  // Deterministic-ish color per extension for the badge outline.
  const badgeColor = (name: string) => {
    const map: Record<string, string> = {
      '.onnx': '#4a90d9',
      '.pt': '#e0645a',
      '.pth': '#e0645a',
      '.safetensors': '#8e6fd0',
      '.gguf': '#3fae86',
      '.h5': '#d98a3f',
      '.keras': '#d98a3f',
      '.zip': '#8a929c',
    }
    return map[extOf(name)] || '#7b98c9'
  }

  const validate = (file: File): string | null => {
    if (accepted.length && !accepted.includes(extOf(file.name))) {
      return `Unsupported type "${extOf(file.name) || '(none)'}"`
    }
    if (file.size === 0) return 'Empty file'
    if (file.size > maxBytes) return `Over ${fmtSize(maxBytes)} limit`
    return null
  }

  const renderCard = (item: Item) => {
    const li = document.createElement('li')
    li.className = 'file-card'
    li.dataset.status = item.status
    li.innerHTML = `
      <button type="button" class="file-x" aria-label="Remove ${item.file.name}">&times;</button>
      <span class="file-badge" style="color:${badgeColor(item.file.name)}">${badgeLabel(item.file.name)}</span>
      <div class="file-size">${item.status === 'error' ? item.error : fmtSize(item.file.size)}</div>
    `
    li.querySelector('.file-x')!.addEventListener('click', () => removeItem(item))
    item.el = li
    list.appendChild(li)
  }

  const updateCard = (item: Item) => {
    if (!item.el) return
    item.el.dataset.status = item.status
    const size = item.el.querySelector('.file-size') as HTMLDivElement
    if (item.status === 'error') size.textContent = item.error || 'Failed'
    else size.textContent = fmtSize(item.file.size)
  }

  const removeItem = (item: Item) => {
    const i = items.indexOf(item)
    if (i > -1) items.splice(i, 1)
    item.el?.remove()
    if (!uploading) showIdle()
  }

  const showIdle = () => {
    ringWrap.hidden = true
    idleArt.style.display = ''
  }

  const setRing = (pct: number, fileName: string) => {
    idleArt.style.display = 'none'
    ringWrap.hidden = false
    pctNum.textContent = String(pct)
    ringFile.textContent = fileName
    const offset = RING_CIRCUMFERENCE * (1 - pct / 100)
    ringProgress.style.strokeDashoffset = String(offset)
  }

  const addFiles = (fileList: FileList | File[]) => {
    for (const file of Array.from(fileList)) {
      const err = validate(file)
      const item: Item = {
        id: `f${idCounter++}`,
        file,
        status: err ? 'error' : 'queued',
        progress: 0,
        error: err || undefined,
      }
      items.push(item)
      renderCard(item)
    }
    processQueue()
  }

  const processQueue = () => {
    if (uploading) return
    const next = items.find((it) => it.status === 'queued')
    if (!next) {
      showIdle()
      return
    }

    if (!endpoint) {
      next.status = 'error'
      next.error = 'No endpoint'
      updateCard(next)
      // Surface it once in the ring area too.
      setRing(0, 'endpoint not set')
      ringFile.textContent = 'No upload endpoint configured'
      processQueue()
      return
    }

    uploading = true
    next.status = 'uploading'
    setRing(0, next.file.name)

    const body = new FormData()
    body.append('model', next.file, next.file.name)

    const xhr = new XMLHttpRequest()
    xhr.open('POST', endpoint)

    xhr.upload.addEventListener('progress', (ev) => {
      if (ev.lengthComputable) {
        const pct = Math.round((ev.loaded / ev.total) * 100)
        next.progress = pct
        setRing(pct, next.file.name)
      }
    })

    xhr.addEventListener('load', () => {
      uploading = false
      if (xhr.status >= 200 && xhr.status < 300) {
        next.status = 'done'
        setRing(100, next.file.name)
      } else {
        next.status = 'error'
        next.error = `HTTP ${xhr.status}`
      }
      updateCard(next)
      processQueue()
    })

    xhr.addEventListener('error', () => {
      uploading = false
      next.status = 'error'
      next.error = 'Network'
      updateCard(next)
      processQueue()
    })

    xhr.send(body)
  }

  // --- Wiring --------------------------------------------------------------
  browse.addEventListener('click', () => input.click())
  input.addEventListener('change', () => {
    if (input.files && input.files.length) addFiles(input.files)
    input.value = ''
  })

  ;['dragenter', 'dragover'].forEach((evt) =>
    card.addEventListener(evt, (e) => {
      e.preventDefault()
      card.classList.add('dragging')
    }),
  )
  ;['dragleave', 'drop'].forEach((evt) =>
    card.addEventListener(evt, (e) => {
      e.preventDefault()
      if (evt === 'dragleave' && card.contains((e as DragEvent).relatedTarget as Node)) return
      card.classList.remove('dragging')
    }),
  )
  card.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer
    if (dt && dt.files && dt.files.length) addFiles(dt.files)
  })
</script>
