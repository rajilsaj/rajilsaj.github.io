---
import { runs, type Run } from '~/data/runs'

const title = 'Running log'
const description = 'Day-by-day running performance'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')

const toSec = (t: string) => t.split(':').map(Number).reduce((a, b) => a * 60 + b, 0)
const fmtDuration = (s: number) => {
  const h = Math.floor(s / 3600)
  const m = Math.floor((s % 3600) / 60)
  const sec = Math.round(s % 60)
  return h > 0
    ? `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
    : `${m}:${String(sec).padStart(2, '0')}`
}
const fmtPace = (secPerMi: number) => {
  const m = Math.floor(secPerMi / 60)
  const s = Math.round(secPerMi % 60)
  return `${m}'${String(s).padStart(2, '0')}"`
}
const fmtDate = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' })

const sorted: Run[] = [...runs].sort((a, b) => b.date.localeCompare(a.date))
const count = sorted.length
const totalMi = sorted.reduce((a, r) => a + r.distanceMi, 0)
const totalSec = sorted.reduce((a, r) => a + toSec(r.workoutTime), 0)
const totalElev = sorted.reduce((a, r) => a + (r.elevationFt ?? 0), 0)
const totalCal = sorted.reduce((a, r) => a + (r.totalCal ?? 0), 0)
const hrRuns = sorted.filter((r) => r.avgHrBpm)
const avgHr = hrRuns.length ? Math.round(hrRuns.reduce((a, r) => a + r.avgHrBpm!, 0) / hrRuns.length) : null
const avgPace = totalMi > 0 ? fmtPace(totalSec / totalMi) : '–'
const longest = Math.max(...sorted.map((r) => r.distanceMi))
const fastest = sorted.reduce((best, r) => (toSec(r.avgPace) < toSec(best.avgPace) ? r : best), sorted[0])

type Metric = { label: string; value: string; unit?: string; color: string }
const metricsFor = (r: Run): Metric[] => {
  const m: Metric[] = [
    { label: 'Workout Time', value: r.workoutTime, color: 'yellow' },
  ]
  if (r.elapsedTime) m.push({ label: 'Elapsed Time', value: r.elapsedTime, color: 'yellow' })
  m.push({ label: 'Distance', value: r.distanceMi.toFixed(2), unit: 'MI', color: 'blue' })
  if (r.activeCal) m.push({ label: 'Active Calories', value: String(r.activeCal), unit: 'CAL', color: 'red' })
  if (r.totalCal) m.push({ label: 'Total Calories', value: String(r.totalCal), unit: 'CAL', color: 'red' })
  if (r.elevationFt != null) m.push({ label: 'Elevation Gain', value: String(r.elevationFt), unit: 'FT', color: 'green' })
  if (r.avgPowerW) m.push({ label: 'Avg. Power', value: String(r.avgPowerW), unit: 'W', color: 'lime' })
  if (r.avgCadenceSpm) m.push({ label: 'Avg. Cadence', value: String(r.avgCadenceSpm), unit: 'SPM', color: 'cyan' })
  m.push({ label: 'Avg. Pace', value: fmtPace(toSec(r.avgPace)), unit: '/MI', color: 'cyan' })
  if (r.avgHrBpm) m.push({ label: 'Avg. Heart Rate', value: String(r.avgHrBpm), unit: 'BPM', color: 'orange' })
  return m
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000" />
    <style is:global>
      :root {
        --bg: #000;
        --card: #1c1c1e;
        --card-2: #2c2c2e;
        --line: #3a3a3c;
        --text: #fff;
        --muted: #8e8e93;
        --yellow: #ffd60a;
        --blue: #0a84ff;
        --red: #ff375f;
        --green: #30d158;
        --lime: #c8f542;
        --cyan: #5ac8fa;
        --orange: #ff6b3d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--text); -webkit-text-size-adjust: 100%; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.3;
        min-height: 100vh;
      }
      main { max-width: 760px; margin: 0 auto; padding: 28px 16px 60px; }

      header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
      .badge {
        width: 56px; height: 56px; border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #b8ff3a, #5c8a00);
        display: grid; place-items: center; font-size: 28px; flex: none;
        box-shadow: 0 0 24px rgba(184, 255, 58, 0.25);
      }
      h1 { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; }
      header p { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }

      h2 { font-size: 1.35rem; font-weight: 700; margin: 26px 0 12px; }

      .summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
      @media (min-width: 560px) { .summary { grid-template-columns: repeat(3, 1fr); } }
      .tile { background: var(--card); border-radius: 14px; padding: 14px 16px; }
      .tile .label { color: var(--muted); font-size: 0.85rem; font-weight: 600; }
      .tile .value { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 2px; }
      .tile .value small { font-size: 0.6em; margin-left: 2px; }
      .tile .sub { color: var(--muted); font-size: 0.8rem; margin-top: 2px; }

      .run { background: var(--card); border-radius: 18px; overflow: hidden; margin-bottom: 14px; }
      .run-head { padding: 16px 18px 12px; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .run-head h3 { font-size: 1.15rem; font-weight: 700; }
      .run-head .meta { color: var(--muted); font-size: 0.9rem; }
      .run-head .meta span + span::before { content: ' · '; }
      .metrics { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }
      @media (min-width: 560px) { .metrics { grid-template-columns: repeat(3, 1fr); } }
      @media (min-width: 720px) { .metrics { grid-template-columns: repeat(5, 1fr); } }
      .metric { padding: 12px 18px; border-bottom: 1px solid var(--line); }
      .metric .label { color: var(--text); font-size: 0.85rem; opacity: 0.85; }
      .metric .value { font-size: 1.55rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 1px; white-space: nowrap; }
      .metric .value small { font-size: 0.6em; font-weight: 700; margin-left: 1px; }
      .yellow { color: var(--yellow); } .blue { color: var(--blue); } .red { color: var(--red); }
      .green { color: var(--green); } .lime { color: var(--lime); } .cyan { color: var(--cyan); } .orange { color: var(--orange); }
      .notes { padding: 10px 18px 14px; color: var(--muted); font-size: 0.9rem; }
      .empty { color: var(--muted); padding: 24px; text-align: center; }

      footer { color: var(--muted); font-size: 0.8rem; margin-top: 30px; text-align: center; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="badge">🏃</div>
        <div>
          <h1>Running log</h1>
          <p>Day by day, from the watch to the web.</p>
        </div>
      </header>

      <section aria-label="Totals" class="summary">
        <div class="tile">
          <div class="label">Runs</div>
          <div class="value">{count}</div>
          <div class="sub">since {sorted.length ? fmtDate(sorted[sorted.length - 1].date).replace(/^\w+, /, '') : '–'}</div>
        </div>
        <div class="tile">
          <div class="label">Total distance</div>
          <div class="value blue">{totalMi.toFixed(2)}<small>MI</small></div>
          <div class="sub">longest {longest.toFixed(2)} mi</div>
        </div>
        <div class="tile">
          <div class="label">Total time</div>
          <div class="value yellow">{fmtDuration(totalSec)}</div>
          <div class="sub">workout time</div>
        </div>
        <div class="tile">
          <div class="label">Avg. pace</div>
          <div class="value cyan">{avgPace}<small>/MI</small></div>
          <div class="sub">best {fmtPace(toSec(fastest.avgPace))}/mi</div>
        </div>
        <div class="tile">
          <div class="label">Elevation gain</div>
          <div class="value green">{totalElev}<small>FT</small></div>
          <div class="sub">total climbed</div>
        </div>
        <div class="tile">
          <div class="label">Avg. heart rate</div>
          <div class="value orange">{avgHr ?? '–'}<small>BPM</small></div>
          <div class="sub">{totalCal} cal burned</div>
        </div>
      </section>

      <h2>Day by day</h2>
      {sorted.length === 0 && <p class="empty">No runs logged yet.</p>}
      {sorted.map((r) => (
        <article class="run">
          <div class="run-head">
            <h3>{fmtDate(r.date)}</h3>
            <div class="meta">
              {r.time && <span>{r.time}</span>}
              {r.location && <span>➤ {r.location}</span>}
            </div>
          </div>
          <div class="metrics">
            {metricsFor(r).map((m) => (
              <div class="metric">
                <div class="label">{m.label}</div>
                <div class={`value ${m.color}`}>{m.value}{m.unit && <small>{m.unit}</small>}</div>
              </div>
            ))}
          </div>
          {r.notes && <p class="notes">{r.notes}</p>}
        </article>
      ))}

      <footer>Outdoor runs recorded with Apple Watch · <a href="/">rajil.me</a></footer>
    </main>
  </body>
</html>
