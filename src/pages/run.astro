---
import { CHALLENGE_START, GOAL_DAY, HR_ZONES, challengeDays, challengeYear, dayNumber, progressOn, todayIso, runTotals, weightsByDate, pushupsByDate, sleepByDate, toSec, fmtDuration, fmtPace, fmtDate, effortLabel, isBirthday, isRestDay, activityOn, activityTotals } from '~/data/runs'

const title = 'Day by Day Challenge · Running Non Stop'
const description = 'Running every single day, no finish line. Days, months and years completed.'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')

const days = challengeDays() // every calendar day since Day 0 through today, oldest → newest (rendered newest first)
const lastDay = days[days.length - 1]?.day ?? 0
const { count, measured, totalMi, totalSec, avgPaceSec } = runTotals()
const cross = activityTotals()
// per-kind wording and colours for cross-training (rides and walks)
const KIND = {
  bike: { emoji: '🚴', noun: 'ride', verb: 'riding', day: 'Bike day', title: 'Bike ride', afterRun: 'Then the bike came out', easy: 'an easy spin to flush the legs', splits: 'Every 5 mi' },
  walk: { emoji: '🚶', noun: 'walk', verb: 'walking', day: 'Walk day', title: 'Walk', afterRun: 'Then a walk', easy: 'easy miles, all aerobic base', splits: 'Mile splits' },
} as const

// heart-rate zones as seconds and whole percentages (shared by runs, rides and walks)
const zoneBreakdown = (zones?: string[]) => {
  const sec = zones?.map(toSec) ?? []
  const total = sec.reduce((a, b) => a + b, 0)
  return { sec, total, pct: sec.map((z) => (total ? Math.round((z / total) * 100) : 0)) }
}

const weightLog = weightsByDate()
const sleepLog = sleepByDate()
const latestWeight = weightLog[weightLog.length - 1] ?? null
const firstWeight = weightLog[0] ?? null
const weightChange = latestWeight && firstWeight && latestWeight !== firstWeight ? latestWeight.lb - firstWeight.lb : null

const pushupLog = pushupsByDate()
const totalPushups = pushupLog.reduce((a, p) => a + p.count, 0)
const latestPushups = pushupLog[pushupLog.length - 1] ?? null

// change vs the previous run day
type Delta = { text: string; dir: 'up' | 'down' | 'flat' } | null
const delta = (cur: number | undefined, prev: number | undefined, fmt: (n: number) => string, lowerIsBetter = false): Delta => {
  if (cur == null || prev == null) return null
  const d = cur - prev
  if (Math.abs(d) < 1e-9) return { text: '=', dir: 'flat' }
  const better = lowerIsBetter ? d < 0 : d > 0
  return { text: `${d > 0 ? '+' : '−'}${fmt(Math.abs(d))}`, dir: better ? 'up' : 'down' }
}
const signed = (n: number, unit: string) => `${n > 0 ? '+' : '−'}${Math.abs(n).toFixed(1)} ${unit}`

// challenge progress (server-side fallback; the browser recomputes it live)
const startDate = CHALLENGE_START
const prog = progressOn(todayIso())
const dayNow = prog.day
const buildToday = todayIso()

// GitHub-style board for the current challenge year: one column per week (Sun → Sat), one square per day,
// shaded by distance run that day
const runOn = new Map(days.filter((d) => d.run).map((d) => [d.date, d.run!]))
const level = (date: string) => {
  if (!runOn.has(date)) return 0
  const mi = runOn.get(date)!.distanceMi
  if (mi == null) return 2
  return mi < 3 ? 1 : mi < 5 ? 2 : mi < 7 ? 3 : 4
}
const cellTitle = (date: string) => {
  const r = runOn.get(date)
  const what = r ? (r.distanceMi != null ? `${r.distanceMi.toFixed(2)} mi` : 'Run') : isRestDay(date) ? '🧘 Recovery day' : 'No run'
  const act = activityOn(date)
  return `${isBirthday(date) ? '🎂 Birthday · ' : ''}${what}${act ? ` + ${KIND[act.kind].emoji} ${act.distanceMi.toFixed(2)} mi ${KIND[act.kind].noun}` : ''} · Day ${dayNumber(date)} · ${fmtDate(date, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}`
}
const yearDates = challengeYear(prog.years).flatMap((m) => m.dates)
const yearRuns = yearDates.filter((d) => runOn.has(d)).length
const cells: (string | null)[] = [...Array(new Date(yearDates[0] + 'T00:00:00Z').getUTCDay()).fill(null), ...yearDates]
while (cells.length % 7) cells.push(null)
const weekCount = cells.length / 7
// label a week column with the month whose 1st falls in it (like GitHub)
const monthLabels = Array.from({ length: weekCount }, (_, w) => {
  const first = cells.slice(w * 7, w * 7 + 7).find((d) => d?.endsWith('-01'))
  return first ? fmtDate(first, { month: 'short' }) : ''
})
// two half-year boards: side by side on wide screens, stacked on phones, squares scale to fit (no scrolling)
const half = Math.ceil(weekCount / 2)
const halves = [
  [0, half],
  [half, weekCount],
].map(([from, to]) => {
  const hc = cells.slice(from * 7, to * 7)
  // no label in the last two columns (it would run off the edge); a half that opens mid-month names that month
  const labels = monthLabels.slice(from, to).map((l, i, all) => (i >= all.length - 2 ? '' : l))
  if (!labels[0] && !labels[1]) labels[0] = fmtDate(hc.find((d) => d)!, { month: 'short' })
  return { weeks: to - from, labels, cells: hc }
})
const rings = [
  { key: 'days', value: prog.day, label: prog.day === 1 ? 'day' : 'days', pct: prog.milestonePct, sub: `next stop: Day ${prog.milestone}` },
  { key: 'months', value: prog.months, label: prog.months === 1 ? 'month' : 'months', pct: prog.monthPct, sub: `${prog.daysToNextMonth} ${prog.daysToNextMonth === 1 ? 'day' : 'days'} to month ${prog.months + 1}` },
  { key: 'years', value: prog.years, label: prog.years === 1 ? 'year' : 'years', pct: prog.yearPct, sub: `${prog.daysToNextYear} ${prog.daysToNextYear === 1 ? 'day' : 'days'} to year ${prog.years + 1}` },
]

// previous logged value before a given date (so deltas work across rest days)
const prevWeightBefore = (date: string) => [...weightLog].reverse().find((w) => w.date < date)?.lb
const prevSleepBefore = (date: string) => [...sleepLog].reverse().find((s) => s.date < date)?.hours
const prevPushupsBefore = (date: string) => [...pushupLog].reverse().find((p) => p.date < date)?.count

// Weigh-in summary: consecutive weigh-ins at the same weight collapse into one stretch
const wMin = Math.min(...weightLog.map((w) => w.lb))
const wMax = Math.max(...weightLog.map((w) => w.lb))
const wGroups = weightLog.reduce<{ lb: number; from: string; to: string; n: number; d: Delta }[]>((gs, w) => {
  const last = gs[gs.length - 1]
  if (last && Math.abs(last.lb - w.lb) < 1e-9) {
    last.to = w.date
    last.n++
  } else gs.push({ lb: w.lb, from: w.date, to: w.date, n: 1, d: last ? delta(w.lb, last.lb, (n) => `${n.toFixed(1)} lb`, true) : null })
  return gs
}, [])

// Evolution chart: weight line on top, daily miles (run + walk/ride stacked) below with the running total
const EV = { w: 640, h: 360, l: 46, r: 46, wTop: 30, wBot: 150, mTop: 196, mBot: 310 }
const evDays = days.map((d) => ({
  ...d,
  runMi: d.run?.distanceMi ?? 0,
  actMi: d.activity?.distanceMi ?? 0,
}))
const evCol = (EV.w - EV.l - EV.r) / Math.max(1, evDays.length)
const evX = (i: number) => EV.l + (i + 0.5) * evCol
const evW = weightLog.map((w) => w.lb)
const evWMin = Math.floor((Math.min(...evW) - 0.3) * 2) / 2
const evWMax = Math.ceil((Math.max(...evW) + 0.3) * 2) / 2
const evWY = (lb: number) => EV.wBot - ((lb - evWMin) / (evWMax - evWMin || 1)) * (EV.wBot - EV.wTop)
const evWTicks = Array.from({ length: Math.round((evWMax - evWMin) / 0.5) + 1 }, (_, i) => evWMin + i * 0.5).filter((_, i, a) => a.length <= 6 || i % 2 === 0)
const evWPts = weightLog.map((w) => ({ x: evX(dayNumber(w.date)), y: evWY(w.lb), w }))
// smooth curve through the weigh-ins that never overshoots (monotone cubic, Fritsch–Carlson)
const evSlopes = (() => {
  const p = evWPts
  const d = p.slice(1).map((q, i) => (q.y - p[i].y) / (q.x - p[i].x || 1))
  return p.map((_, i) => {
    if (i === 0) return d[0] ?? 0
    if (i === p.length - 1) return d[i - 1]
    return d[i - 1] * d[i] <= 0 ? 0 : (2 * d[i - 1] * d[i]) / (d[i - 1] + d[i])
  })
})()
const evWPath = evWPts
  .map((p, i, a) => {
    if (i === 0) return `M${p.x.toFixed(1)},${p.y.toFixed(1)}`
    const q = a[i - 1], h = (p.x - q.x) / 3
    return `C${(q.x + h).toFixed(1)},${(q.y + evSlopes[i - 1] * h).toFixed(1)} ${(p.x - h).toFixed(1)},${(p.y - evSlopes[i] * h).toFixed(1)} ${p.x.toFixed(1)},${p.y.toFixed(1)}`
  })
  .join(' ')
const evWArea = evWPts.length ? `${evWPath} L${evWPts[evWPts.length - 1].x.toFixed(1)},${EV.wBot} L${evWPts[0].x.toFixed(1)},${EV.wBot} Z` : ''
const evMMax = Math.max(2, Math.ceil(Math.max(...evDays.map((d) => d.runMi + d.actMi)) / 2) * 2)
const evMH = (mi: number) => (mi / evMMax) * (EV.mBot - EV.mTop)
let evRunning = 0
const evCum = evDays.map((d) => (evRunning += d.runMi))
const evCumMax = Math.max(1, evRunning)
const evCumY = (mi: number) => EV.mBot - (mi / evCumMax) * (EV.mBot - EV.mTop)
const evCumPath = evCum.map((c, i) => `${i ? 'L' : 'M'}${evX(i).toFixed(1)},${evCumY(c).toFixed(1)}`).join(' ')
const evStep = evDays.length <= 35 ? 7 : evDays.length <= 120 ? 14 : 30
const evBarW = Math.max(2, Math.min(18, evCol * 0.62))
const evLongest = evDays.reduce((b, d) => (d.runMi > b.runMi ? d : b), evDays[0])
const evLowest = weightLog.reduce((b, w) => (w.lb < b.lb ? w : b), weightLog[0])
// tap/hover readout text for each day
const evInfo = evDays.map((d) => {
  const bits = [d.run?.distanceMi != null ? `🏃 ${d.run.distanceMi.toFixed(2)} mi` : d.run ? '🏃 Run' : d.rest ? '🧘 Recovery' : 'No run']
  if (d.activity) bits.push(`${KIND[d.activity.kind].emoji} ${d.activity.distanceMi.toFixed(2)} mi`)
  if (d.weight != null) bits.push(`⚖️ ${d.weight.toFixed(1)} lb`)
  return `Day ${d.day} · ${fmtDate(d.date, { weekday: 'short', month: 'short', day: 'numeric' })} · ${bits.join(' · ')} · ${evCum[d.day].toFixed(1)} mi total`
})

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- add to home screen: opens full screen like an app -->
    <link rel="apple-touch-icon" href="/run/icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Run" />
    <meta name="theme-color" content="#0b0e13" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('run-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <style is:global>
      :root {
        --bg: #0b0e13;
        --card: #151b22;
        --card-2: #1b222b;
        --line: #252c35;
        --track: #2a323c;
        --text: #fff;
        --muted: #8b95a3;
        --lime: #c8f22b;
        --yellow: #fff;
        --blue: #fff;
        --red: #ff5c7a;
        --green: #c8f22b;
        --cyan: #fff;
        --orange: #fff;
        --purple: #fff;
        --bar: #c8f22b;
        --bar-track: rgba(200, 242, 43, 0.22);
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: dark;
      }
      :root[data-theme='light'] {
        --bg: #fff;
        --card: #f3f5f7;
        --card-2: #eaedf1;
        --line: #dde2e8;
        --track: #e3e7ec;
        --text: #0b0e13;
        --muted: #66707c;
        --lime: #c8f22b;
        --yellow: #0b0e13;
        --blue: #0b0e13;
        --red: #d7263d;
        --green: #6c9600;
        --cyan: #0b0e13;
        --orange: #0b0e13;
        --purple: #0b0e13;
        --bar: #c8f22b;
        --bar-track: #ebf8b8;
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: light;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--text); -webkit-text-size-adjust: 100%; }
      body {
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.3;
        min-height: 100vh;
        overflow-x: hidden;
      }
      main { max-width: 760px; margin: 0 auto; padding: max(28px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(60px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); }

      header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
      header .titles { flex: 1; min-width: 0; }

      /* black & white theme switch */
      .theme-toggle {
        flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; padding: 0;
        border: 2px solid var(--text);
        background: linear-gradient(90deg, #000 0 50%, #fff 50% 100%);
        box-shadow: 0 0 0 2px var(--bg), 0 2px 10px rgba(0, 0, 0, 0.3);
        transition: transform 0.35s ease;
      }
      .theme-toggle:hover { transform: rotate(180deg); }
      .theme-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
      :root[data-theme='light'] .theme-toggle { transform: rotate(180deg); }
      :root[data-theme='light'] .theme-toggle:hover { transform: rotate(360deg); }
      /* animated runner in the header: white on the dark theme, black on the light one, no background */
      .runner { width: 56px; height: 56px; flex: none; color: var(--text); }
      .runner svg { width: 100%; height: 100%; display: block; overflow: visible; }
      .runner line, .runner polyline { stroke: currentColor; stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; fill: none; }
      .runner circle { fill: currentColor; }
      .runner g { transform-box: view-box; }
      .runner .back { opacity: 0.5; }
      /* sprint cycle: forward lean, high knee drive, heel kick, bent arms pumping; 0.5s per stride pair */
      .runner { --stride: 0.5s; }
      .runner .body { animation: run-bob calc(var(--stride) / 2) ease-in-out infinite; }
      .runner .thigh { transform-origin: 28px 38px; animation: run-thigh var(--stride) linear infinite; }
      .runner .shin { transform-origin: 28px 49px; animation: run-shin var(--stride) linear infinite; }
      .runner .arm { transform-origin: 33px 24px; animation: run-arm var(--stride) ease-in-out infinite; }
      .runner .back .thigh, .runner .back .shin, .runner .back.arm { animation-delay: calc(var(--stride) / -2); }
      .runner .shadow { fill: currentColor; opacity: 0.15; transform-origin: 30px 62px; animation: run-shadow calc(var(--stride) / 2) ease-in-out infinite; }
      @keyframes run-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3.5px); } }
      @keyframes run-thigh { 0%, 100% { transform: rotate(-45deg); } 25% { transform: rotate(-5deg); } 50% { transform: rotate(42deg); } 65% { transform: rotate(28deg); } 85% { transform: rotate(-70deg); } }
      @keyframes run-shin { 0%, 100% { transform: rotate(15deg); } 25% { transform: rotate(20deg); } 50% { transform: rotate(35deg); } 65% { transform: rotate(125deg); } 85% { transform: rotate(105deg); } }
      @keyframes run-arm { 0%, 100% { transform: rotate(55deg); } 50% { transform: rotate(-50deg); } }
      @keyframes run-shadow { 0%, 100% { transform: scaleX(1); } 50% { transform: scaleX(0.75); } }
      @media (prefers-reduced-motion: reduce) { .runner * { animation-play-state: paused !important; } }
      h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
      header p { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
      h2 { font-size: 1.2rem; font-weight: 700; margin: 26px 0 10px; }

      .challenge { background: linear-gradient(135deg, var(--card) 0%, var(--card-2) 100%); border-radius: 18px; padding: 20px 20px 18px; margin-bottom: 14px; border: 1px solid var(--track); min-width: 0; max-width: 100%; }
      .challenge .top { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; }
      .challenge .range { margin-left: auto; }
      @media (max-width: 559px) {
        .challenge { padding: 16px; }
        .challenge .count { font-size: 2.2rem; }
        h1 { font-size: clamp(1.25rem, 6.2vw, 1.5rem); }
        .challenge .range { font-size: 0.8rem; flex-basis: 100%; margin-left: 0; }
      }
      .challenge .count { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
      .challenge .count .pre { font-size: 0.4em; font-weight: 700; color: var(--muted); margin-right: 6px; letter-spacing: 0.04em; text-transform: uppercase; }
      .challenge .range { color: var(--muted); font-size: 0.85rem; }
      /* Day 90 reached: lime trophy pill under the counter and on the Day 90 row */
      .achieved, .goal-tag { display: inline-block; background: var(--bar); color: #0b0e13; font-weight: 800; font-size: 0.78rem; padding: 5px 11px; border-radius: 999px; white-space: nowrap; letter-spacing: 0.01em; }
      .achieved[hidden] { display: none; }
      /* birthday row: confetti-gradient pill with a bobbing cake */
      .bday-tag { display: block; width: max-content; margin-top: 6px; font-size: 0.7rem; font-weight: 800; padding: 3px 9px; border-radius: 999px; color: #0b0e13; white-space: nowrap; letter-spacing: 0.01em;
        background: linear-gradient(90deg, #ff5c7a, #ff9f0a, #c8f22b, #5ac8fa, #bf5af2, #ff5c7a); background-size: 300% 100%; animation: bday-shimmer 6s linear infinite; }
      .bday-tag .cake { display: inline-block; animation: bday-bob 1.6s ease-in-out infinite; }
      @keyframes bday-shimmer { to { background-position: 300% 0; } }
      @keyframes bday-bob { 0%, 100% { transform: translateY(0) rotate(0); } 25% { transform: translateY(-2px) rotate(-8deg); } 75% { transform: translateY(-1px) rotate(8deg); } }
      @media (prefers-reduced-motion: reduce) { .bday-tag, .bday-tag .cake { animation: none; } }
      .goal-tag { display: block; width: max-content; margin-top: 6px; font-size: 0.7rem; padding: 3px 9px; }
      .challenge .range b { color: var(--text); font-weight: 600; }

      /* three rings: days (toward the next milestone), months and years (through the current one) */
      .rings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }
      .ring { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; min-width: 0; }
      .ring svg { width: 100%; max-width: 104px; aspect-ratio: 1; transform: rotate(-90deg); display: block; }
      .ring circle { fill: none; stroke-width: 3.4; }
      .ring-bg { stroke: var(--bar-track); }
      .ring-fg { stroke: var(--bar); stroke-linecap: round; stroke-dasharray: 100; transition: stroke-dashoffset 0.8s ease; }
      .ring-num { position: absolute; top: 0; left: 0; right: 0; aspect-ratio: 1; max-width: 104px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; }
      .ring-num b { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; }
      .ring-num span { font-size: 0.68rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 3px; }
      .ring-sub { color: var(--muted); font-size: 0.74rem; margin-top: 8px; line-height: 1.25; text-wrap: balance; }
      @media (max-width: 399px) { .ring-num b { font-size: 1.3rem; } .ring-num span { font-size: 0.6rem; } }

      /* year board, GitHub contributions style: week columns, weekday rows, squares shaded by distance */
      .yeargrid { background: var(--card); border-radius: 16px; padding: 14px 16px 12px; margin-bottom: 14px; }
      .yg-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
      .yg-head h2 { margin: 0; font-size: 1rem; }
      .yg-sum { color: var(--muted); font-size: 0.8rem; }
      .yg { display: flex; gap: 6px; }
      .yg-half { --wd: 24px; --gap: 3px; flex: 1 1 0; min-width: 0; }
      .yg-half + .yg-half { --wd: 0px; }
      .yg-half + .yg-half .wd { visibility: hidden; }
      .yg-months, .yg-cells { display: grid; grid-template-columns: var(--wd) repeat(var(--weeks), minmax(0, 1fr)); column-gap: var(--gap); }
      .yg-months { font-size: 0.68rem; color: var(--muted); height: 16px; }
      .yg-months span { white-space: nowrap; overflow: visible; }
      .yg-cells { grid-template-rows: repeat(7, auto); grid-auto-flow: column; row-gap: var(--gap); }
      .wd { font-size: 0.6rem; color: var(--muted); align-self: center; line-height: 1; overflow: hidden; }
      .cell { display: block; width: 10px; height: 10px; border-radius: 2px; background: var(--track); }
      .yg-cells .cell { width: auto; height: auto; aspect-ratio: 1; }
      /* tablets and phones: stack the two halves, each full width */
      @media (max-width: 699px) {
        .yg { flex-direction: column; gap: 12px; max-width: 480px; margin: 0 auto; }
        .yg-half + .yg-half { --wd: 24px; }
        .yg-half + .yg-half .wd { visibility: visible; }
      }
      @media (max-width: 399px) { .yg-half, .yg-half + .yg-half { --gap: 2px; --wd: 22px; } .yeargrid { padding: 14px 12px 12px; } }
      .cell.pad { background: transparent; }
      .cell.l1 { background: rgba(200, 242, 43, 0.3); }
      .cell.l2 { background: rgba(200, 242, 43, 0.55); }
      .cell.l3 { background: rgba(200, 242, 43, 0.8); }
      .cell.l4 { background: var(--bar); }
      .cell.future { opacity: 0.4; }
      .cell.today { outline: 2px solid var(--text); outline-offset: -1px; }
      /* birthday: a little cake on top of that day's square */
      .cell.bday, .cell.recovery { position: relative; overflow: visible; }
      .cell.recovery::after { content: '🧘'; }
      .cell.bday::after { content: '🎂'; }
      .cell.bday::after, .cell.recovery::after { position: absolute; inset: -35%; display: grid; place-items: center; font-size: 0.75rem; line-height: 1; font-style: normal; }
      .yg-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 8px; color: var(--muted); font-size: 0.72rem; }
      .legend { display: inline-flex; align-items: center; gap: 3px; }
      .legend .cell { margin: 0 1px; }
      @media (prefers-reduced-motion: reduce) { .ring-fg { transition: none; } }

      /* tiles: 2 per row on phones, 3 on tablets, all 5 in one row on desktop; last row always stretches to fill */
      .summary { display: flex; flex-wrap: wrap; gap: 10px; }
      .tile { flex: 1 1 calc(50% - 10px); min-width: 0; background: var(--card); border-radius: 14px; padding: 14px 14px; container-type: inline-size; }
      @media (min-width: 600px) { .tile { flex-basis: calc(33.333% - 10px); } }
      @media (min-width: 740px) { .tile { flex-basis: 0; } }
      .tile .label { color: var(--muted); font-size: 0.82rem; font-weight: 600; }
      .tile .value { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: clip; }
      .tile .value small { font-size: 0.6em; margin-left: 2px; }
      .tile .sub { color: var(--muted); font-size: 0.8rem; margin-top: 2px; overflow-wrap: anywhere; }
      /* shrink the big number when the tile itself is narrow, whatever the viewport */
      @container (max-width: 150px) { .tile .value { font-size: 1.35rem; } }
      @container (max-width: 120px) { .tile .value { font-size: 1.15rem; } }

      .table-wrap { background: var(--card); border-radius: 16px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
      .table-wrap::-webkit-scrollbar { height: 6px; }
      .table-wrap::-webkit-scrollbar-track { background: transparent; }
      .table-wrap::-webkit-scrollbar-thumb { background: var(--line); border-radius: 999px; }
      table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
      th, td { text-align: left; padding: 12px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
      tr:last-child td { border-bottom: none; }
      td .v { font-weight: 700; font-size: 1.1rem; }
      .daycell { font-weight: 700; }
      .daycell .datesub { display: block; color: var(--muted); font-weight: 400; font-size: 0.82rem; margin-top: 2px; }
      .datecell { color: var(--muted); }
      tr.rest .daycell, tr.rest .datecell { color: var(--muted); }
      .rest-label { display: inline-block; color: var(--muted); font-size: 0.85rem; font-style: italic; }
      .rest-emoji { display: inline-block; font-style: normal; font-size: 1.35rem; line-height: 1; vertical-align: middle; margin-right: 6px; }
      .delta { display: block; font-size: 0.78rem; margin-top: 2px; color: var(--muted); }
      /* heart-rate zone strip: zones 1–5 sized by time spent, under the average heart rate */
      .zones { display: flex; gap: 2px; height: 5px; margin-top: 6px; min-width: 96px; }
      .zones i { display: block; flex-basis: 0; min-width: 2px; border-radius: 3px; }
      .z1 { background: #0a84ff; } .z2 { background: #5ac8fa; } .z3 { background: #c8f22b; } .z4 { background: #ff9f0a; } .z5 { background: #ff375f; }
      .rec { display: block; font-size: 0.72rem; color: var(--muted); margin-top: 4px; }
      .delta.up { color: var(--green); }
      .delta.down { color: var(--red); }
      .yellow { color: var(--yellow); } .blue { color: var(--blue); } .red { color: var(--red); }
      .green { color: var(--green); } .cyan { color: var(--cyan); } .orange { color: var(--orange); } .purple { color: var(--purple); }
      .empty { color: var(--muted); padding: 20px; text-align: center; }

      /* wider screens: eight columns, so keep cells compact enough to fit without scrolling */
      @media (min-width: 740px) {
        .daylog th, .daylog td { padding: 12px 7px; }
        .daylog th:first-child, .daylog td:first-child { padding-left: 14px; }
        .daylog th:last-child, .daylog td:last-child { padding-right: 14px; }
        .daylog th { font-size: 0.7rem; letter-spacing: 0.02em; }
        .daylog td .v { font-size: 1rem; }
        .daylog .zones { min-width: 72px; }
        .daylog tr.details td { padding: 12px 14px; }
      }

      /* phones and small tablets: each day becomes a card with a two-column grid of labelled stats */
      @media (max-width: 739px) {
        .daylog thead { display: none; }
        .daylog, .daylog tbody { display: block; }
        .daylog tr { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px 14px; padding: 14px 16px 16px; border-bottom: 1px solid var(--line); }
        .daylog tr:last-child { border-bottom: none; }
        .daylog td { display: block; padding: 0; border: 0; white-space: normal; min-width: 0; }
        .daylog td.daycell { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: 1.05rem; }
        .daylog .goal-tag, .daylog .bday-tag, .daylog .ride-tag { margin-top: 0; }
        .daylog td.daycell .datesub { display: inline; margin: 0; }
        .daylog td[colspan] { grid-column: 1 / -1; }
        /* run stats two per row; weight, push-ups and sleep three per row */
        .daylog td[data-label] { grid-column: span 3; }
        .daylog td[data-label='Weight'], .daylog td[data-label='Push-ups'], .daylog td[data-label='Sleep'] { grid-column: span 2; }
        .daylog tr.rest { gap: 6px 14px; }
        .daylog tr.rest td[colspan] { margin-bottom: 4px; }
        .daylog td[data-label]::before { content: attr(data-label); display: block; color: var(--muted); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
        .daylog td .v { font-size: 1.05rem; }
        .daylog .delta { display: inline-block; margin: 0 0 0 6px; white-space: nowrap; }
        .daylog .zones { max-width: 160px; }
      }

      /* click a day to open its details: heart-rate zones up front, a few key numbers, mile splits */
      .daylog tr.expandable { cursor: pointer; }
      .daylog tr.expandable:hover td, .daylog tr.expandable[aria-expanded='true'] td { background: var(--card-2); }
      .daylog tr.expandable:focus-visible { outline: 2px solid var(--bar); outline-offset: -2px; }
      .more { display: block; width: max-content; margin-top: 6px; font-size: 0.72rem; font-weight: 600; color: var(--muted); }
      .chev { display: inline-block; font-style: normal; margin-left: 4px; transition: transform 0.2s; }
      tr[aria-expanded='true'] .chev { transform: rotate(180deg); }
      .daylog tr.details[hidden] { display: none; }
      .daylog tr.details td { background: var(--card-2); white-space: normal; padding: 4px 16px 18px; }
      .dt-meta { color: var(--muted); font-size: 0.8rem; margin-bottom: 14px; }
      /* heart-rate zones: one stacked bar, five-column legend */
      .hz { background: var(--card); border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; }
      .hz-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 0.85rem; color: var(--muted); }
      .hz-top b { font-size: 1.5rem; color: var(--text); letter-spacing: -0.02em; margin-right: 2px; }
      .hz-avg { font-weight: 600; white-space: nowrap; }
      .hz-bar { display: flex; gap: 3px; height: 14px; margin: 12px 0; }
      .hz-bar i { display: block; flex-basis: 0; min-width: 4px; border-radius: 999px; }
      .hz-legend { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .hz-item { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .hz-item.off { opacity: 0.4; }
      .hz-name { display: flex; align-items: center; gap: 5px; font-size: 0.72rem; font-weight: 700; color: var(--muted); }
      .hz-name i { width: 8px; height: 8px; border-radius: 50%; display: block; }
      .hz-item b { font-size: 0.95rem; font-variant-numeric: tabular-nums; }
      .hz-pct { font-size: 0.72rem; color: var(--muted); }
      /* three key numbers and the splits, kept on single quiet lines */
      .dt-keys { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 2px 4px 12px; }
      .dt-keys div { display: flex; align-items: baseline; gap: 6px; }
      .dt-keys b { font-size: 1.05rem; }
      .dt-keys span, .dt-label { color: var(--muted); font-size: 0.78rem; }
      .dt-splits { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 0 4px; }
      .dt-label { margin-right: 4px; }
      .split { font-size: 0.8rem; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: var(--card); font-variant-numeric: tabular-nums; }
      .split.fast { color: #0b0e13; background: var(--green); }
      .split.slow { color: #fff; background: var(--red); }
      @media (max-width: 739px) {
        .daylog tr.details { display: block; padding: 0; }
        .daylog tr.expandable:hover td, .daylog tr.expandable[aria-expanded='true'] td { background: none; }
        .daylog tr.expandable[aria-expanded='true'] { background: var(--card-2); }
        .daylog tr.details td { display: block; padding: 14px 16px 16px; }
        .daylog .more { margin-top: 0; margin-left: auto; }
        .hz { padding: 12px; }
        .hz-item b { font-size: 0.85rem; }
      }

      /* cross-training days: a gradient pill on the row and a card in the details; sky blue for rides, amber for walks */
      .ride, .ride-tag { --acc: #5ac8fa; }
      .ride.kind-walk, .ride-tag.kind-walk { --acc: #ffb340; }
      .sky { color: #5ac8fa; }
      :root[data-theme='light'] .sky { color: #0a7fb5; }
      .ride-tag { display: block; width: max-content; margin-top: 6px; font-size: 0.7rem; font-weight: 800; padding: 3px 9px; border-radius: 999px; white-space: nowrap; color: #0b0e13; background: linear-gradient(90deg, var(--bar) 0%, var(--acc) 100%); }
      .ride-tag .wheel { display: inline-block; animation: ride-roll 2.4s ease-in-out infinite; }
      @keyframes ride-roll { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(3px); } }
      .ride { margin-top: 14px; background: var(--card); border-radius: 14px; padding: 14px 16px; border-left: 3px solid var(--acc); }
      .ride-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
      .ride-head b { display: block; font-size: 1rem; }
      .ride-head span { display: block; color: var(--muted); font-size: 0.78rem; margin-top: 2px; }
      .bike { width: 58px; height: 36px; flex: none; overflow: visible; color: var(--text); }
      .bike circle, .bike line, .bike polyline { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      .bike .whl line { stroke-width: 1; opacity: 0.55; }
      .bike .frame { stroke: var(--acc); }
      /* walker: arms and legs swing in opposition under a little moon */
      .walker .moon { fill: var(--acc); stroke: none; opacity: 0.85; }
      .walker .head { fill: currentColor; stroke: none; }
      .walker .ground { stroke: var(--acc); stroke-width: 1.5; opacity: 0.6; }
      .walker .leg { animation: walk-swing 1.1s ease-in-out infinite; }
      .walker .arm { animation: walk-swing 1.1s ease-in-out infinite reverse; }
      .walker .leg.back { animation-direction: reverse; }
      .walker .arm.back { animation-direction: normal; }
      .walker .back { opacity: 0.5; }
      .walker .stroll { animation: walk-bob 0.55s ease-in-out infinite; }
      @keyframes walk-swing { 0%, 100% { transform: rotate(-24deg); } 50% { transform: rotate(24deg); } }
      @keyframes walk-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1.2px); } }
      .bike .whl { animation: ride-spin 0.9s linear infinite; }
      .bike .crank { animation: ride-spin 1.4s linear infinite; }
      @keyframes ride-spin { to { transform: rotate(360deg); } }
      .ride-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-bottom: 12px; }
      .ride-stats div { display: flex; flex-direction: column; min-width: 0; }
      .ride-stats b { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
      .ride-stats span { color: var(--muted); font-size: 0.72rem; }
      @media (max-width: 559px) { .ride-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 10px; } }
      .ride-zones { margin-bottom: 10px; }
      .ride-zones .hz-bar { margin: 0 0 6px; height: 10px; }
      .ride-zones .dt-label b { color: var(--text); }
      .ride .dt-splits { padding: 0; }
      .split.fast-leg { color: #0b0e13; background: var(--acc); }
      .combo { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); }
      .combo-label { color: var(--muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
      .combo-bar { display: flex; gap: 3px; margin: 8px 0; }
      .combo-bar i { flex-basis: 0; min-width: 0; font-style: normal; font-size: 0.75rem; font-weight: 800; color: #0b0e13; padding: 4px 8px; border-radius: 999px; white-space: nowrap; overflow: hidden; }
      .leg-run { background: var(--bar); }
      .leg-ride { background: var(--acc); }
      .combo-nums { font-size: 0.85rem; color: var(--muted); }
      .combo-nums b { color: var(--text); }
      @media (prefers-reduced-motion: reduce) { .bike *, .ride-tag .wheel { animation: none !important; } }

      /* weight: tabs for the weigh-in table and the evolution chart */
      .tabbar { display: inline-flex; gap: 4px; padding: 4px; background: var(--card); border-radius: 999px; margin-bottom: 12px; }
      .tabbar button { font: inherit; font-size: 0.85rem; font-weight: 700; color: var(--muted); background: none; border: 0; border-radius: 999px; padding: 7px 14px; cursor: pointer; transition: background 0.2s, color 0.2s; }
      .tabbar button[aria-selected='true'] { background: var(--bar); color: #0b0e13; }
      .tabbar button:focus-visible { outline: 2px solid var(--bar); outline-offset: 2px; }
      /* both tabs take the chart's height: the chart stays in the flow (just invisible when not selected),
         the weigh-in summary is laid over it and scrolls inside if it ever runs longer */
      .wpanels { position: relative; }
      #panel-evolution[hidden] { display: block; visibility: hidden; }
      #panel-weighins[hidden] { display: none; }
      .wsum { position: absolute; inset: 0; display: flex; flex-direction: column; background: var(--card); border-radius: 16px; padding: 16px; overflow: hidden; }
      @media (max-width: 559px) {
        .wsum { padding: 12px; }
        .wsum .evo-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
        .wsum .evo-stats div { flex-direction: column; padding: 8px 10px; }
        .wsum .evo-stats span { flex-basis: auto; font-size: 0.65rem; }
        .wsum .evo-stats b { font-size: 1rem; }
        .wsum .evo-stats em { font-size: 0.7rem; }
        .wgroups li { gap: 10px; }
      }
      .wsum-head { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; margin: 6px 2px 8px; }
      .wgroups { list-style: none; flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; display: flex; flex-direction: column; gap: 6px; }
      .wgroups li { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(60px, 1fr) auto; align-items: center; gap: 14px; background: var(--card-2); border-radius: 12px; padding: 10px 12px; }
      .wgroups li:first-child { box-shadow: inset 3px 0 0 var(--green); }
      .wg-when { min-width: 0; }
      .wg-when b { display: block; font-size: 0.92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .wg-when span { display: block; color: var(--muted); font-size: 0.75rem; margin-top: 2px; }
      .wg-track { position: relative; height: 4px; border-radius: 999px; background: var(--track); }
      .wg-track i { position: absolute; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--card-2); }
      .wg-lb { text-align: right; min-width: 64px; }
      .wg-lb b { font-size: 1.1rem; white-space: nowrap; }
      .wg-lb small { font-size: 0.6em; margin-left: 2px; color: var(--muted); }
      .wg-lb .delta { margin-top: 0; }
      .evo-stats b.good { color: var(--green); }
      .evo-stats b.bad { color: var(--red); }
      .evo { background: var(--card); border-radius: 16px; padding: 16px; }
      .evo-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }
      .evo-stats div { display: flex; flex-direction: column; gap: 2px; min-width: 0; background: var(--card-2); border-radius: 12px; padding: 10px 12px; }
      .evo-stats span { color: var(--muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
      .evo-stats b { font-size: 1.25rem; letter-spacing: -0.02em; white-space: nowrap; }
      .evo-stats small { font-size: 0.6em; margin-left: 3px; color: var(--muted); }
      .evo-stats em { font-style: normal; font-size: 0.78rem; color: var(--muted); }
      .evo-stats em.good { color: var(--green); }
      .evo-stats em.bad { color: var(--red); }
      @media (max-width: 559px) { .evo { padding: 12px; } .evo-stats { grid-template-columns: 1fr; } .evo-stats div { flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; } .evo-stats span { flex-basis: 100%; } }
      .evo-chart svg { width: 100%; height: auto; display: block; touch-action: pan-y; }
      .evo-title { fill: var(--text); font-size: 15px; font-weight: 700; }
      .evo-axis { fill: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
      @media (max-width: 559px) { .evo-title { font-size: 19px; } .evo-axis { font-size: 16px; } }
      .evo-title.end, .evo-axis.end { text-anchor: end; }
      .evo-axis.mid { text-anchor: middle; }
      .evo-grid { stroke: var(--line); stroke-width: 1; }
      .evo-stripe { fill: var(--text); opacity: 0.025; }
      .evo-wline { fill: none; stroke: var(--green); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
      .evo-warea { opacity: 0; }
      .evo-wdot { fill: var(--card); stroke: var(--green); stroke-width: 2.5; opacity: 0; }
      .evo-wdot.low { fill: var(--green); }
      .evo-wdot.last { fill: var(--green); stroke: var(--card); stroke-width: 3; }
      .evo-wlabel { fill: var(--text); font-size: 15px; font-weight: 800; text-anchor: middle; opacity: 0; }
      .evo-run { fill: var(--bar); }
      .evo-act.kind-walk { fill: #ffb340; }
      .evo-act.kind-bike { fill: #5ac8fa; }
      .evo-rest { fill: var(--muted); opacity: 0.6; }
      .evo-day { transform-box: fill-box; transform-origin: bottom; transform: scaleY(0); }
      .evo-cum { fill: none; stroke: url(#evo-cum); stroke-width: 2; stroke-dasharray: 5 4; opacity: 0; }
      .evo-cumdot { fill: var(--text); opacity: 0; }
      .evo-flag { font-size: 16px; text-anchor: middle; opacity: 0; }
      .evo-cursor { stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 3 3; opacity: 0.7; pointer-events: none; }
      .evo-day.on rect { filter: brightness(1.25); }
      /* draw-in when the tab opens */
      .evo.play .evo-wline { animation: evo-draw 1.4s ease-out forwards; }
      .evo.play .evo-warea { animation: evo-fade 0.8s 0.9s ease forwards; }
      .evo.play .evo-wdot, .evo.play .evo-wlabel { animation: evo-fade 0.4s 1.2s ease forwards; }
      .evo.play .evo-day { animation: evo-grow 0.5s calc(var(--i) * 25ms) cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards; }
      .evo.play .evo-cum, .evo.play .evo-cumdot, .evo.play .evo-flag { animation: evo-fade 0.6s 1s ease forwards; }
      @keyframes evo-draw { to { stroke-dashoffset: 0; } }
      @keyframes evo-fade { to { opacity: 1; } }
      @keyframes evo-grow { to { transform: scaleY(1); } }
      @media (prefers-reduced-motion: reduce) {
        .evo-wline { stroke-dasharray: none; stroke-dashoffset: 0; }
        .evo-warea, .evo-wdot, .evo-wlabel, .evo-cum, .evo-cumdot, .evo-flag { opacity: 1; }
        .evo-cum { opacity: 1; }
        .evo-day { transform: none; }
        .evo.play * { animation: none !important; }
      }
      .evo-readout { min-height: 2.6em; margin-top: 8px; padding: 8px 12px; border-radius: 10px; background: var(--card-2); font-size: 0.85rem; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
      .evo-readout.live { color: var(--text); }
      .evo-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 10px; font-size: 0.75rem; color: var(--muted); }
      .evo-legend span { display: inline-flex; align-items: center; gap: 6px; }
      .sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
      .sw.run { background: var(--bar); } .sw.walk { background: #ffb340; } .sw.bike { background: #5ac8fa; }
      .sw.rest { background: var(--muted); border-radius: 50%; width: 7px; height: 7px; opacity: 0.6; }
      .sw.line { height: 3px; width: 16px; border-radius: 2px; background: var(--green); }
      .sw.cum { height: 0; width: 16px; border-radius: 0; border-top: 2px dashed var(--text); }

      footer { color: var(--muted); font-size: 0.8rem; margin-top: 30px; text-align: center; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="runner" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <ellipse class="shadow" cx="30" cy="62" rx="12" ry="1.8" />
            <g class="body">
              <g class="back arm"><polyline points="33,24 33,31.5 39.5,28.5" /></g>
              <g class="back"><g class="thigh"><line x1="28" y1="38" x2="28" y2="49" /><g class="shin"><line x1="28" y1="49" x2="28" y2="59" /></g></g></g>
              <line x1="28" y1="38" x2="34" y2="22" />
              <circle cx="37.5" cy="14" r="6" />
              <g class="front"><g class="thigh"><line x1="28" y1="38" x2="28" y2="49" /><g class="shin"><line x1="28" y1="49" x2="28" y2="59" /></g></g></g>
              <g class="arm"><polyline points="33,24 33,31.5 39.5,28.5" /></g>
            </g>
          </svg>
        </div>
        <div class="titles">
          <h1>Day by Day Challenge</h1>
          <p>Running non stop · one run every day, no finish line</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode"></button>
      </header>

      <section class="challenge" aria-label="Challenge progress" data-start={startDate}>
        <div class="body">
          <div class="top">
            <div class="count"><small class="pre">Day</small><span id="day-now">{dayNow}</span></div>
            <div class="achieved" id="achieved" hidden={dayNow < GOAL_DAY}>🏆 Challenge {GOAL_DAY} achieved</div>
            <div class="range">Day 0 was <b>{fmtDate(startDate, { month: 'short', day: 'numeric', year: 'numeric' })}</b> · {count} {count === 1 ? 'run' : 'runs'} logged</div>
          </div>
          <div class="rings">
            {rings.map((r) => (
              <div class="ring" data-ring={r.key}>
                <svg viewBox="0 0 40 40" aria-hidden="true">
                  <circle class="ring-bg" cx="20" cy="20" r="17" pathLength="100" />
                  <circle class="ring-fg" cx="20" cy="20" r="17" pathLength="100" style={`stroke-dashoffset:${100 - r.pct * 100}`} />
                </svg>
                <div class="ring-num"><b data-v>{r.value}</b><span data-l>{r.label}</span></div>
                <div class="ring-sub" data-s>{r.sub}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="yeargrid" aria-label={`Year ${prog.years + 1}, one square per day`}>
        <div class="yg-head">
          <h2>Year {prog.years + 1}</h2>
          <span class="yg-sum">{yearRuns} {yearRuns === 1 ? 'run' : 'runs'} in year {prog.years + 1}</span>
        </div>
        <div class="yg">
          {halves.map((h) => (
            <div class="yg-half" style={`--weeks:${h.weeks}`}>
              <div class="yg-months" aria-hidden="true"><span></span>{h.labels.map((l) => <span>{l}</span>)}</div>
              <div class="yg-cells">
                <span class="wd"></span><span class="wd">Mon</span><span class="wd"></span><span class="wd">Wed</span><span class="wd"></span><span class="wd">Fri</span><span class="wd"></span>
                {h.cells.map((date) =>
                  date ? (
                    <i class:list={['cell', `l${level(date)}`, { future: date > buildToday, today: date === buildToday, bday: isBirthday(date), recovery: !isBirthday(date) && isRestDay(date) }]} data-date={date} title={cellTitle(date)}></i>
                  ) : (
                    <i class="cell pad"></i>
                  ),
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="yg-foot">
          <span>Shaded by distance run, under 3 mi to 7+ mi</span>
          <span class="legend">Less <i class="cell l0"></i><i class="cell l1"></i><i class="cell l2"></i><i class="cell l3"></i><i class="cell l4"></i> More</span>
        </div>
      </section>

      <section aria-label="Totals" class="summary">
        <div class="tile">
          <div class="label">Runs</div>
          <div class="value">{count}</div>
          <div class="sub">{fmtDuration(totalSec)} total</div>
        </div>
        <div class="tile">
          <div class="label">Distance</div>
          <div class="value blue">{totalMi.toFixed(1)}<small>MI</small></div>
          <div class="sub">{measured ? (totalMi / measured).toFixed(2) : '–'} mi per run</div>
        </div>
        <div class="tile">
          <div class="label">Avg. pace</div>
          <div class="value cyan">{totalMi > 0 ? fmtPace(avgPaceSec) : '–'}<small>/MI</small></div>
          <div class="sub">across all runs</div>
        </div>
        {cross.count > 0 && (
          <div class="tile">
            <div class="label">Cross-training</div>
            <div class="value sky">{cross.totalMi.toFixed(1)}<small>MI</small></div>
            <div class="sub">{[cross.bike.count > 0 && `🚴 ${cross.bike.totalMi.toFixed(1)}`, cross.walk.count > 0 && `🚶 ${cross.walk.totalMi.toFixed(1)}`].filter(Boolean).join(' · ')} mi</div>
          </div>
        )}
        <div class="tile">
          <div class="label">Weight</div>
          <div class="value purple">{latestWeight ? latestWeight.lb.toFixed(1) : '–'}<small>LB</small></div>
          <div class="sub">
            {latestWeight
              ? weightChange != null
                ? `${signed(weightChange, 'lb')} since ${fmtDate(firstWeight!.date, { month: 'short', day: 'numeric' })}`
                : `logged ${fmtDate(latestWeight.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
        <div class="tile">
          <div class="label">Push-ups</div>
          <div class="value green">{totalPushups}</div>
          <div class="sub">
            {latestPushups
              ? `${latestPushups.count} on ${fmtDate(latestPushups.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
      </section>

      <h2>Day by day</h2>
      <div class="table-wrap">
        {days.length === 0 && <p class="empty">Nothing logged yet.</p>}
        {days.length > 0 && (
          <table class="daylog" id="daylog" data-last-day={lastDay}>
            <thead>
              <tr>
                <th>Day</th><th>Distance</th><th>Time</th><th>Pace</th><th>Heart rate</th><th>Weight</th><th>Push-ups</th><th>Sleep</th>
              </tr>
            </thead>
            <tbody>
              {[...days].reverse().map((d) => {
                const i = d.day // index in the oldest → newest array
                const r = d.run
                // compare against the most recent run before this day, skipping rest days
                const p = days.slice(0, i).reverse().find((x) => x.run)?.run
                const w = d.weight
                const pu = d.pushups
                const runCells: [string, string, string, Delta][] = r
                  ? [
                      ['Distance', r.distanceMi != null ? `${r.distanceMi.toFixed(2)} mi` : '–', 'blue', delta(r.distanceMi, p?.distanceMi, (n) => `${n.toFixed(2)} mi`)],
                      ['Time', r.workoutTime ?? '–', 'yellow', delta(r.workoutTime ? toSec(r.workoutTime) : undefined, p?.workoutTime ? toSec(p.workoutTime) : undefined, fmtDuration)],
                      ['Pace', r.avgPace ? `${fmtPace(toSec(r.avgPace))}/mi` : '–', 'cyan', delta(r.avgPace ? toSec(r.avgPace) : undefined, p?.avgPace ? toSec(p.avgPace) : undefined, fmtDuration, true)],
                      ['Heart rate', r.avgHrBpm ? `${r.avgHrBpm} bpm` : '–', 'orange', delta(r.avgHrBpm, p?.avgHrBpm, (n) => `${n} bpm`, true)],
                    ]
                  : d.activity
                    ? // no run that day: the walk or ride fills the same columns (no deltas, runs aren't compared with walks)
                      [
                        ['Distance', `${d.activity.distanceMi.toFixed(2)} mi`, 'blue', null],
                        ['Time', d.activity.workoutTime, 'yellow', null],
                        d.activity.avgPace
                          ? ['Pace', `${fmtPace(toSec(d.activity.avgPace))}/mi`, 'cyan', null]
                          : ['Speed', d.activity.avgMph != null ? `${d.activity.avgMph} mph` : '–', 'cyan', null],
                        ['Heart rate', d.activity.avgHrBpm ? `${d.activity.avgHrBpm} bpm` : '–', 'orange', null],
                      ]
                    : []
                const { sec: zoneSec, total: zoneTotal, pct: zonePct } = zoneBreakdown(r?.hrZones)
                const act = d.activity
                const k = act ? KIND[act.kind] : null
                // whatever fills the row's distance/time/pace/heart-rate columns: the run, else the walk or ride
                const main = r ?? act
                const rowZ = zoneBreakdown(main?.hrZones)
                const bodyCells: [string, string, string, Delta][] = [
                  ['Weight', w != null ? `${w.toFixed(1)} lb` : '–', 'purple', delta(w, prevWeightBefore(d.date), (n) => `${n.toFixed(1)} lb`, true)],
                  ['Push-ups', pu != null ? String(pu) : '–', 'green', delta(pu, prevPushupsBefore(d.date), (n) => String(n))],
                  ['Sleep', d.sleep != null ? `${d.sleep} h` : '–', 'blue', delta(d.sleep, prevSleepBefore(d.date), (n) => `${+n.toFixed(2)} h`)],
                ]
                const hasDetails = !!r || !!act
                // details panel: zones first, then three key numbers and the splits
                const sec = r?.workoutTime ? toSec(r.workoutTime) : 0
                const mi = r?.distanceMi
                const aerobic = zonePct[1] + zonePct[2]
                const keyStats: [string, string | undefined][] = r
                  ? [
                      ['beats / mile', r.avgHrBpm && mi && sec ? String(Math.round((r.avgHrBpm * sec) / 60 / mi)) : undefined],
                      ['steps / min', r.avgCadenceSpm != null ? String(r.avgCadenceSpm) : undefined],
                      ['ft climbed', r.elevationFt != null ? String(r.elevationFt) : undefined],
                    ]
                  : []
                // cross-training panel: zones, the ride's or walk's numbers, and what run + it add up to that day
                const rz = zoneBreakdown(act?.hrZones)
                const actSec = act ? toSec(act.workoutTime) : 0
                // ride splits are compared by mph (higher is better), walk splits by time per mile (lower is better)
                const legScore = (sp: { time: string; mph?: number }) => (act?.kind === 'bike' ? sp.mph ?? 0 : -toSec(sp.time))
                const bestLeg = act?.splits?.length ? Math.max(...act.splits.map(legScore)) : 0
                const combo =
                  act && r?.distanceMi != null && sec
                    ? { mi: r.distanceMi + act.distanceMi, sec: sec + actSec, cal: (r.totalCal ?? 0) + (act.totalCal ?? 0), ft: (r.elevationFt ?? 0) + (act.elevationFt ?? 0) }
                    : null
                const splitSec = r?.splits?.map((sp) => toSec(sp.time)) ?? []
                const fastest = Math.min(...splitSec)
                const slowest = Math.max(...splitSec)
                return (
                  <>
                  <tr
                    class:list={[{ rest: !r && !act, expandable: hasDetails }]}
                    data-details={hasDetails ? d.date : undefined}
                    tabindex={hasDetails ? 0 : undefined}
                    aria-expanded={hasDetails ? 'false' : undefined}
                    aria-controls={hasDetails ? `details-${d.date}` : undefined}
                  >
                    <td class="daycell">Day {d.day}<span class="datesub">{fmtDate(d.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span>{isBirthday(d.date) && <span class="bday-tag" title="Happy birthday!"><span class="cake" aria-hidden="true">🎂</span> {d.run ? 'Birthday run' : 'Birthday'} <span aria-hidden="true">🎉🎈🥳</span></span>}{act && k && <span class:list={['ride-tag', `kind-${act.kind}`]} title={`${r ? `Run + ${k.noun}` : k.title} · ${act.distanceMi.toFixed(2)} mi`}><span class="wheel" aria-hidden="true">{k.emoji}</span> {r ? `Double day · +${act.distanceMi.toFixed(2)} mi` : k.day}</span>}{d.day === GOAL_DAY && <span class="goal-tag">🏆 Challenge {GOAL_DAY} achieved</span>}{hasDetails && <span class="more">details<i class="chev" aria-hidden="true">▾</i></span>}</td>
                    {main ? (
                      runCells.map(([label, v, c, dl], ci) => (
                        <td data-label={label}>
                          <span class={`v ${c}`}>{v}</span>
                          {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                          {ci === 3 && rowZ.total > 0 && (
                            <span class="zones" aria-label="Time in heart rate zones">
                              {rowZ.sec.map((s, zi) => (
                                <i class={`z${zi + 1}`} style={`flex-grow:${s}`} title={`Zone ${zi + 1} · ${main.hrZones![zi]} · ${(main.hrZoneRanges ?? HR_ZONES)[zi]} bpm`}></i>
                              ))}
                            </span>
                          )}
                          {ci === 3 && main.recoveryHr && <span class="rec" title="Post-workout heart rate: end → 1 min → 2 min">↓ {main.recoveryHr.end} · {main.recoveryHr.min1} · {main.recoveryHr.min2}</span>}
                        </td>
                      ))
                    ) : (
                      <td colspan="4"><span class="rest-label">{d.rest ? <><span class="rest-emoji" aria-hidden="true">🧘</span>Recovery day</> : 'No run'}</span></td>
                    )}
                    {bodyCells.map(([label, v, c, dl]) => (
                      <td data-label={label}>
                        <span class={`v ${c}`}>{v}</span>
                        {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                      </td>
                    ))}
                  </tr>
                  {hasDetails && (
                    <tr class="details" id={`details-${d.date}`} hidden>
                      <td colspan="8">
                        {r && (
                          <p class="dt-meta">
                            {[r.time, r.location, r.tempF != null && `${r.tempF}°F`, r.humidityPct != null && `${r.humidityPct}% humidity`, r.effort != null && `effort ${r.effort} · ${effortLabel(r.effort).toLowerCase()}`].filter(Boolean).join(' · ')}
                          </p>
                        )}
                        {r && zoneTotal > 0 && (
                          <div class="hz">
                            <div class="hz-top">
                              <span><b>{aerobic}%</b> aerobic · zones 2–3</span>
                              <span class="hz-avg">avg {r.avgHrBpm} bpm</span>
                            </div>
                            <div class="hz-bar" aria-hidden="true">
                              {zoneSec.map((z, zi) => z > 0 && <i class={`z${zi + 1}`} style={`flex-grow:${z}`}></i>)}
                            </div>
                            <div class="hz-legend">
                              {zoneSec.map((_, zi) => (
                                <div class:list={['hz-item', { off: zoneSec[zi] === 0 }]} title={`${(r.hrZoneRanges ?? HR_ZONES)[zi]} bpm`}>
                                  <span class="hz-name"><i class={`z${zi + 1}`}></i>Z{zi + 1}</span>
                                  <b>{r.hrZones![zi]}</b>
                                  <span class="hz-pct">{zonePct[zi]}%</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}
                        {r && keyStats.some(([, v]) => v) && (
                          <div class="dt-keys">
                            {keyStats.filter(([, v]) => v).map(([label, v]) => (
                              <div><b>{v}</b><span>{label}</span></div>
                            ))}
                          </div>
                        )}
                        {splitSec.length > 0 && (
                          <div class="dt-splits">
                            <span class="dt-label">Mile splits</span>
                            {splitSec.map((sp) => (
                              <span class:list={['split', { fast: sp === fastest && fastest !== slowest, slow: sp === slowest && fastest !== slowest }]}>{fmtPace(sp)}</span>
                            ))}
                          </div>
                        )}
                        {act && k && (
                          <div class:list={['ride', `kind-${act.kind}`]}>
                            <div class="ride-head">
                              {act.kind === 'bike' ? (
                                <svg class="bike" viewBox="0 0 64 40" aria-hidden="true">
                                  <g class="whl" style="transform-origin:14px 28px"><circle cx="14" cy="28" r="10" /><line x1="14" y1="18" x2="14" y2="38" /><line x1="4" y1="28" x2="24" y2="28" /></g>
                                  <g class="whl" style="transform-origin:50px 28px"><circle cx="50" cy="28" r="10" /><line x1="50" y1="18" x2="50" y2="38" /><line x1="40" y1="28" x2="60" y2="28" /></g>
                                  <polyline class="frame" points="14,28 26,14 44,14 50,28 32,28 26,14" />
                                  <line class="frame" x1="32" y1="28" x2="44" y2="14" />
                                  <line class="frame" x1="23" y1="10" x2="29" y2="10" /><line class="frame" x1="26" y1="10" x2="26" y2="14" />
                                  <line class="frame" x1="44" y1="14" x2="42" y2="7" /><line class="frame" x1="42" y1="7" x2="47" y2="7" />
                                  <g class="crank" style="transform-origin:32px 28px"><line x1="27" y1="28" x2="37" y2="28" /></g>
                                </svg>
                              ) : (
                                <svg class="bike walker" viewBox="0 0 64 40" aria-hidden="true">
                                  <circle class="moon" cx="52" cy="8" r="5" />
                                  <g class="stroll">
                                    <circle class="head" cx="28" cy="6" r="4" />
                                    <line x1="28" y1="11" x2="28" y2="24" />
                                    <g class="arm" style="transform-origin:28px 13px"><line x1="28" y1="13" x2="28" y2="22" /></g>
                                    <g class="arm back" style="transform-origin:28px 13px"><line x1="28" y1="13" x2="28" y2="22" /></g>
                                    <g class="leg" style="transform-origin:28px 24px"><line x1="28" y1="24" x2="28" y2="37" /></g>
                                    <g class="leg back" style="transform-origin:28px 24px"><line x1="28" y1="24" x2="28" y2="37" /></g>
                                  </g>
                                  <line class="ground" x1="6" y1="38" x2="58" y2="38" />
                                </svg>
                              )}
                              <div>
                                <b>{act.title ?? (r ? k.afterRun : k.title)}</b>
                                <span>{[act.time, act.route, act.tempF != null && `${act.tempF}°F`, act.humidityPct != null && `${act.humidityPct}% humidity`, act.effort != null && `effort ${act.effort} · ${effortLabel(act.effort).toLowerCase()}`].filter(Boolean).join(' · ')}</span>
                              </div>
                            </div>
                            <div class="ride-stats">
                              <div><b>{act.distanceMi.toFixed(2)}</b><span>mi</span></div>
                              <div><b>{act.workoutTime}</b><span>{k.verb}</span></div>
                              {act.avgMph != null && <div><b>{act.avgMph}</b><span>mph avg</span></div>}
                              {act.avgPace != null && <div><b>{fmtPace(toSec(act.avgPace))}</b><span>per mile</span></div>}
                              {act.avgHrBpm != null && <div><b>{act.avgHrBpm}</b><span>bpm avg</span></div>}
                              {act.elevationFt != null && <div><b>{act.elevationFt}</b><span>ft climbed</span></div>}
                              {act.totalCal != null && <div><b>{act.totalCal}</b><span>cal</span></div>}
                            </div>
                            {rz.total > 0 && (
                              <div class="ride-zones">
                                <div class="hz-bar" aria-label={`Time in heart rate zones on the ${k.noun}`}>
                                  {rz.sec.map((z, zi) => z > 0 && <i class={`z${zi + 1}`} style={`flex-grow:${z}`} title={`Zone ${zi + 1} · ${act.hrZones![zi]} · ${(act.hrZoneRanges ?? HR_ZONES)[zi]} bpm`}></i>)}
                                </div>
                                <span class="dt-label"><b>{rz.pct[0] + rz.pct[1]}%</b> in zones 1–2, {k.easy}{act.recoveryHr && ` · ${act.recoveryHr.min1} bpm a minute after`}</span>
                              </div>
                            )}
                            {act.splits && act.splits.length > 0 && (
                              <div class="dt-splits">
                                <span class="dt-label">{k.splits}</span>
                                {act.splits.map((sp) => (
                                  <span class:list={['split', { 'fast-leg': legScore(sp) === bestLeg }]} title={`${sp.time}${sp.mi ? ` for ${sp.mi} mi` : ''}${sp.hr ? ` · ${sp.hr} bpm` : ''}`}>{act.kind === 'bike' ? `${sp.mph} mph` : fmtPace(toSec(sp.time))}</span>
                                ))}
                              </div>
                            )}
                            {combo && (
                              <div class="combo">
                                <span class="combo-label">Day total, run + {k.noun}</span>
                                <div class="combo-bar" aria-hidden="true">
                                  <i class="leg-run" style={`flex-grow:${r!.distanceMi}`}>🏃 {r!.distanceMi!.toFixed(2)}</i>
                                  <i class="leg-ride" style={`flex-grow:${act.distanceMi}`}>{k.emoji} {act.distanceMi.toFixed(2)}</i>
                                </div>
                                <div class="combo-nums"><b>{combo.mi.toFixed(2)} mi</b> moved · <b>{fmtDuration(combo.sec)}</b> active · <b>{combo.cal.toLocaleString('en-US')}</b> cal · <b>{combo.ft}</b> ft up</div>
                              </div>
                            )}
                          </div>
                        )}
                      </td>
                    </tr>
                  )}
                  </>
                )
              })}
            </tbody>
          </table>
        )}
      </div>

      {weightLog.length > 1 && (
        <section class="wtabs" aria-label="Weight">
          <h2>Weight</h2>
          <div class="tabbar" role="tablist" aria-label="Weight views">
            <button role="tab" id="tab-weighins" aria-controls="panel-weighins" aria-selected="true">⚖️ Weigh-ins</button>
            <button role="tab" id="tab-evolution" aria-controls="panel-evolution" aria-selected="false" tabindex="-1">📈 Evolution</button>
          </div>
          <div class="wpanels">
          <div class="wsum" role="tabpanel" id="panel-weighins" aria-labelledby="tab-weighins">
            <div class="evo-stats">
              <div><span>Now</span><b>{latestWeight!.lb.toFixed(1)}<small>lb</small></b><em>{fmtDate(latestWeight!.date, { month: 'short', day: 'numeric' })}</em></div>
              <div><span>Since Day 0</span><b class:list={[weightChange == null ? '' : weightChange <= 0 ? 'good' : 'bad']}>{weightChange == null ? '=' : signed(weightChange, '').trim()}<small>lb</small></b><em>from {firstWeight!.lb.toFixed(1)} lb</em></div>
              <div><span>Range</span><b>{wMin.toFixed(1)}–{wMax.toFixed(1)}<small>lb</small></b><em>{weightLog.length} weigh-ins</em></div>
            </div>
            <div class="wsum-head"><span>Stretches at the same weight</span><span>newest first</span></div>
            <ol class="wgroups">
              {[...wGroups].reverse().map((g) => (
                <li>
                  <div class="wg-when">
                    <b>{g.from === g.to ? fmtDate(g.from, { weekday: 'short', month: 'short', day: 'numeric' }) : `${fmtDate(g.from, { month: 'short', day: 'numeric' })} – ${fmtDate(g.to, { month: 'short', day: 'numeric' })}`}</b>
                    <span>Day {dayNumber(g.from)}{g.from !== g.to ? `–${dayNumber(g.to)}` : ''} · {g.n} {g.n === 1 ? 'weigh-in' : 'weigh-ins'}</span>
                  </div>
                  <div class="wg-track" aria-hidden="true"><i style={`left:${wMax > wMin ? ((g.lb - wMin) / (wMax - wMin)) * 100 : 50}%`}></i></div>
                  <div class="wg-lb">
                    <b>{g.lb.toFixed(1)}<small>lb</small></b>
                    {g.d && <span class={`delta ${g.d.dir}`}>{g.d.text}</span>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="evo" role="tabpanel" id="panel-evolution" aria-labelledby="tab-evolution" hidden>
            <div class="evo-stats">
              <div><span>Weight</span><b>{firstWeight!.lb.toFixed(1)} → {latestWeight!.lb.toFixed(1)}<small>lb</small></b><em class:list={[weightChange == null ? '' : weightChange <= 0 ? 'good' : 'bad']}>{weightChange == null ? 'steady' : signed(weightChange, 'lb')}</em></div>
              <div><span>Run miles since Day 0</span><b>{evRunning.toFixed(1)}<small>mi</small></b><em>{count} runs · {fmtDuration(totalSec)}</em></div>
              <div><span>Lowest weigh-in</span><b>{evLowest.lb.toFixed(1)}<small>lb</small></b><em>Day {dayNumber(evLowest.date)} · {fmtDate(evLowest.date, { month: 'short', day: 'numeric' })}</em></div>
            </div>
            <div class="evo-chart">
              <svg viewBox={`0 0 ${EV.w} ${EV.h}`} role="img" aria-label={`Weight from ${firstWeight!.lb.toFixed(1)} to ${latestWeight!.lb.toFixed(1)} lb while running ${evRunning.toFixed(1)} miles over ${evDays.length} days`} id="evo-svg">
                <defs>
                  <linearGradient id="evo-wfill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--green)" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="var(--green)" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="evo-cum" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="var(--muted)" />
                    <stop offset="100%" stop-color="var(--text)" />
                  </linearGradient>
                </defs>
                {/* panel titles */}
                <text class="evo-title" x={EV.l} y={EV.wTop - 12}>⚖️ Weight (lb)</text>
                <text class="evo-title" x={EV.l} y={EV.mTop - 14}>🏃 Miles each day</text>
                <text class="evo-title end" x={EV.w - EV.r} y={EV.mTop - 14}>running total ⤴</text>
                {/* week stripes so the eye can count weeks */}
                {evDays.filter((d) => d.day % 14 >= 7).map((d) => <rect class="evo-stripe" x={evX(d.day) - evCol / 2} y={EV.wTop} width={evCol + 0.5} height={EV.mBot - EV.wTop} />)}
                {/* weight axis */}
                {evWTicks.map((t) => (
                  <>
                    <line class="evo-grid" x1={EV.l} x2={EV.w - EV.r} y1={evWY(t)} y2={evWY(t)} />
                    <text class="evo-axis end" x={EV.l - 8} y={evWY(t) + 5}>{t.toFixed(1)}</text>
                  </>
                ))}
                <path class="evo-warea" d={evWArea} fill="url(#evo-wfill)" />
                <path class="evo-wline" d={evWPath} pathLength="1" />
                {evWPts.map((p, i) => (
                  <circle class:list={['evo-wdot', { last: i === evWPts.length - 1, low: p.w === evLowest }]} cx={p.x} cy={p.y} r={i === evWPts.length - 1 ? 6 : 4} />
                ))}
                <text class="evo-wlabel" x={evWPts[evWPts.length - 1].x} y={evWPts[evWPts.length - 1].y - 14}>{latestWeight!.lb.toFixed(1)}</text>
                {/* miles axis */}
                {[0, evMMax / 2, evMMax].map((t) => (
                  <>
                    <line class="evo-grid" x1={EV.l} x2={EV.w - EV.r} y1={EV.mBot - evMH(t)} y2={EV.mBot - evMH(t)} />
                    <text class="evo-axis end" x={EV.l - 8} y={EV.mBot - evMH(t) + 5}>{t}</text>
                  </>
                ))}
                <text class="evo-axis" x={EV.w - EV.r + 6} y={EV.mTop + 5}>{Math.round(evCumMax)}</text>
                <text class="evo-axis" x={EV.w - EV.r + 6} y={EV.mBot + 5}>0</text>
                {/* daily bars: run (lime) with walk/ride stacked on top in its own colour; recovery days get a little dot */}
                {evDays.map((d, i) => (
                  <g class="evo-day" style={`--i:${i}`}>
                    {d.runMi > 0 && <rect class="evo-run" x={evX(i) - evBarW / 2} y={EV.mBot - evMH(d.runMi)} width={evBarW} height={evMH(d.runMi)} rx={Math.min(4, evBarW / 3)} />}
                    {d.actMi > 0 && <rect class:list={['evo-act', `kind-${d.activity!.kind}`]} x={evX(i) - evBarW / 2} y={EV.mBot - evMH(d.runMi + d.actMi)} width={evBarW} height={evMH(d.actMi) - (d.runMi > 0 ? 1.5 : 0)} rx={Math.min(4, evBarW / 3)} />}
                    {d.rest && !d.run && !d.activity && <circle class="evo-rest" cx={evX(i)} cy={EV.mBot - 5} r="3.5" />}
                  </g>
                ))}
                <path class="evo-cum" d={evCumPath} />
                <circle class="evo-cumdot" cx={evX(evDays.length - 1)} cy={evCumY(evRunning)} r="4.5" />
                {/* moments worth a flag */}
                {evLongest.runMi > 0 && <text class="evo-flag" x={evX(evLongest.day)} y={EV.mBot - evMH(evLongest.runMi + evLongest.actMi) - 8}>🏆</text>}
                {evDays.filter((d) => isBirthday(d.date)).map((d) => <text class="evo-flag" x={evX(d.day)} y={EV.wBot + 26}>🎂</text>)}
                {/* day axis */}
                {evDays.filter((d) => d.day % evStep === 0).map((d) => (
                  <text class="evo-axis mid" x={evX(d.day)} y={EV.mBot + 24}>D{d.day}</text>
                ))}
                {/* scrubber */}
                <line class="evo-cursor" id="evo-cursor" x1="0" x2="0" y1={EV.wTop} y2={EV.mBot} visibility="hidden" />
                <rect id="evo-hit" x={EV.l} y={EV.wTop - 10} width={EV.w - EV.l - EV.r} height={EV.mBot - EV.wTop + 30} fill="transparent" />
              </svg>
            </div>
            <p class="evo-readout" id="evo-readout" data-info={JSON.stringify(evInfo)} data-l={EV.l} data-col={evCol} data-w={EV.w}>
              Tap or hover the chart to read any day.
            </p>
            <div class="evo-legend">
              <span><i class="sw run"></i>Run</span>
              <span><i class="sw walk"></i>Walk</span>
              <span><i class="sw bike"></i>Ride</span>
              <span><i class="sw rest"></i>Recovery</span>
              <span><i class="sw line"></i>Weight</span>
              <span><i class="sw cum"></i>Run miles, running total</span>
              <span>🏆 longest run</span>
            </div>
          </div>
          </div>
        </section>
      )}

      <footer>Outdoor runs, rides and walks recorded with Apple Watch · <a href="/">rajil.me</a></footer>
    </main>
    <script>
      import { GOAL_DAY, progressOn } from '~/data/runs'

      // Keep the counter, rings and year grid current in the visitor's local time, no rebuild needed.
      const el = document.querySelector<HTMLElement>('.challenge')!
      const [y, m, d] = el.dataset.start!.split('-').map(Number)
      const start = new Date(y, m - 1, d)
      const now = new Date()
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
      const prog = progressOn(today)
      const day = prog.day
      document.getElementById('day-now')!.textContent = String(day)
      document.getElementById('achieved')!.hidden = day < GOAL_DAY
      const plural = (n: number, word: string) => `${n} ${n === 1 ? word : word + 's'}`
      const ringData: Record<string, [number, string, number, string]> = {
        days: [prog.day, prog.day === 1 ? 'day' : 'days', prog.milestonePct, `next stop: Day ${prog.milestone}`],
        months: [prog.months, prog.months === 1 ? 'month' : 'months', prog.monthPct, `${plural(prog.daysToNextMonth, 'day')} to month ${prog.months + 1}`],
        years: [prog.years, prog.years === 1 ? 'year' : 'years', prog.yearPct, `${plural(prog.daysToNextYear, 'day')} to year ${prog.years + 1}`],
      }
      for (const ring of document.querySelectorAll<HTMLElement>('.ring')) {
        const [v, l, pct, sub] = ringData[ring.dataset.ring!]
        ring.querySelector('[data-v]')!.textContent = String(v)
        ring.querySelector('[data-l]')!.textContent = l
        ring.querySelector('[data-s]')!.textContent = sub
        ring.querySelector<SVGElement>('.ring-fg')!.style.strokeDashoffset = String(100 - pct * 100)
      }
      for (const cell of document.querySelectorAll<HTMLElement>('.yg-cells .cell[data-date]')) {
        cell.classList.toggle('future', cell.dataset.date! > today)
        cell.classList.toggle('today', cell.dataset.date === today)
      }

      // Click (or Enter/Space on) a day to drop down its details.
      for (const row of document.querySelectorAll<HTMLElement>('.daylog tr[data-details]')) {
        const panel = document.getElementById(`details-${row.dataset.details}`)!
        const toggle = () => {
          panel.hidden = !panel.hidden
          row.setAttribute('aria-expanded', String(!panel.hidden))
        }
        row.addEventListener('click', toggle)
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            toggle()
          }
        })
      }

      // The day-by-day list is built through the deploy date; add a row for each day
      // that has passed since, newest at the top, so it keeps counting up daily.
      // Finished days without a run are recovery days; today stays "No run".
      const daylog = document.getElementById('daylog')
      const tbody = daylog?.querySelector('tbody')
      if (daylog && tbody) {
        const lastBuilt = Number(daylog.dataset.lastDay)
        for (let n = lastBuilt + 1; n <= day; n++) {
          const date = new Date(start.getFullYear(), start.getMonth(), start.getDate() + n)
          const tr = document.createElement('tr')
          tr.className = 'rest'
          const label = n < day ? '<span class="rest-emoji" aria-hidden="true">🧘</span>Recovery day' : 'No run'
          tr.innerHTML =
            `<td class="daycell">Day ${n}<span class="datesub"></span>${n === GOAL_DAY ? `<span class="goal-tag">🏆 Challenge ${GOAL_DAY} achieved</span>` : ''}</td>` +
            `<td colspan="4"><span class="rest-label">${label}</span></td>` +
            `<td data-label="Weight"><span class="v purple">–</span></td>` +
            `<td data-label="Push-ups"><span class="v green">–</span></td>` +
            `<td data-label="Sleep"><span class="v blue">–</span></td>`
          tr.querySelector('.datesub')!.textContent = date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
          tbody.prepend(tr)
        }
      }

      // Weight tabs: weigh-in table first, evolution chart second (remembered per browser).
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.wtabs [role=tab]')]
      const evo = document.querySelector<HTMLElement>('.evo')
      const selectTab = (tab: HTMLButtonElement, focus = false) => {
        for (const t of tabs) {
          const on = t === tab
          t.setAttribute('aria-selected', String(on))
          t.tabIndex = on ? 0 : -1
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on
        }
        if (focus) tab.focus()
        // replay the draw-in each time the chart opens
        if (evo && tab.id === 'tab-evolution') {
          evo.classList.remove('play')
          void evo.offsetWidth
          evo.classList.add('play')
        }
        try { localStorage.setItem('run-weight-tab', tab.id) } catch {}
      }
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => selectTab(t))
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault()
            selectTab(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true)
          }
        })
      })
      try {
        const saved = tabs.find((t) => t.id === localStorage.getItem('run-weight-tab'))
        if (saved && saved.id !== 'tab-weighins') selectTab(saved)
      } catch {}

      // Evolution chart scrubber: hover or drag across the chart to read any day.
      const svg = document.getElementById('evo-svg') as SVGSVGElement | null
      const readout = document.getElementById('evo-readout')
      if (svg && readout) {
        const info: string[] = JSON.parse(readout.dataset.info!)
        const left = Number(readout.dataset.l), col = Number(readout.dataset.col), vbW = Number(readout.dataset.w)
        const cursor = document.getElementById('evo-cursor')!
        const dayEls = [...svg.querySelectorAll<SVGGElement>('.evo-day')]
        let current = -1
        const show = (e: PointerEvent) => {
          const box = svg.getBoundingClientRect()
          const x = ((e.clientX - box.left) / box.width) * vbW
          const i = Math.max(0, Math.min(info.length - 1, Math.floor((x - left) / col)))
          if (i === current) return
          dayEls[current]?.classList.remove('on')
          current = i
          dayEls[i]?.classList.add('on')
          const cx = String(left + (i + 0.5) * col)
          cursor.setAttribute('x1', cx)
          cursor.setAttribute('x2', cx)
          cursor.setAttribute('visibility', 'visible')
          readout.textContent = info[i]
          readout.classList.add('live')
        }
        svg.addEventListener('pointermove', show)
        svg.addEventListener('pointerdown', show)
      }

      // Black & white switch: toggles between dark (default) and light, remembered per browser.
      const root = document.documentElement
      const toggle = document.getElementById('theme-toggle')!
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!
      const applyTheme = (theme: 'dark' | 'light') => {
        root.dataset.theme = theme
        themeColor.content = theme === 'light' ? '#fff' : '#0b0e13'
        const label = theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
        toggle.setAttribute('aria-label', label)
        toggle.title = label
      }
      applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark')
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light'
        applyTheme(next)
        try { localStorage.setItem('run-theme', next) } catch {}
      })
    </script>
  </body>
</html>
