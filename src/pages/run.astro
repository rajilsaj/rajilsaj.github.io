---
import { CHALLENGE_START, CHALLENGE_DAYS, challengeDays, runTotals, weightsByDate, pushupsByDate, toSec, fmtDuration, fmtPace, fmtDate } from '~/data/runs'

const title = '100 Days Challenge · Running Non Stop'
const description = '100 days of running, every single day. Day-by-day tracker.'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')

const days = challengeDays() // every calendar day since Day 1, oldest → newest
const { count, totalMi, totalSec, avgPaceSec } = runTotals()

const weightLog = weightsByDate()
const latestWeight = weightLog[weightLog.length - 1] ?? null
const firstWeight = weightLog[0] ?? null
const weightChange = latestWeight && firstWeight && latestWeight !== firstWeight ? latestWeight.lb - firstWeight.lb : null

const pushupLog = pushupsByDate()
const totalPushups = pushupLog.reduce((a, p) => a + p.count, 0)
const latestPushups = pushupLog[pushupLog.length - 1] ?? null

// change vs the previous run day
type Delta = { text: string; dir: 'up' | 'down' | 'flat' } | null
const delta = (cur: number | undefined, prev: number | undefined, fmt: (n: number) => string, lowerIsBetter = false): Delta => {
  if (cur == null || prev == null) return null
  const d = cur - prev
  if (Math.abs(d) < 1e-9) return { text: '=', dir: 'flat' }
  const better = lowerIsBetter ? d < 0 : d > 0
  return { text: `${d > 0 ? '+' : '−'}${fmt(Math.abs(d))}`, dir: better ? 'up' : 'down' }
}
const signed = (n: number, unit: string) => `${n > 0 ? '+' : '−'}${Math.abs(n).toFixed(1)} ${unit}`

// challenge counter (server-side fallback; the browser recomputes it live)
const startDate = CHALLENGE_START
const endDate = new Date(startDate + 'T12:00:00')
endDate.setDate(endDate.getDate() + CHALLENGE_DAYS - 1)
const endIso = endDate.toISOString().slice(0, 10)
const today = new Date()
const dayNow = Math.min(CHALLENGE_DAYS, Math.max(1, Math.floor((today.getTime() - new Date(startDate + 'T00:00:00').getTime()) / 86400000) + 1))

// previous logged value before a given date (so deltas work across rest days)
const prevWeightBefore = (date: string) => [...weightLog].reverse().find((w) => w.date < date)?.lb
const prevPushupsBefore = (date: string) => [...pushupLog].reverse().find((p) => p.date < date)?.count
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('run-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <style is:global>
      :root {
        --bg: #000;
        --card: #1c1c1e;
        --card-2: #24242a;
        --line: #3a3a3c;
        --track: #2c2c2e;
        --text: #fff;
        --muted: #8e8e93;
        --yellow: #ffd60a;
        --blue: #0a84ff;
        --red: #ff375f;
        --green: #30d158;
        --cyan: #5ac8fa;
        --orange: #ff6b3d;
        --purple: #bf5af2;
        --bar: #c8f22b;
        --bar-track: rgba(200, 242, 43, 0.18);
        --bar-pill-bg: #111;
        --bar-pill-text: #c8f22b;
        color-scheme: dark;
      }
      :root[data-theme='light'] {
        --bg: #fff;
        --card: #f2f2f7;
        --card-2: #e9e9ee;
        --line: #d1d1d6;
        --track: #dcdce1;
        --text: #000;
        --muted: #6e6e73;
        --yellow: #b07d00;
        --blue: #0066d6;
        --red: #d70040;
        --green: #1f8a3b;
        --cyan: #0077b6;
        --orange: #d94a0b;
        --purple: #8a2be2;
        --bar: #c8f22b;
        --bar-track: #e9f8b0;
        --bar-pill-bg: #111;
        --bar-pill-text: #c8f22b;
        color-scheme: light;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--text); -webkit-text-size-adjust: 100%; }
      body {
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.3;
        min-height: 100vh;
        overflow-x: hidden;
      }
      main { max-width: 760px; margin: 0 auto; padding: 28px 16px 60px; }

      header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
      header .titles { flex: 1; min-width: 0; }

      /* black & white theme switch */
      .theme-toggle {
        flex: none; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; padding: 0;
        border: 2px solid var(--text);
        background: linear-gradient(90deg, #000 0 50%, #fff 50% 100%);
        box-shadow: 0 0 0 2px var(--bg), 0 2px 10px rgba(0, 0, 0, 0.3);
        transition: transform 0.35s ease;
      }
      .theme-toggle:hover { transform: rotate(180deg); }
      .theme-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
      :root[data-theme='light'] .theme-toggle { transform: rotate(180deg); }
      :root[data-theme='light'] .theme-toggle:hover { transform: rotate(360deg); }
      .badge {
        width: 52px; height: 52px; border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #b8ff3a, #5c8a00);
        display: grid; place-items: center; font-size: 26px; flex: none;
        box-shadow: 0 0 24px rgba(184, 255, 58, 0.25);
      }
      h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
      header p { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
      h2 { font-size: 1.2rem; font-weight: 700; margin: 26px 0 10px; }

      .challenge { background: linear-gradient(135deg, var(--card) 0%, var(--card-2) 100%); border-radius: 18px; padding: 20px 20px 18px; margin-bottom: 14px; border: 1px solid var(--track); display: flex; gap: 18px; align-items: center; min-width: 0; max-width: 100%; }
      .challenge .body { flex: 1 1 0; min-width: 0; }
      .mascot { flex: none; width: 118px; height: 138px; border-radius: 14px; overflow: hidden; background: #f3d24a; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
      .mascot img { width: 100%; height: 100%; object-fit: cover; display: block; }
      @media (max-width: 559px) {
        .challenge { padding: 16px; gap: 12px; }
        .mascot { width: 86px; height: 100px; border-radius: 12px; }
        .challenge .count { font-size: 2.1rem; }
        h1 { font-size: 1.5rem; }
        .challenge .range { font-size: 0.8rem; }
      }
      .challenge .top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .challenge .count { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
      .challenge .count small { font-size: 0.45em; font-weight: 600; color: var(--muted); margin-left: 4px; letter-spacing: 0; }
      .challenge .range { color: var(--muted); font-size: 0.85rem; white-space: nowrap; }
      .challenge .range b { color: var(--text); font-weight: 600; }
      /* progress: soft pill on a tinted track, fills in smoothly on load */
      .track { --p: 0%; height: 16px; border-radius: 999px; background: var(--bar-track); margin: 16px 0 10px; overflow: hidden; }
      .fill { height: 100%; width: var(--p); min-width: 16px; border-radius: 999px; background: var(--bar); transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1); animation: grow 1.2s cubic-bezier(0.22, 1, 0.36, 1) both; }
      @keyframes grow { from { width: 16px; } }
      .challenge .caption { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; color: var(--muted); font-size: 0.82rem; }
      .challenge .caption b { color: var(--text); font-weight: 600; }
      .challenge .caption .pct { flex: none; font-weight: 800; font-size: 0.78rem; color: var(--bar-pill-text); background: var(--bar-pill-bg); padding: 4px 10px; border-radius: 999px; line-height: 1; letter-spacing: 0.02em; }
      @media (prefers-reduced-motion: reduce) { .fill { animation: none; transition: none; } }

      /* tiles: 2 per row on phones, 3 on tablets, all 5 in one row on desktop; last row always stretches to fill */
      .summary { display: flex; flex-wrap: wrap; gap: 10px; }
      .tile { flex: 1 1 calc(50% - 10px); min-width: 0; background: var(--card); border-radius: 14px; padding: 14px 14px; container-type: inline-size; }
      @media (min-width: 600px) { .tile { flex-basis: calc(33.333% - 10px); } }
      @media (min-width: 740px) { .tile { flex-basis: 0; } }
      .tile .label { color: var(--muted); font-size: 0.82rem; font-weight: 600; }
      .tile .value { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: clip; }
      .tile .value small { font-size: 0.6em; margin-left: 2px; }
      .tile .sub { color: var(--muted); font-size: 0.8rem; margin-top: 2px; overflow-wrap: anywhere; }
      /* shrink the big number when the tile itself is narrow, whatever the viewport */
      @container (max-width: 150px) { .tile .value { font-size: 1.35rem; } }
      @container (max-width: 120px) { .tile .value { font-size: 1.15rem; } }

      .table-wrap { background: var(--card); border-radius: 16px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
      .table-wrap::-webkit-scrollbar { height: 6px; }
      .table-wrap::-webkit-scrollbar-track { background: transparent; }
      .table-wrap::-webkit-scrollbar-thumb { background: var(--line); border-radius: 999px; }
      table { border-collapse: collapse; width: 100%; min-width: 600px; font-size: 0.95rem; }
      @media (min-width: 740px) { table { min-width: 0; } }
      th, td { text-align: left; padding: 12px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
      tr:last-child td { border-bottom: none; }
      td .v { font-weight: 700; font-size: 1.1rem; }
      .daycell { font-weight: 700; }
      .daycell .datesub { display: block; color: var(--muted); font-weight: 400; font-size: 0.82rem; margin-top: 2px; }
      .datecell { color: var(--muted); }
      tr.rest .daycell, tr.rest .datecell { color: var(--muted); }
      .rest-label { display: inline-block; color: var(--muted); font-size: 0.85rem; font-style: italic; }
      .delta { display: block; font-size: 0.78rem; margin-top: 2px; color: var(--muted); }
      .delta.up { color: var(--green); }
      .delta.down { color: var(--red); }
      .yellow { color: var(--yellow); } .blue { color: var(--blue); } .red { color: var(--red); }
      .green { color: var(--green); } .cyan { color: var(--cyan); } .orange { color: var(--orange); } .purple { color: var(--purple); }
      .empty { color: var(--muted); padding: 20px; text-align: center; }
      .note { color: var(--muted); font-size: 0.85rem; margin-top: 10px; }

      footer { color: var(--muted); font-size: 0.8rem; margin-top: 30px; text-align: center; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="badge">🏃</div>
        <div class="titles">
          <h1>100 Days Challenge</h1>
          <p>Running non stop · one run every day, 100 days in a row</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode"></button>
      </header>

      <section class="challenge" aria-label="Challenge progress" data-start={startDate} data-days={CHALLENGE_DAYS}>
        <div class="body">
        <div class="top">
          <div class="count"><span id="day-now">{dayNow}</span><small>/ {CHALLENGE_DAYS} days</small></div>
          <div class="range"><b>{fmtDate(startDate, { month: 'short', day: 'numeric' })}</b> – <b>{fmtDate(endIso, { month: 'short', day: 'numeric', year: 'numeric' })}</b></div>
        </div>
        <div class="track" id="track" role="progressbar" aria-valuemin="0" aria-valuemax={CHALLENGE_DAYS} aria-valuenow={dayNow} aria-label="Challenge progress" style={`--p:${(dayNow / CHALLENGE_DAYS) * 100}%`}>
          <div class="fill"></div>
        </div>
        <div class="caption">
          <span><b><span id="days-left">{CHALLENGE_DAYS - dayNow}</span> days</b> to go · {count} {count === 1 ? 'run' : 'runs'} logged</span>
          <span class="pct" id="pct">{Math.round((dayNow / CHALLENGE_DAYS) * 100)}%</span>
        </div>
        </div>
        <div class="mascot" aria-hidden="true"><img src="/run/beep-beep.gif" alt="" loading="lazy" /></div>
      </section>

      <section aria-label="Totals" class="summary">
        <div class="tile">
          <div class="label">Runs</div>
          <div class="value">{count}</div>
          <div class="sub">{fmtDuration(totalSec)} total</div>
        </div>
        <div class="tile">
          <div class="label">Distance</div>
          <div class="value blue">{totalMi.toFixed(1)}<small>MI</small></div>
          <div class="sub">{count ? (totalMi / count).toFixed(2) : '–'} mi per run</div>
        </div>
        <div class="tile">
          <div class="label">Avg. pace</div>
          <div class="value cyan">{totalMi > 0 ? fmtPace(avgPaceSec) : '–'}<small>/MI</small></div>
          <div class="sub">across all runs</div>
        </div>
        <div class="tile">
          <div class="label">Weight</div>
          <div class="value purple">{latestWeight ? latestWeight.lb.toFixed(1) : '–'}<small>LB</small></div>
          <div class="sub">
            {latestWeight
              ? weightChange != null
                ? `${signed(weightChange, 'lb')} since ${fmtDate(firstWeight!.date, { month: 'short', day: 'numeric' })}`
                : `logged ${fmtDate(latestWeight.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
        <div class="tile">
          <div class="label">Push-ups</div>
          <div class="value green">{totalPushups}</div>
          <div class="sub">
            {latestPushups
              ? `${latestPushups.count} on ${fmtDate(latestPushups.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
      </section>

      <h2>Day by day</h2>
      <div class="table-wrap">
        {days.length === 0 && <p class="empty">Nothing logged yet.</p>}
        {days.length > 0 && (
          <table>
            <thead>
              <tr>
                <th>Day</th><th>Distance</th><th>Time</th><th>Pace</th><th>Heart rate</th><th>Weight</th><th>Push-ups</th>
              </tr>
            </thead>
            <tbody>
              {days.map((d, i) => {
                const r = d.run
                // compare against the most recent run before this day, skipping rest days
                const p = days.slice(0, i).reverse().find((x) => x.run)?.run
                const w = d.weight
                const pu = d.pushups
                const runCells: [string, string, Delta][] = r
                  ? [
                      [`${r.distanceMi.toFixed(2)} mi`, 'blue', delta(r.distanceMi, p?.distanceMi, (n) => `${n.toFixed(2)} mi`)],
                      [r.workoutTime, 'yellow', delta(toSec(r.workoutTime), p ? toSec(p.workoutTime) : undefined, fmtDuration)],
                      [`${fmtPace(toSec(r.avgPace))}/mi`, 'cyan', delta(toSec(r.avgPace), p ? toSec(p.avgPace) : undefined, fmtDuration, true)],
                      [r.avgHrBpm ? `${r.avgHrBpm} bpm` : '–', 'orange', delta(r.avgHrBpm, p?.avgHrBpm, (n) => `${n} bpm`, true)],
                    ]
                  : []
                const bodyCells: [string, string, Delta][] = [
                  [w != null ? `${w.toFixed(1)} lb` : '–', 'purple', delta(w, prevWeightBefore(d.date), (n) => `${n.toFixed(1)} lb`, true)],
                  [pu != null ? String(pu) : '–', 'green', delta(pu, prevPushupsBefore(d.date), (n) => String(n))],
                ]
                return (
                  <tr class={r ? undefined : 'rest'}>
                    <td class="daycell">Day {d.day}<span class="datesub">{fmtDate(d.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span></td>
                    {r ? (
                      runCells.map(([v, c, dl]) => (
                        <td>
                          <span class={`v ${c}`}>{v}</span>
                          {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                        </td>
                      ))
                    ) : (
                      <td colspan="4"><span class="rest-label">No run</span></td>
                    )}
                    {bodyCells.map(([v, c, dl]) => (
                      <td>
                        <span class={`v ${c}`}>{v}</span>
                        {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                      </td>
                    ))}
                  </tr>
                )
              })}
            </tbody>
          </table>
        )}
      </div>
      <p class="note">Green = better than the previous run (longer, faster, lower heart rate, lower weight, more push-ups). Weight and push-ups can also be logged on rest days.</p>

      {weightLog.length > 1 && (
        <>
          <h2>Weigh-ins</h2>
          <div class="table-wrap">
            <table style="min-width: 0">
              <thead><tr><th>Date</th><th>Weight</th></tr></thead>
              <tbody>
                {weightLog.map((w, i) => {
                  const d = i > 0 ? delta(w.lb, weightLog[i - 1].lb, (n) => `${n.toFixed(1)} lb`, true) : null
                  return (
                    <tr>
                      <td class="datecell">{fmtDate(w.date, { weekday: 'short', month: 'short', day: 'numeric' })}</td>
                      <td>
                        <span class="v purple">{w.lb.toFixed(1)} lb</span>
                        {d && <span class={`delta ${d.dir}`}>{d.text}</span>}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      <footer>Outdoor runs recorded with Apple Watch · <a href="/">rajil.me</a></footer>
    </main>
    <script>
      // Keep the day counter current in the visitor's local time, no rebuild needed.
      const el = document.querySelector<HTMLElement>('.challenge')!
      const total = Number(el.dataset.days)
      const [y, m, d] = el.dataset.start!.split('-').map(Number)
      const start = new Date(y, m - 1, d)
      const now = new Date()
      const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate())
      const day = Math.min(total, Math.max(1, Math.round((todayMidnight.getTime() - start.getTime()) / 86400000) + 1))
      document.getElementById('day-now')!.textContent = String(day)
      document.getElementById('days-left')!.textContent = String(total - day)
      const track = document.getElementById('track')!
      track.style.setProperty('--p', `${(day / total) * 100}%`)
      track.setAttribute('aria-valuenow', String(day))
      document.getElementById('pct')!.textContent = `${Math.round((day / total) * 100)}%`

      // Black & white switch: toggles between dark (default) and light, remembered per browser.
      const root = document.documentElement
      const toggle = document.getElementById('theme-toggle')!
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!
      const applyTheme = (theme: 'dark' | 'light') => {
        root.dataset.theme = theme
        themeColor.content = theme === 'light' ? '#fff' : '#000'
        const label = theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
        toggle.setAttribute('aria-label', label)
        toggle.title = label
      }
      applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark')
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light'
        applyTheme(next)
        try { localStorage.setItem('run-theme', next) } catch {}
      })
    </script>
  </body>
</html>
