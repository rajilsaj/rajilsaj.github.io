---
import { CHALLENGE_START, HR_ZONES, challengeDays, challengeYear, progressOn, todayIso, runTotals, weightsByDate, pushupsByDate, toSec, fmtDuration, fmtPace, fmtDate } from '~/data/runs'

const title = 'Day by Day Challenge · Running Non Stop'
const description = 'Running every single day, no finish line. Days, months and years completed.'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')

const days = challengeDays() // every calendar day since Day 0 through today, oldest → newest (rendered newest first)
const lastDay = days[days.length - 1]?.day ?? 0
const { count, measured, totalMi, totalSec, avgPaceSec } = runTotals()

const weightLog = weightsByDate()
const latestWeight = weightLog[weightLog.length - 1] ?? null
const firstWeight = weightLog[0] ?? null
const weightChange = latestWeight && firstWeight && latestWeight !== firstWeight ? latestWeight.lb - firstWeight.lb : null

const pushupLog = pushupsByDate()
const totalPushups = pushupLog.reduce((a, p) => a + p.count, 0)
const latestPushups = pushupLog[pushupLog.length - 1] ?? null

// change vs the previous run day
type Delta = { text: string; dir: 'up' | 'down' | 'flat' } | null
const delta = (cur: number | undefined, prev: number | undefined, fmt: (n: number) => string, lowerIsBetter = false): Delta => {
  if (cur == null || prev == null) return null
  const d = cur - prev
  if (Math.abs(d) < 1e-9) return { text: '=', dir: 'flat' }
  const better = lowerIsBetter ? d < 0 : d > 0
  return { text: `${d > 0 ? '+' : '−'}${fmt(Math.abs(d))}`, dir: better ? 'up' : 'down' }
}
const signed = (n: number, unit: string) => `${n > 0 ? '+' : '−'}${Math.abs(n).toFixed(1)} ${unit}`

// challenge progress (server-side fallback; the browser recomputes it live)
const startDate = CHALLENGE_START
const prog = progressOn(todayIso())
const dayNow = prog.day
const runDates = new Set(days.filter((d) => d.run).map((d) => d.date))
const yearGrid = challengeYear(prog.years) // one row per challenge month of the current year
const rings = [
  { key: 'days', value: prog.day, label: prog.day === 1 ? 'day' : 'days', pct: prog.milestonePct, sub: `next stop: Day ${prog.milestone}` },
  { key: 'months', value: prog.months, label: prog.months === 1 ? 'month' : 'months', pct: prog.monthPct, sub: `${prog.daysToNextMonth} ${prog.daysToNextMonth === 1 ? 'day' : 'days'} to month ${prog.months + 1}` },
  { key: 'years', value: prog.years, label: prog.years === 1 ? 'year' : 'years', pct: prog.yearPct, sub: `${prog.daysToNextYear} ${prog.daysToNextYear === 1 ? 'day' : 'days'} to year ${prog.years + 1}` },
]

// previous logged value before a given date (so deltas work across rest days)
const prevWeightBefore = (date: string) => [...weightLog].reverse().find((w) => w.date < date)?.lb
const prevPushupsBefore = (date: string) => [...pushupLog].reverse().find((p) => p.date < date)?.count
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0e13" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('run-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <style is:global>
      :root {
        --bg: #0b0e13;
        --card: #151b22;
        --card-2: #1b222b;
        --line: #252c35;
        --track: #2a323c;
        --text: #fff;
        --muted: #8b95a3;
        --lime: #c8f22b;
        --yellow: #fff;
        --blue: #fff;
        --red: #ff5c7a;
        --green: #c8f22b;
        --cyan: #fff;
        --orange: #fff;
        --purple: #fff;
        --bar: #c8f22b;
        --bar-track: rgba(200, 242, 43, 0.22);
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: dark;
      }
      :root[data-theme='light'] {
        --bg: #fff;
        --card: #f3f5f7;
        --card-2: #eaedf1;
        --line: #dde2e8;
        --track: #e3e7ec;
        --text: #0b0e13;
        --muted: #66707c;
        --lime: #c8f22b;
        --yellow: #0b0e13;
        --blue: #0b0e13;
        --red: #d7263d;
        --green: #6c9600;
        --cyan: #0b0e13;
        --orange: #0b0e13;
        --purple: #0b0e13;
        --bar: #c8f22b;
        --bar-track: #ebf8b8;
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: light;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--text); -webkit-text-size-adjust: 100%; }
      body {
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.3;
        min-height: 100vh;
        overflow-x: hidden;
      }
      main { max-width: 760px; margin: 0 auto; padding: 28px 16px 60px; }

      header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
      header .titles { flex: 1; min-width: 0; }

      /* black & white theme switch */
      .theme-toggle {
        flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; padding: 0;
        border: 2px solid var(--text);
        background: linear-gradient(90deg, #000 0 50%, #fff 50% 100%);
        box-shadow: 0 0 0 2px var(--bg), 0 2px 10px rgba(0, 0, 0, 0.3);
        transition: transform 0.35s ease;
      }
      .theme-toggle:hover { transform: rotate(180deg); }
      .theme-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
      :root[data-theme='light'] .theme-toggle { transform: rotate(180deg); }
      :root[data-theme='light'] .theme-toggle:hover { transform: rotate(360deg); }
      .badge {
        width: 52px; height: 52px; border-radius: 50%;
        background: var(--lime);
        display: grid; place-items: center; font-size: 26px; flex: none;
        box-shadow: 0 0 24px rgba(200, 242, 43, 0.3);
      }
      h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
      header p { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
      h2 { font-size: 1.2rem; font-weight: 700; margin: 26px 0 10px; }

      .challenge { background: linear-gradient(135deg, var(--card) 0%, var(--card-2) 100%); border-radius: 18px; padding: 20px 20px 18px; margin-bottom: 14px; border: 1px solid var(--track); display: flex; gap: 18px; align-items: center; min-width: 0; max-width: 100%; }
      .challenge .body { flex: 1 1 0; min-width: 0; }
      .mascot { flex: none; width: 118px; height: 138px; border-radius: 14px; overflow: hidden; background: #f3d24a; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
      .mascot img { width: 100%; height: 100%; object-fit: cover; display: block; }
      @media (max-width: 559px) {
        .challenge { padding: 16px; gap: 12px; }
        .mascot { width: 86px; height: 100px; border-radius: 12px; }
        .challenge .count { font-size: 2.1rem; }
        h1 { font-size: clamp(1.25rem, 6.2vw, 1.5rem); }
        .challenge .range { font-size: 0.8rem; }
      }
      /* small phones: mascot tucks beside the counter, bar and caption take the full card width */
      @media (max-width: 479px) {
        .challenge { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'top mascot' 'rings rings'; gap: 0 12px; align-items: start; }
        .challenge .body { display: contents; }
        .challenge .top { grid-area: top; flex-direction: column; align-items: flex-start; gap: 6px; }
        .rings { grid-area: rings; }
        .mascot { grid-area: mascot; width: 72px; height: 84px; }
      }
      .challenge .top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .challenge .count { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
      .challenge .count .pre { font-size: 0.4em; font-weight: 700; color: var(--muted); margin-right: 6px; letter-spacing: 0.04em; text-transform: uppercase; }
      .challenge .range { color: var(--muted); font-size: 0.85rem; }
      .challenge .range b { color: var(--text); font-weight: 600; }

      /* three rings: days (toward the next milestone), months and years (through the current one) */
      .rings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }
      .ring { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; min-width: 0; }
      .ring svg { width: 100%; max-width: 104px; aspect-ratio: 1; transform: rotate(-90deg); display: block; }
      .ring circle { fill: none; stroke-width: 3.4; }
      .ring-bg { stroke: var(--bar-track); }
      .ring-fg { stroke: var(--bar); stroke-linecap: round; stroke-dasharray: 100; transition: stroke-dashoffset 0.8s ease; }
      .ring-num { position: absolute; top: 0; left: 0; right: 0; aspect-ratio: 1; max-width: 104px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; }
      .ring-num b { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; }
      .ring-num span { font-size: 0.68rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 3px; }
      .ring-sub { color: var(--muted); font-size: 0.74rem; margin-top: 8px; line-height: 1.25; }
      @media (max-width: 399px) { .ring-num b { font-size: 1.3rem; } .ring-num span { font-size: 0.6rem; } }

      /* year grid: one row per challenge month, one dot per day */
      .yeargrid { background: var(--card); border-radius: 16px; padding: 14px 16px 16px; margin-bottom: 14px; }
      .yg-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
      .yg-head h2 { margin: 0; font-size: 1rem; }
      .legend { display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 0.72rem; flex-wrap: wrap; }
      .legend .dot { width: 9px; margin-left: 6px; }
      .yg-row { display: grid; grid-template-columns: 58px minmax(0, 1fr) 40px; align-items: center; gap: 8px; padding: 3px 0; }
      .yg-label { font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
      .yg-label small { color: var(--muted); font-weight: 500; margin-left: 5px; }
      .yg-dots { display: grid; grid-template-columns: repeat(31, minmax(0, 1fr)); gap: 3px; }
      .yg-count { font-size: 0.72rem; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
      .yg-row.complete .yg-count { color: var(--green); font-weight: 800; }
      .dot { display: block; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--track); background: transparent; max-width: 11px; }
      .dot.done { background: var(--track); border-color: var(--track); }
      .dot.ran { background: var(--bar); border-color: var(--bar); }
      .dot.today { border: 2px solid var(--bar); animation: pulse 1.6s ease-in-out infinite; }
      @keyframes pulse { 50% { box-shadow: 0 0 0 3px var(--bar-track); } }
      @media (prefers-reduced-motion: reduce) { .dot.today { animation: none; } .ring-fg { transition: none; } }
      @media (max-width: 479px) { .yg-row { grid-template-columns: 30px minmax(0, 1fr) 34px; gap: 6px; } .yg-label small { display: none; } .yg-dots { gap: 2px; } }

      /* tiles: 2 per row on phones, 3 on tablets, all 5 in one row on desktop; last row always stretches to fill */
      .summary { display: flex; flex-wrap: wrap; gap: 10px; }
      .tile { flex: 1 1 calc(50% - 10px); min-width: 0; background: var(--card); border-radius: 14px; padding: 14px 14px; container-type: inline-size; }
      @media (min-width: 600px) { .tile { flex-basis: calc(33.333% - 10px); } }
      @media (min-width: 740px) { .tile { flex-basis: 0; } }
      .tile .label { color: var(--muted); font-size: 0.82rem; font-weight: 600; }
      .tile .value { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: clip; }
      .tile .value small { font-size: 0.6em; margin-left: 2px; }
      .tile .sub { color: var(--muted); font-size: 0.8rem; margin-top: 2px; overflow-wrap: anywhere; }
      /* shrink the big number when the tile itself is narrow, whatever the viewport */
      @container (max-width: 150px) { .tile .value { font-size: 1.35rem; } }
      @container (max-width: 120px) { .tile .value { font-size: 1.15rem; } }

      .table-wrap { background: var(--card); border-radius: 16px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
      .table-wrap::-webkit-scrollbar { height: 6px; }
      .table-wrap::-webkit-scrollbar-track { background: transparent; }
      .table-wrap::-webkit-scrollbar-thumb { background: var(--line); border-radius: 999px; }
      table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
      th, td { text-align: left; padding: 12px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
      tr:last-child td { border-bottom: none; }
      td .v { font-weight: 700; font-size: 1.1rem; }
      .daycell { font-weight: 700; }
      .daycell .datesub { display: block; color: var(--muted); font-weight: 400; font-size: 0.82rem; margin-top: 2px; }
      .datecell { color: var(--muted); }
      tr.rest .daycell, tr.rest .datecell { color: var(--muted); }
      .rest-label { display: inline-block; color: var(--muted); font-size: 0.85rem; font-style: italic; }
      .delta { display: block; font-size: 0.78rem; margin-top: 2px; color: var(--muted); }
      /* heart-rate zone strip: zones 1–5 sized by time spent, under the average heart rate */
      .zones { display: flex; gap: 2px; height: 5px; margin-top: 6px; min-width: 96px; }
      .zones i { display: block; flex-basis: 0; min-width: 2px; border-radius: 3px; }
      .z1 { background: #0a84ff; } .z2 { background: #5ac8fa; } .z3 { background: #c8f22b; } .z4 { background: #ff9f0a; } .z5 { background: #ff375f; }
      .rec { display: block; font-size: 0.72rem; color: var(--muted); margin-top: 4px; }
      .delta.up { color: var(--green); }
      .delta.down { color: var(--red); }
      .yellow { color: var(--yellow); } .blue { color: var(--blue); } .red { color: var(--red); }
      .green { color: var(--green); } .cyan { color: var(--cyan); } .orange { color: var(--orange); } .purple { color: var(--purple); }
      .empty { color: var(--muted); padding: 20px; text-align: center; }

      /* phones and small tablets: each day becomes a card with a two-column grid of labelled stats */
      @media (max-width: 739px) {
        .daylog thead { display: none; }
        .daylog, .daylog tbody { display: block; }
        .daylog tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 14px; padding: 14px 16px 16px; border-bottom: 1px solid var(--line); }
        .daylog tr:last-child { border-bottom: none; }
        .daylog td { display: block; padding: 0; border: 0; white-space: normal; min-width: 0; }
        .daylog td.daycell { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 8px; font-size: 1.05rem; }
        .daylog td.daycell .datesub { display: inline; margin: 0; }
        .daylog td[colspan] { grid-column: 1 / -1; }
        .daylog tr.rest { gap: 6px 14px; }
        .daylog tr.rest td[colspan] { margin-bottom: 4px; }
        .daylog td[data-label]::before { content: attr(data-label); display: block; color: var(--muted); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
        .daylog td .v { font-size: 1.05rem; }
        .daylog .delta { display: inline-block; margin: 0 0 0 6px; white-space: nowrap; }
        .daylog .zones { max-width: 160px; }
      }
      .note { color: var(--muted); font-size: 0.85rem; margin-top: 10px; }

      footer { color: var(--muted); font-size: 0.8rem; margin-top: 30px; text-align: center; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="badge">🏃</div>
        <div class="titles">
          <h1>Day by Day Challenge</h1>
          <p>Running non stop · one run every day, no finish line</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode"></button>
      </header>

      <section class="challenge" aria-label="Challenge progress" data-start={startDate}>
        <div class="body">
          <div class="top">
            <div class="count"><small class="pre">Day</small><span id="day-now">{dayNow}</span></div>
            <div class="range">Day 0 was <b>{fmtDate(startDate, { month: 'short', day: 'numeric', year: 'numeric' })}</b> · {count} {count === 1 ? 'run' : 'runs'} logged</div>
          </div>
          <div class="rings">
            {rings.map((r) => (
              <div class="ring" data-ring={r.key}>
                <svg viewBox="0 0 40 40" aria-hidden="true">
                  <circle class="ring-bg" cx="20" cy="20" r="17" pathLength="100" />
                  <circle class="ring-fg" cx="20" cy="20" r="17" pathLength="100" style={`stroke-dashoffset:${100 - r.pct * 100}`} />
                </svg>
                <div class="ring-num"><b data-v>{r.value}</b><span data-l>{r.label}</span></div>
                <div class="ring-sub" data-s>{r.sub}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="mascot" aria-hidden="true"><img src="/run/beep-beep.gif" alt="" loading="lazy" /></div>
      </section>

      <section class="yeargrid" aria-label={`Year ${prog.years + 1}, one dot per day`}>
        <div class="yg-head">
          <h2>Year {prog.years + 1}</h2>
          <div class="legend"><i class="dot ran"></i>run <i class="dot done"></i>no run <i class="dot today"></i>today <i class="dot"></i>ahead</div>
        </div>
        {yearGrid.map((m) => (
          <div class="yg-row">
            <span class="yg-label" title={`Month ${m.month} starts ${fmtDate(m.from, { month: 'short', day: 'numeric', year: 'numeric' })}`}>M{m.month}<small>{fmtDate(m.from, { month: 'short' })}</small></span>
            <span class="yg-dots">
              {m.dates.map((date) => (
                <i class:list={['dot', { ran: runDates.has(date) }]} data-date={date} title={fmtDate(date, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}></i>
              ))}
            </span>
            <span class="yg-count"></span>
          </div>
        ))}
      </section>

      <section aria-label="Totals" class="summary">
        <div class="tile">
          <div class="label">Runs</div>
          <div class="value">{count}</div>
          <div class="sub">{fmtDuration(totalSec)} total</div>
        </div>
        <div class="tile">
          <div class="label">Distance</div>
          <div class="value blue">{totalMi.toFixed(1)}<small>MI</small></div>
          <div class="sub">{measured ? (totalMi / measured).toFixed(2) : '–'} mi per run</div>
        </div>
        <div class="tile">
          <div class="label">Avg. pace</div>
          <div class="value cyan">{totalMi > 0 ? fmtPace(avgPaceSec) : '–'}<small>/MI</small></div>
          <div class="sub">across all runs</div>
        </div>
        <div class="tile">
          <div class="label">Weight</div>
          <div class="value purple">{latestWeight ? latestWeight.lb.toFixed(1) : '–'}<small>LB</small></div>
          <div class="sub">
            {latestWeight
              ? weightChange != null
                ? `${signed(weightChange, 'lb')} since ${fmtDate(firstWeight!.date, { month: 'short', day: 'numeric' })}`
                : `logged ${fmtDate(latestWeight.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
        <div class="tile">
          <div class="label">Push-ups</div>
          <div class="value green">{totalPushups}</div>
          <div class="sub">
            {latestPushups
              ? `${latestPushups.count} on ${fmtDate(latestPushups.date, { month: 'short', day: 'numeric' })}`
              : 'not logged yet'}
          </div>
        </div>
      </section>

      <h2>Day by day</h2>
      <div class="table-wrap">
        {days.length === 0 && <p class="empty">Nothing logged yet.</p>}
        {days.length > 0 && (
          <table class="daylog" id="daylog" data-last-day={lastDay}>
            <thead>
              <tr>
                <th>Day</th><th>Distance</th><th>Time</th><th>Pace</th><th>Heart rate</th><th>Weight</th><th>Push-ups</th>
              </tr>
            </thead>
            <tbody>
              {[...days].reverse().map((d) => {
                const i = d.day // index in the oldest → newest array
                const r = d.run
                // compare against the most recent run before this day, skipping rest days
                const p = days.slice(0, i).reverse().find((x) => x.run)?.run
                const w = d.weight
                const pu = d.pushups
                const runCells: [string, string, string, Delta][] = r
                  ? [
                      ['Distance', r.distanceMi != null ? `${r.distanceMi.toFixed(2)} mi` : '–', 'blue', delta(r.distanceMi, p?.distanceMi, (n) => `${n.toFixed(2)} mi`)],
                      ['Time', r.workoutTime, 'yellow', delta(toSec(r.workoutTime), p ? toSec(p.workoutTime) : undefined, fmtDuration)],
                      ['Pace', r.avgPace ? `${fmtPace(toSec(r.avgPace))}/mi` : '–', 'cyan', delta(r.avgPace ? toSec(r.avgPace) : undefined, p?.avgPace ? toSec(p.avgPace) : undefined, fmtDuration, true)],
                      ['Heart rate', r.avgHrBpm ? `${r.avgHrBpm} bpm` : '–', 'orange', delta(r.avgHrBpm, p?.avgHrBpm, (n) => `${n} bpm`, true)],
                    ]
                  : []
                const zoneSec = r?.hrZones?.map(toSec) ?? []
                const zoneTotal = zoneSec.reduce((a, b) => a + b, 0)
                const bodyCells: [string, string, string, Delta][] = [
                  ['Weight', w != null ? `${w.toFixed(1)} lb` : '–', 'purple', delta(w, prevWeightBefore(d.date), (n) => `${n.toFixed(1)} lb`, true)],
                  ['Push-ups', pu != null ? String(pu) : '–', 'green', delta(pu, prevPushupsBefore(d.date), (n) => String(n))],
                ]
                return (
                  <tr class={r ? undefined : 'rest'}>
                    <td class="daycell">Day {d.day}<span class="datesub">{fmtDate(d.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span></td>
                    {r ? (
                      runCells.map(([label, v, c, dl], ci) => (
                        <td data-label={label}>
                          <span class={`v ${c}`}>{v}</span>
                          {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                          {ci === 3 && zoneTotal > 0 && (
                            <span class="zones" aria-label="Time in heart rate zones">
                              {zoneSec.map((s, zi) => (
                                <i class={`z${zi + 1}`} style={`flex-grow:${s}`} title={`Zone ${zi + 1} · ${r.hrZones![zi]} · ${HR_ZONES[zi]} bpm`}></i>
                              ))}
                            </span>
                          )}
                          {ci === 3 && r.recoveryHr && <span class="rec" title="Post-workout heart rate: end → 1 min → 2 min">↓ {r.recoveryHr.end} · {r.recoveryHr.min1} · {r.recoveryHr.min2}</span>}
                        </td>
                      ))
                    ) : (
                      <td colspan="4"><span class="rest-label">No run</span></td>
                    )}
                    {bodyCells.map(([label, v, c, dl]) => (
                      <td data-label={label}>
                        <span class={`v ${c}`}>{v}</span>
                        {dl && <span class={`delta ${dl.dir}`}>{dl.text}</span>}
                      </td>
                    ))}
                  </tr>
                )
              })}
            </tbody>
          </table>
        )}
      </div>
      <p class="note">Green = better than the previous run (longer, faster, lower heart rate, lower weight, more push-ups). Weight and push-ups can also be logged on rest days.</p>

      {weightLog.length > 1 && (
        <>
          <h2>Weigh-ins</h2>
          <div class="table-wrap">
            <table style="min-width: 0">
              <thead><tr><th>Date</th><th>Weight</th></tr></thead>
              <tbody>
                {[...weightLog].reverse().map((w) => {
                  const i = weightLog.indexOf(w) // index in the oldest → newest array
                  const d = i > 0 ? delta(w.lb, weightLog[i - 1].lb, (n) => `${n.toFixed(1)} lb`, true) : null
                  return (
                    <tr>
                      <td class="datecell">{fmtDate(w.date, { weekday: 'short', month: 'short', day: 'numeric' })}</td>
                      <td>
                        <span class="v purple">{w.lb.toFixed(1)} lb</span>
                        {d && <span class={`delta ${d.dir}`}>{d.text}</span>}
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      <footer>Outdoor runs recorded with Apple Watch · <a href="/">rajil.me</a></footer>
    </main>
    <script>
      import { progressOn } from '~/data/runs'

      // Keep the counter, rings and year grid current in the visitor's local time, no rebuild needed.
      const el = document.querySelector<HTMLElement>('.challenge')!
      const [y, m, d] = el.dataset.start!.split('-').map(Number)
      const start = new Date(y, m - 1, d)
      const now = new Date()
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
      const prog = progressOn(today)
      const day = prog.day
      document.getElementById('day-now')!.textContent = String(day)
      const plural = (n: number, word: string) => `${n} ${n === 1 ? word : word + 's'}`
      const ringData: Record<string, [number, string, number, string]> = {
        days: [prog.day, prog.day === 1 ? 'day' : 'days', prog.milestonePct, `next stop: Day ${prog.milestone}`],
        months: [prog.months, prog.months === 1 ? 'month' : 'months', prog.monthPct, `${plural(prog.daysToNextMonth, 'day')} to month ${prog.months + 1}`],
        years: [prog.years, prog.years === 1 ? 'year' : 'years', prog.yearPct, `${plural(prog.daysToNextYear, 'day')} to year ${prog.years + 1}`],
      }
      for (const ring of document.querySelectorAll<HTMLElement>('.ring')) {
        const [v, l, pct, sub] = ringData[ring.dataset.ring!]
        ring.querySelector('[data-v]')!.textContent = String(v)
        ring.querySelector('[data-l]')!.textContent = l
        ring.querySelector('[data-s]')!.textContent = sub
        ring.querySelector<SVGElement>('.ring-fg')!.style.strokeDashoffset = String(100 - pct * 100)
      }
      for (const row of document.querySelectorAll<HTMLElement>('.yg-row')) {
        const dots = [...row.querySelectorAll<HTMLElement>('.dot')]
        let done = 0
        for (const dot of dots) {
          const date = dot.dataset.date!
          dot.classList.toggle('done', date < today)
          dot.classList.toggle('today', date === today)
          if (date <= today) done++
        }
        row.classList.toggle('complete', done === dots.length)
        row.querySelector('.yg-count')!.textContent = done === dots.length ? '✓' : done ? `${done}/${dots.length}` : ''
      }

      // The day-by-day list is built through the deploy date; add a "No run" row for
      // each day that has passed since, newest at the top, so it keeps counting up daily.
      const daylog = document.getElementById('daylog')
      const tbody = daylog?.querySelector('tbody')
      if (daylog && tbody) {
        const lastBuilt = Number(daylog.dataset.lastDay)
        for (let n = lastBuilt + 1; n <= day; n++) {
          const date = new Date(start.getFullYear(), start.getMonth(), start.getDate() + n)
          const tr = document.createElement('tr')
          tr.className = 'rest'
          tr.innerHTML =
            `<td class="daycell">Day ${n}<span class="datesub"></span></td>` +
            `<td colspan="4"><span class="rest-label">No run</span></td>` +
            `<td data-label="Weight"><span class="v purple">–</span></td>` +
            `<td data-label="Push-ups"><span class="v green">–</span></td>`
          tr.querySelector('.datesub')!.textContent = date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
          tbody.prepend(tr)
        }
      }

      // Black & white switch: toggles between dark (default) and light, remembered per browser.
      const root = document.documentElement
      const toggle = document.getElementById('theme-toggle')!
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!
      const applyTheme = (theme: 'dark' | 'light') => {
        root.dataset.theme = theme
        themeColor.content = theme === 'light' ? '#fff' : '#0b0e13'
        const label = theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
        toggle.setAttribute('aria-label', label)
        toggle.title = label
      }
      applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark')
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light'
        applyTheme(next)
        try { localStorage.setItem('run-theme', next) } catch {}
      })
    </script>
  </body>
</html>
