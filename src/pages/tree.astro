---

<Layout title="Online Income Tree" description="Ranked paths to online income for software engineers, with experience requirements and US tax implications.">
  <header class="mb-12">
    <h1 class="text-2xl font-semibold tracking-tight text-heading1 sm:text-3xl">
      Online Income Tree
    </h1>
    <p class="mt-2 text-foreground/60">
      Ranked by time-to-income and experience needed. Every path is taxable.
    </p>
  </header>

  <div class="space-y-8">
    {sections.map((section) => (
      <section class="border-t border-separator pt-6">
        <div class="flex items-baseline gap-3 mb-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full border border-separator bg-foreground/5 font-semibold text-foreground">
            {section.num}
          </div>
          <h2 class="text-lg font-semibold text-heading2">{section.title}</h2>
          <span class="text-xs font-mono text-foreground/50 ml-auto">{section.timeframe}</span>
        </div>

        <div class="ml-11 space-y-6">
          {section.items.map((item) => (
            <div class="border-l border-separator/50 pl-4">
              <h3 class="font-semibold text-foreground mb-1">{item.name}</h3>
              <p class="text-sm text-foreground/60 mb-3">{item.desc}</p>

              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-mono ${
                  item.tax === 'W-2' ? 'bg-blue/10 text-blue' :
                  item.tax === 'No form' ? 'bg-warning/10 text-warning' :
                  'bg-accent/10 text-accent'
                }`}>
                  📋 {item.tax}
                </span>
              </div>

              {item.platforms.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {item.platforms.map((platform, idx) => (
                    <a
                      href={platforms[platform] || '#'}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-md border border-separator bg-foreground/[0.03] px-2.5 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-accent/40 hover:bg-accent/5 hover:text-accent no-underline"
                    >
                      <span class="font-mono text-foreground/50">{idx + 1}</span>
                      {platform}
                      <span class="text-foreground/30">→</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
