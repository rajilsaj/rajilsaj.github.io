---
const title = 'PR'
const description = 'PR app'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
const appUrl = 'https://script.google.com/macros/s/AKfycbyQBbeb6xcuP2N0UYP0cYqG1Og3HuW851pQ6X4vJYRDtLfKb6Mkzr08agtEVZVsNpcl5Q/exec'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://script.google.com" />
    <meta name="theme-color" content="#111" />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; overflow: hidden; background: #111; color: #eee; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }

      iframe {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
        background: #fff;
        opacity: 0;
        transition: opacity 0.6s ease;
      }
      body.ready iframe { opacity: 1; }

      #loader {
        position: fixed;
        inset: 0;
        z-index: 2;
        display: grid;
        place-items: center;
        background: #111;
        transition: opacity 0.5s ease, visibility 0s 0.5s;
      }
      body.ready #loader { opacity: 0; visibility: hidden; pointer-events: none; }
      .box { text-align: center; padding: 24px; }
      .spinner {
        width: 44px;
        height: 44px;
        margin: 0 auto 18px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.15);
        border-top-color: #4d96ff;
        animation: spin 0.9s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .box p { color: #aaa; font-size: 0.95rem; }
      .box .slow { margin-top: 18px; opacity: 0; transition: opacity 0.4s; }
      .box .slow.show { opacity: 1; }
      .btn {
        display: inline-block;
        margin-top: 10px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        color: #111;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.9rem;
      }

      #open {
        position: fixed;
        right: 12px;
        bottom: max(12px, env(safe-area-inset-bottom));
        z-index: 3;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        text-decoration: none;
        font-size: 18px;
        opacity: 0;
        transition: opacity 0.4s ease 0.8s;
        backdrop-filter: blur(6px);
      }
      body.ready #open { opacity: 0.55; }
      #open:hover { opacity: 1; }

      @media (prefers-reduced-motion: reduce) {
        .spinner { animation: none; }
        iframe, #loader { transition: none; }
      }
    </style>
  </head>
  <body>
    <div id="loader" role="status" aria-live="polite">
      <div class="box">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading…</p>
        <div class="slow" id="slow">
          <p>Not showing up? You may need to sign in to Google first.</p>
          <a class="btn" href={appUrl} target="_blank" rel="noopener noreferrer">Open in a new tab ↗</a>
        </div>
      </div>
    </div>

    <iframe
      id="app"
      title="PR app"
      data-src={appUrl}
      allow="clipboard-write; fullscreen"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>

    <a id="open" href={appUrl} target="_blank" rel="noopener noreferrer" title="Open in a new tab" aria-label="Open in a new tab">↗</a>

    <script>
      const frame = document.getElementById('app') as HTMLIFrameElement
      const slow = document.getElementById('slow')!
      const ready = () => document.body.classList.add('ready')

      frame.addEventListener('load', ready)
      // Let the loader paint first, then start the (heavier) app load.
      requestAnimationFrame(() => {
        frame.src = frame.dataset.src!
      })
      // Offer a way out if the app is slow or refuses to be embedded.
      window.setTimeout(() => slow.classList.add('show'), 6000)
      window.setTimeout(ready, 20000)
    </script>
  </body>
</html>
