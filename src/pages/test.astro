  '</div>'+
  '<div class="hyp"><svg viewBox="0 0 620 150" class="tHypSvg" role="img" aria-label="Sleep stages across the night">'+
    '<g class="tGrid"></g><g class="tTicks"></g><g class="tSegs"></g><path class="trace tTrace"></path>'+
    '<g><line class="head" y1="8" y2="146"></line><circle class="headdot" r="3"></circle></g></svg></div>'+
  '<details><summary>Open the recorder — brain waves, eye movements, muscle tension</summary>'+
