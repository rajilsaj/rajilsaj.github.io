function drawTips(card,d){
  card.querySelector(".tLead").textContent=d.flags.length
    ? "What's costing points: "+d.flags.join("; ")+"."
    : "Nothing to fix. Keep this pair.";
  const chips=card.querySelector(".tChips"); chips.innerHTML="";
  const opts=[];
  for(let k=4;k<=6;k++) opts.push({label:"Wake "+fmt(d.bed+d.lat+k*d.cycle)+" ("+k+" cycles)",bed:d.bed,wake:(d.bed+d.lat+k*d.cycle)%1440});
  const onClock=(d.idealBed+d.lat+Math.round(d.idealDur/d.cycle)*d.cycle)%1440;
  opts.push({label:"Your window: "+fmt(d.idealBed)+" \u2192 "+fmt(onClock),bed:d.idealBed,wake:onClock});
  opts.forEach(function(o){
    const b=document.createElement("button");
    b.className="chip"; b.textContent=o.label;
    b.addEventListener("click",function(){ el("bed").value=fmt(o.bed); el("wake").value=fmt(o.wake); run(false); });
    chips.appendChild(b);
  });
}

const CH=[{key:"eogL",name:"Left eye",color:"#c2d95f"},{key:"eogR",name:"Right eye",color:"#c2d95f"},
          {key:"emg",name:"Muscle",color:"#5aa9e6"},{key:"eeg",name:"Brain",color:"#ff6b6b"}];
function recorder(card,d,xScale){
  const cv=card.querySelector(".tCanvas"), ctx=cv.getContext("2d");
  const scrub=card.querySelector(".tScrub"), pill=card.querySelector(".tPill"),
        clock=card.querySelector(".tClock"), play=card.querySelector(".tPlay"),
        head=card.querySelector(".head"), dot=card.querySelector(".headdot");
  const N=260, buf={};
  CH.forEach(function(c){ buf[c.key]=new Array(N).fill(0); });
  const st={ph:0,eye:0,tg:0,hold:0,pos:0,playing:false,last:0};
  function stageAt(t){
    for(let i=0;i<d.segs.length;i++){ const s=d.segs[i]; if(t>=s.start&&t<s.start+s.len) return s.stage; }
    return d.segs.length?d.segs[d.segs.length-1].stage:"N2";
  }
  function push(stage){
    st.ph++; const p=st.ph;
    let eeg,emg,amp,slow=false,jerk=false;
    if(stage==="W"){ eeg=0.20*Math.sin(p*2.4)+0.12*rnd(); emg=0.55*rnd(); amp=0.35; }
    else if(stage==="N1"){ eeg=0.30*Math.sin(p*0.85)+0.10*rnd(); emg=0.30*rnd(); amp=0.40; slow=true; }
    else if(stage==="N2"){
      const sp=(p%150)<16?0.45*Math.sin(p*1.5):0, kc=(p%300)<3?-0.8:0;
      eeg=0.22*Math.sin(p*0.55)+0.08*rnd()+sp+kc; emg=0.22*rnd(); amp=0.05;
    }
    else if(stage==="N3"){ eeg=0.85*Math.sin(p*0.16)+0.06*rnd(); emg=0.14*rnd(); amp=0.03; }
    else { eeg=0.26*Math.sin(p*1.7)+0.14*Math.sin(p*2.9)+0.09*rnd(); emg=0.04*rnd(); amp=0.85; jerk=true; }
    if(jerk){ if(st.hold<=0){ st.tg=rnd()*amp; st.hold=6+Math.random()*22; } st.hold--; st.eye+=(st.tg-st.eye)*0.35; }
    else if(slow){ st.eye=amp*Math.sin(p*0.06); }
    else { st.eye=amp*rnd(); }
    const put=function(k,v){ buf[k].push(v); buf[k].shift(); };
    put("eogL",st.eye); put("eogR",st.eye*0.88+0.04*rnd()); put("emg",emg); put("eeg",clamp(eeg,-1.1,1.1));
  }
  function paint(){
    const dpr=window.devicePixelRatio||1, w=cv.clientWidth, h=172;
    if(!w) return;
    if(cv.width!==Math.floor(w*dpr)||cv.height!==Math.floor(h*dpr)){ cv.width=Math.floor(w*dpr); cv.height=Math.floor(h*dpr); }
    ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,w,h);
    const left=62, plotW=w-left-6, lane=h/CH.length;
    ctx.font='11px "Space Grotesk", sans-serif'; ctx.textBaseline="middle";
    CH.forEach(function(c,i){
      const mid=lane*i+lane/2;
      ctx.strokeStyle="rgba(255,255,255,.05)"; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(left,mid); ctx.lineTo(left+plotW,mid); ctx.stroke();
      ctx.fillStyle="#8aa3b8"; ctx.fillText(c.name,4,mid);
      ctx.strokeStyle=c.color; ctx.lineWidth=1.4; ctx.beginPath();
      const b=buf[c.key], A=lane*0.36;
      for(let j=0;j<N;j++){ const x=left+(j/(N-1))*plotW, y=mid-b[j]*A; if(j===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); }
      ctx.stroke();
    });
  }
  function frame(now){
    if(!card.isConnected) return;
    const dt=Math.min(80,now-(st.last||now)); st.last=now;
    if(st.playing){
      st.pos+=(d.sleep/11000)*dt;
      if(st.pos>=d.sleep){ st.pos=d.sleep; st.playing=false; play.textContent="Replay the night"; }
      scrub.value=d.sleep?st.pos/d.sleep*100:0;
    }
    const stage=stageAt(st.pos);
    pill.textContent=stage+" \u00b7 "+STAGES[stage].note;
    pill.style.background=STAGES[stage].raw;
    clock.textContent=fmt(d.bed+d.lat+st.pos);
    const px=xScale(st.pos);
    head.setAttribute("x1",px); head.setAttribute("x2",px);
    dot.setAttribute("cx",px); dot.setAttribute("cy",LEVEL[stage]);
    for(let i=0;i<3;i++) push(stage);
    paint();
    requestAnimationFrame(frame);
  }
  scrub.addEventListener("input",function(){ st.playing=false; play.textContent="Play the night"; st.pos=d.sleep*scrub.value/100; });
  play.addEventListener("click",function(){ if(st.pos>=d.sleep) st.pos=0; st.playing=!st.playing; play.textContent=st.playing?"Pause":"Play the night"; });
  card.querySelector(".tHypSvg").addEventListener("click",function(e){
    const r=e.currentTarget.getBoundingClientRect();
    const frac=clamp((((e.clientX-r.left)/r.width*W)-PADL)/(W-PADL-PADR),0,1);
    st.playing=false; play.textContent="Play the night"; st.pos=frac*d.sleep; scrub.value=frac*100;
  });
  requestAnimationFrame(frame);
}

function paintCard(host,d){
  host.innerHTML=cardHTML(d);
  const prog=host.querySelector(".prog"), C=2*Math.PI*43;
  prog.style.strokeDasharray=C; prog.style.strokeDashoffset=C;
  prog.setAttribute("stroke",scoreColor(d.score));
  requestAnimationFrame(function(){ prog.style.strokeDashoffset=C*(1-d.score/100); });
  countUp(host.querySelector(".tScore"),d.score);
  const x=drawHyp(host,d);
  drawDonut(host,d); drawBars(host,d); drawTips(host,d); recorder(host,d,x);
}

/* ===== run ===== */
el("lat").addEventListener("input",function(){ el("latV").textContent=el("lat").value; });
el("cyc").addEventListener("input",function(){ el("cycV").textContent=el("cyc").value; });

let mine=null;
function run(withSound){
  if(!el("bed").value||!el("wake").value) return;
  const d=evaluate({
    name:"Your night", type:el("chrono").value,
    bed:toMin(el("bed").value), wake:toMin(el("wake").value),
    lat:Number(el("lat").value), cycle:Number(el("cyc").value),
    age:clamp(Number(el("age").value)||32,10,95)
  });
  mine=d;
  const T=TYPES[d.type];
  el("windowLine").innerHTML=T.name+", age "+el("age").value+": your window opens near <b style="+'"color:'+T.color+'"'+">"+fmt(d.idealBed)+
    "</b> and you need about <b>"+dur(d.idealDur)+"</b>. You can push it "+T.tol+" minutes either way before it stops being your clock.";
  paintCard(el("card"),d);
  const onClock=(d.idealBed+d.lat+Math.round(d.idealDur/d.cycle)*d.cycle)%1440;
  el("challengeLine").textContent="Hold "+fmt(d.idealBed)+" to "+fmt(onClock)+" for seven nights, then judge it. Tap a night once you've made it.";
  buildWeek();
  el("banner").className="banner";
  if(withSound) setTimeout(function(){ Calls.play(d.type); },700);
}
["bed","wake","age","chrono","lat","cyc"].forEach(function(id){ el(id).addEventListener("change",function(){ run(false); }); });

function buildWeek(){
  const w=el("week"); if(w.dataset.built) return;
  w.dataset.built="1";
  for(let i=1;i<=7;i++){
    const b=document.createElement("button");
    b.className="night"; b.textContent="Night "+i;
    b.addEventListener("click",function(){ b.classList.toggle("done"); });
    w.appendChild(b);
  }
}

el("fight").addEventListener("click",function(){
  if(!mine) return;
  const them=evaluate({
    name:el("cName").value.trim()||"Colleague", type:el("cChrono").value,
    bed:toMin(el("cBed").value), wake:toMin(el("cWake").value),
    lat:Number(el("lat").value), cycle:Number(el("cyc").value),
    age:clamp(Number(el("cAge").value)||29,10,95)
  });
  const b=el("banner"), diff=mine.score-them.score;
  let msg, winnerType=null;
  if(diff===0){
    msg="<b>Dead heat at "+mine.score+".</b> Two different animals, identical damage.";
  } else {
    const win=diff>0?mine:them, lose=diff>0?them:mine;
    const wn=diff>0?"You":them.name, ln=diff>0?them.name:"you";
    winnerType=win.type;
    const remGap=win.totals.REM-lose.totals.REM, n3Gap=win.totals.N3-lose.totals.N3;
    const edge=Math.abs(remGap)>Math.abs(n3Gap)
      ? Math.round(Math.abs(remGap))+" more minutes of REM"
      : Math.round(Math.abs(n3Gap))+" more minutes of deep sleep";
    msg="<b>"+wn+" win"+(diff>0?"":"s")+" by "+Math.abs(diff)+" points \u2014 "+win.score+" to "+lose.score+".</b> "+
      dur(win.asleep)+" asleep against "+dur(lose.asleep)+", "+edge+", and "+
      Math.round(win.clockOff)+" min off their own window against "+Math.round(lose.clockOff)+" for "+ln+".";
  }
  b.innerHTML=msg; b.className="banner show";
  if(winnerType) setTimeout(function(){ Calls.play(winnerType); },300);
});

el("bankSize").textContent=BANK.length.toLocaleString();
newDeck(); renderQ();
})();
    </script>
  </body>
</html>
