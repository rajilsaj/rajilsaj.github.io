function shuffle(a){ const x=a.slice(); for(let i=x.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); const t=x[i]; x[i]=x[j]; x[j]=t; } return x; }

function buildBank(){
  const bank=[];
  AUTHORED.forEach(function(it,i){ bank.push({id:"a"+i,dim:it.dim,q:it.q,fixed:!!it.fixed,a:it.a}); });
  TEMPLATES.forEach(function(t,ti){
    const keys=Object.keys(t.slots);
    let combos=[[]];
    keys.forEach(function(k){
      const next=[];
      combos.forEach(function(c){ t.slots[k].forEach(function(v){ next.push(c.concat([v])); }); });
      combos=next;
    });
    combos.forEach(function(c,ci){
      let q=t.tpl;
      keys.forEach(function(k,ki){ q=q.split("{"+k+"}").join(c[ki]); });
      bank.push({id:"t"+ti+"-"+ci,dim:t.dim,q:q,fixed:!!t.fixed,a:t.a});
    });
  });
  return bank;
}
const BANK=buildBank();
const QCOUNT=8;

/* stratified draw: rotate through dimensions, never repeat an item you've seen */
const seen={};
function drawQuestions(n){
  const byDim={};
  BANK.forEach(function(it){ (byDim[it.dim]=byDim[it.dim]||[]).push(it); });
  const dims=shuffle(Object.keys(byDim));
  const out=[]; let di=0, guard=0;
  while(out.length<n && guard++<600){
    const pool=byDim[dims[di%dims.length]].filter(function(it){
      return !seen[it.id] && out.indexOf(it)<0;
    });
    di++;
    if(!pool.length) continue;
    out.push(pool[Math.floor(Math.random()*pool.length)]);
  }
  if(out.length<n){                       // bank exhausted — start the rotation again
    for(const k in seen) delete seen[k];
    BANK.forEach(function(it){ if(out.length<n && out.indexOf(it)<0) out.push(it); });
  }
  out.forEach(function(it){ seen[it.id]=1; });
  return out.map(function(it){
    return {id:it.id, dim:it.dim, q:it.q, a:it.fixed ? it.a.slice() : shuffle(it.a)};
  });
}

/* ===== sound: synthesised calls, no files ===== */
const Calls = (function(){
  let ctx=null, muted=false;
  function ac(){
    if(!ctx){ const C=window.AudioContext||window.webkitAudioContext; if(!C) return null; ctx=new C(); }
    if(ctx.state==="suspended") ctx.resume();
    return ctx;
  }
  function noise(c,dur){
    const b=c.createBuffer(1, Math.max(1,Math.floor(c.sampleRate*dur)), c.sampleRate);
    const d=b.getChannelData(0);
    for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1;
    const s=c.createBufferSource(); s.buffer=b; return s;
  }
  function growl(c,t,opt){
    const out=c.createGain(); out.connect(c.destination);
    const lp=c.createBiquadFilter(); lp.type="lowpass";
    lp.frequency.setValueAtTime(opt.lpf,t); lp.frequency.exponentialRampToValueAtTime(opt.lpf*0.45,t+opt.dur);
    lp.connect(out);
    const g=c.createGain(); g.connect(lp);
    g.gain.setValueAtTime(0.0001,t);
    g.gain.exponentialRampToValueAtTime(opt.gain,t+opt.att);
    g.gain.setValueAtTime(opt.gain,t+opt.dur*0.6);
    g.gain.exponentialRampToValueAtTime(0.0001,t+opt.dur);
    [0,7].forEach(function(det){
      const o=c.createOscillator(); o.type="sawtooth"; o.detune.value=det;
      o.frequency.setValueAtTime(opt.f0,t);
      o.frequency.exponentialRampToValueAtTime(opt.f1,t+opt.dur);
      o.connect(g); o.start(t); o.stop(t+opt.dur+0.05);
    });
    const rasp=c.createOscillator(); rasp.type="square"; rasp.frequency.value=opt.rasp;
    const rg=c.createGain(); rg.gain.value=opt.raspDepth;
    rasp.connect(rg); rg.connect(g.gain); rasp.start(t); rasp.stop(t+opt.dur);
    const n=noise(c,opt.dur), bp=c.createBiquadFilter();
    bp.type="bandpass"; bp.frequency.value=opt.f0*4; bp.Q.value=0.8;
    const ng=c.createGain(); ng.gain.setValueAtTime(opt.noise,t);
    ng.gain.exponentialRampToValueAtTime(0.0001,t+opt.dur);
    n.connect(bp); bp.connect(ng); ng.connect(lp); n.start(t); n.stop(t+opt.dur);
  }
  function howl(c,t){
    const out=c.createGain(); out.gain.value=0.9; out.connect(c.destination);
    const dl=c.createDelay(); dl.delayTime.value=0.26;
    const fb=c.createGain(); fb.gain.value=0.28;
    dl.connect(fb); fb.connect(dl); dl.connect(out);
    const g=c.createGain(); g.connect(out); g.connect(dl);
    g.gain.setValueAtTime(0.0001,t);
    g.gain.exponentialRampToValueAtTime(0.42,t+0.30);
    g.gain.setValueAtTime(0.42,t+1.45);
    g.gain.exponentialRampToValueAtTime(0.0001,t+2.35);
    const o=c.createOscillator(); o.type="sine";
    o.frequency.setValueAtTime(300,t);
    o.frequency.exponentialRampToValueAtTime(615,t+0.42);
    o.frequency.setValueAtTime(615,t+1.25);
    o.frequency.exponentialRampToValueAtTime(540,t+1.75);
    o.frequency.exponentialRampToValueAtTime(285,t+2.3);
    const h=c.createOscillator(); h.type="triangle";
    h.frequency.setValueAtTime(600,t);
    h.frequency.exponentialRampToValueAtTime(1230,t+0.42);
    h.frequency.exponentialRampToValueAtTime(570,t+2.3);
    const hg=c.createGain(); hg.gain.value=0.14; h.connect(hg); hg.connect(g);
    const vib=c.createOscillator(); vib.frequency.value=5.4;
    const vg=c.createGain(); vg.gain.value=9;
    vib.connect(vg); vg.connect(o.frequency);
    o.connect(g);
    [o,h,vib].forEach(function(n){ n.start(t); n.stop(t+2.45); });
  }
  function dolphinCall(c,t){
    const out=c.createGain(); out.gain.value=0.8; out.connect(c.destination);
    for(let i=0;i<7;i++){
      const s=t+i*0.045, n=noise(c,0.02), hp=c.createBiquadFilter();
      hp.type="highpass"; hp.frequency.value=3200;
      const g=c.createGain();
      g.gain.setValueAtTime(0.22,s); g.gain.exponentialRampToValueAtTime(0.0001,s+0.02);
      n.connect(hp); hp.connect(g); g.connect(out); n.start(s); n.stop(s+0.02);
    }
    [[0.38,1700,5400,2400,0.62],[1.10,2400,6100,3100,0.5]].forEach(function(w){
      const s=t+w[0], o=c.createOscillator(), g=c.createGain();
      o.type="sine";
      o.frequency.setValueAtTime(w[1],s);
      o.frequency.exponentialRampToValueAtTime(w[2],s+w[4]*0.45);
      o.frequency.exponentialRampToValueAtTime(w[3],s+w[4]);
      const vib=c.createOscillator(); vib.frequency.value=17;
      const vg=c.createGain(); vg.gain.value=260;
      vib.connect(vg); vg.connect(o.frequency);
      g.gain.setValueAtTime(0.0001,s);
      g.gain.exponentialRampToValueAtTime(0.16,s+0.06);
      g.gain.exponentialRampToValueAtTime(0.0001,s+w[4]);
      o.connect(g); g.connect(out);
      o.start(s); o.stop(s+w[4]+0.05); vib.start(s); vib.stop(s+w[4]+0.05);
    });
  }
  return {
    play:function(type){
      if(muted) return;
      const c=ac(); if(!c) return;
      const t=c.currentTime+0.05;
      if(type==="lion") growl(c,t,{f0:150,f1:78,dur:1.9,att:0.14,gain:0.34,rasp:26,raspDepth:0.16,lpf:1100,noise:0.16});
      else if(type==="bear") growl(c,t,{f0:104,f1:62,dur:1.25,att:0.10,gain:0.32,rasp:44,raspDepth:0.20,lpf:620,noise:0.22});
      else if(type==="wolf") howl(c,t);
      else dolphinCall(c,t);
    },
    toggle:function(){ muted=!muted; return muted; },
    muted:function(){ return muted; }
  };
})();

/* ===== night model ===== */
const STAGES={W:{raw:"#6c8299",note:"awake"},N1:{raw:"#ffd166",note:"drifting off"},
  N2:{raw:"#2ee6a8",note:"light sleep"},N3:{raw:"#47a9f5",note:"deep sleep"},REM:{raw:"#9b8cff",note:"vivid dreaming"}};
const LEVEL={W:14,REM:36,N1:60,N2:86,N3:112};
const W=620, PADL=34, PADR=10;
const REDUCED=window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const el=id=>document.getElementById(id);
const toMin=v=>{const p=v.split(":").map(Number);return p[0]*60+p[1];};
const fmt=m=>{m=((Math.round(m)%1440)+1440)%1440;return String(Math.floor(m/60)).padStart(2,"0")+":"+String(m%60).padStart(2,"0");};
const dur=m=>Math.floor(m/60)+"h "+String(Math.round(m)%60).padStart(2,"0")+"m";
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const circDist=(a,b)=>{const d=Math.abs(a-b);return d>720?1440-d:d;};
const rnd=()=>Math.random()*2-1;

function idealBed(type,age){
  const drift=clamp((age-20)*1.1,0,75);
  return ((TYPES[type].idealBed-drift)%1440+1440)%1440;
}
function idealSleep(age){ if(age<18)return 505; if(age<25)return 480; if(age<65)return 460; return 435; }

function segments(sleepMin,cycle,type){
  const k=cycle/90, frag=(type==="dolphin"), segs=[]; let t=0,i=0;
  while(t<sleepMin && i<14){
    const dm=frag?0.7:1;
    const n1=5*k, n3=Math.max(0,35-12*i)*k*dm, rem=Math.min(35,8+9*i)*k;
    const n2=cycle-n1-n3-rem, n2a=n3>0?n2*0.55:n2*0.6;
    const order=[["N1",n1],["N2",n2a],["N3",n3],["N2",n2-n2a],["REM",rem]];
    if(frag&&i>0) order.unshift(["W",4]);
    for(let j=0;j<order.length;j++){
      const st=order[j][0], len=order[j][1];
      if(len<=0.5) continue;
      if(t>=sleepMin) break;
      const l=Math.min(len,sleepMin-t);
      segs.push({stage:st,start:t,len:l}); t+=l;
    }
    i++;
  }
  return segs;
}

function evaluate(p){
  let inBed=(p.wake-p.bed+1440)%1440; if(inBed===0) inBed=1440;
  const sleep=Math.max(0,inBed-p.lat);
  const segs=segments(sleep,p.cycle,p.type);
  const totals={W:0,N1:0,N2:0,N3:0,REM:0};
  segs.forEach(function(s){ totals[s.stage]+=s.len; });
  const asleep=sleep-totals.W;
  const idealDur=idealSleep(p.age), ib=idealBed(p.type,p.age), T=TYPES[p.type];
  const sLen=asleep<=0?0:(asleep<idealDur
    ?100*Math.max(0,1-Math.pow((idealDur-asleep)/270,1.6))
    :100*Math.max(0,1-Math.pow((asleep-idealDur)/300,1.8)));
  const r=sleep%p.cycle, off=Math.min(r,p.cycle-r);
  const sAlign=100*(1-off/(p.cycle/2));
  const clockOff=circDist(p.bed,ib), free=T.tol;
  const sClock=clockOff<=free?100:100*Math.max(0,1-Math.pow((clockOff-free)/180,1.4));
  const remTarget=idealDur*0.22;
  const sRem=100*clamp(totals.REM/remTarget,0,1);
  const score=Math.round(sLen*0.32+sAlign*0.26+sClock*0.27+sRem*0.15);

  let grade,note;
  if(score>=85){ grade="A "+T.name.toLowerCase()+"'s night"; note="Long enough, lands on a cycle edge, and sits inside the window your genes asked for."; }
  else if(score>=70){ grade="Solid night"; note="You'll wake up functional. One lever is off, not three."; }
  else if(score>=50){ grade="Survivable"; note="Enough to work with, but something here is charging interest."; }
  else if(score>=30){ grade="Rough"; note="Short, mistimed, or cut mid-cycle. Expect a slow morning."; }
  else { grade="Brutal"; note="A night you recover from rather than sleep through."; }

  const flags=[];
  if(asleep<360) flags.push("under six hours actually asleep");
  if(off>p.cycle/4) flags.push("the alarm fires "+Math.round(r)+" min into cycle "+(Math.floor(sleep/p.cycle)+1)+" instead of at the edge");
  if(clockOff>free) flags.push("lights out is "+Math.round(clockOff)+" min from your "+T.name.toLowerCase()+" window of "+fmt(ib)+", and only "+free+" of those are free");
  if(totals.REM<remTarget*0.7&&sleep>60) flags.push("REM is short by "+Math.round(remTarget-totals.REM)+" min — it lives in the cycles you cut");
  if(totals.W>8) flags.push(Math.round(totals.W)+" min lost to the awakenings dolphins get between cycles");

  return {name:p.name,type:p.type,bed:p.bed,wake:p.wake,lat:p.lat,cycle:p.cycle,inBed:inBed,
    sleep:sleep,asleep:asleep,segs:segs,totals:totals,score:score,idealBed:ib,idealDur:idealDur,
    clockOff:clockOff,grade:grade,note:note,flags:flags,cycles:Math.floor(sleep/p.cycle),
    parts:[
      {k:"Length",v:sLen,hint:dur(asleep)+" of ~"+dur(idealDur),color:"var(--n2)"},
      {k:"Cycle fit",v:sAlign,hint:Math.round(off)+" min off a "+p.cycle+"-min edge",color:"var(--n1)"},
      {k:"Chronotype fit",v:sClock,hint:T.name+" window "+fmt(ib),color:T.color},
      {k:"Dream time",v:sRem,hint:Math.round(totals.REM)+" min REM of ~"+Math.round(remTarget),color:"var(--rem)"}
    ]};
}

