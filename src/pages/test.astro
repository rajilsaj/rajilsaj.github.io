---
// Chronotype Lab — ported verbatim from the standalone chronotype-lab.html.
// Deliberately NOT wrapped in ~/layouts/Layout.astro: that layout pulls in
// global.css (Tailwind preflight, theme colours, focus rings, body transitions)
// which would fight the tool's own dark palette and typography. The page owns
// its whole document instead.
const title = 'Which Sleeper Are You — Chronotype Lab'
const description =
  'Find your sleep chronotype — lion, bear, wolf or dolphin — and score what your bedtime is doing to you'
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- is:global on purpose: the tool builds most of its DOM at runtime via innerHTML,
         and Astro's scoped-style data-astro-cid-* attributes never reach those nodes. -->
    <style is:global>
/* Space Grotesk, self-hosted (variable, latin subset) instead of the Google Fonts request. */
@font-face{
  font-family:"Space Grotesk";
  font-style:normal;
  font-weight:300 700;
  font-display:swap;
  src:url(/test/space-grotesk-latin-wght.woff2) format("woff2");
}

:root{
  --void:#08131f; --panel:#0f2033; --panel-2:#142c46; --line:#1e3c58;
  --ink:#eaf2f8; --muted:#8aa3b8;
  --lion:#f0a537; --bear:#b8763f; --wolf:#8fa3b8; --dolphin:#4fb8e8;
  --n1:#ffd166; --n2:#2ee6a8; --n3:#47a9f5; --rem:#9b8cff;
  --eeg:#ff6b6b; --eog:#c2d95f; --emg:#5aa9e6; --bad:#ff7a7a; --accent:#2ee6a8;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:
    radial-gradient(900px 520px at 12% -12%, #17385a 0%, transparent 62%),
    radial-gradient(760px 420px at 92% -4%, #123049 0%, transparent 58%),
    var(--void);
  color:var(--ink);
  font-family:"Space Grotesk", ui-sans-serif, system-ui, "Segoe UI", Roboto, sans-serif;
  font-size:16px; line-height:1.55; min-height:100vh; padding:28px 18px 64px;
}
.stars{position:fixed;inset:0;pointer-events:none;z-index:0}
.stars i{position:absolute;width:2px;height:2px;border-radius:50%;background:#cfe6ff;opacity:.22;animation:tw 6s ease-in-out infinite}
@keyframes tw{0%,100%{opacity:.1;transform:scale(.7)}50%{opacity:.65;transform:scale(1)}}
.wrap{position:relative;z-index:1;max-width:860px;margin:0 auto}

.rail{display:flex;gap:6px;margin-bottom:22px}
.rail div{height:3px;flex:1;border-radius:2px;background:rgba(255,255,255,.09);transition:background 500ms}
.rail div.on{background:var(--accent)}
.step{display:none}
.step.active{display:block;animation:enter 460ms cubic-bezier(.2,.9,.3,1) both}
@keyframes enter{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

h1{font-size:clamp(32px,6vw,56px);line-height:1.02;letter-spacing:-.035em;font-weight:700;margin:0 0 14px}
h1 em{font-style:normal;display:block;color:var(--accent)}
h2{font-size:22px;letter-spacing:-.015em;margin:0 0 4px}
p{margin:0 0 14px}
.lede{color:var(--muted);max-width:60ch}
.source{color:var(--muted);font-size:13.5px;border-left:2px solid var(--line);padding-left:14px;margin:22px 0 26px;max-width:66ch}
.source b{color:var(--ink);font-weight:500}

button{font:inherit}
.go{border:none;border-radius:12px;padding:15px 26px;background:var(--accent);color:#052a20;font-weight:700;font-size:17px;cursor:pointer;transition:box-shadow 420ms,transform 160ms}
.go:hover{box-shadow:0 0 34px -8px rgba(46,230,168,.6)}
.go:active{transform:translateY(1px)}
.ghost{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:9px 18px;cursor:pointer;transition:border-color 300ms,color 300ms}
.ghost:hover{border-color:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--n1);outline-offset:2px}

.photo{position:relative;border-radius:50%;overflow:hidden;aspect-ratio:1;border:3px solid var(--c,var(--line));background:#0d1c2c}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.photo .fb{display:none;position:absolute;inset:0}
.photo .fb svg{width:100%;height:100%}
.photo.failed img{display:none}
.photo.failed .fb{display:block}

.herd{display:flex;gap:12px;margin:30px 0;flex-wrap:wrap}
.herd figure{margin:0;text-align:center;flex:1;min-width:130px;border:1px solid var(--line);border-radius:16px;padding:14px 10px;background:rgba(15,32,51,.6)}
.herd .photo{width:86px;margin:0 auto 8px}
.herd figcaption{font-size:13px;color:var(--muted)}
.herd figcaption b{display:block;color:var(--ink);font-size:15px;font-weight:500}
.herd button{background:none;border:none;color:var(--muted);cursor:pointer;font-size:12px;padding:4px;text-decoration:underline}
.herd button:hover{color:var(--ink)}

.qcount{color:var(--muted);font-size:13.5px;margin-bottom:6px;font-variant-numeric:tabular-nums}
.qtext{font-size:clamp(22px,3.6vw,30px);line-height:1.2;letter-spacing:-.02em;font-weight:700;margin:0 0 22px;max-width:23ch}
.opts{display:grid;gap:10px;margin-bottom:22px}
.opt{text-align:left;background:rgba(15,32,51,.7);border:1px solid var(--line);color:var(--ink);border-radius:14px;padding:15px 18px;cursor:pointer;font-size:16px;transition:border-color 260ms,background 260ms,transform 160ms}
.opt:hover{border-color:var(--accent);transform:translateX(3px)}
.opts.binary{grid-template-columns:1fr 1fr;max-width:420px}
.opts.binary .opt{text-align:center;font-weight:500;padding:18px}
.opts.binary .opt:hover{transform:translateY(-2px)}
.qnav{display:flex;gap:10px;align-items:center;flex-wrap:wrap}

.reveal{display:grid;grid-template-columns:210px 1fr;gap:28px;align-items:center;margin-bottom:24px}
.badge{width:210px;justify-self:center;animation:land 900ms cubic-bezier(.2,1.2,.35,1) both;box-shadow:0 0 60px -18px var(--c)}
@keyframes land{from{opacity:0;transform:scale(.62) rotate(-7deg)}to{opacity:1;transform:none}}
.you{font-size:clamp(34px,6vw,52px);line-height:1;letter-spacing:-.03em;font-weight:700;margin:0 0 8px}
.share{color:var(--muted);font-size:14px;margin-bottom:10px}
.schedule{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px}
.schedule div{border-left:2px solid var(--line);padding-left:12px}
.schedule span{display:block;font-size:12.5px;color:var(--muted)}
.schedule b{font-size:19px;font-weight:700;font-variant-numeric:tabular-nums}
.runner{color:var(--muted);font-size:14px;margin-top:16px}
.speak{background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--ink);border-radius:999px;padding:6px 14px;font-size:13.5px;cursor:pointer;margin-right:8px}
.speak:hover{border-color:var(--accent)}
.credit{font-size:12px;color:var(--muted);margin-top:10px}
.credit a{color:var(--muted)}

.panel{border:1px solid var(--line);border-radius:18px;padding:20px;background:linear-gradient(180deg,var(--panel-2),var(--panel));margin-bottom:16px}
.fields{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}
label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
input[type=time],input[type=number],select,input[type=text]{width:100%;background:var(--void);border:1px solid var(--line);color:var(--ink);border-radius:10px;padding:11px 12px;font:inherit;font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--accent)}
.val{color:var(--accent);font-variant-numeric:tabular-nums}
.sliders{display:grid;gap:12px;margin-top:14px}

.verdict{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:16px}
.ring{width:112px;height:112px;flex:0 0 auto}
.ring circle{fill:none;stroke-width:9;stroke-linecap:round}
.ring .track{stroke:rgba(255,255,255,.07)}
.ring .prog{transition:stroke-dashoffset 1200ms cubic-bezier(.2,.8,.2,1)}
.ring text{font-family:inherit;font-weight:700;font-size:28px;fill:var(--ink);text-anchor:middle;font-variant-numeric:tabular-nums}
.grade{font-size:26px;font-weight:700;letter-spacing:-.02em;line-height:1.12}
.gnote{color:var(--muted);font-size:14.5px;margin-top:4px;max-width:40ch}
.mini{width:56px;flex:0 0 auto}

.hyp svg{width:100%;height:auto;display:block;cursor:crosshair}
.hyp .grid{stroke:rgba(255,255,255,.06)}
.hyp .lbl,.hyp .tlbl{fill:var(--muted);font-size:9px;font-family:inherit}
.hyp .tlbl{font-variant-numeric:tabular-nums}
.hyp .trace{fill:none;stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round;transition:stroke-dashoffset 1700ms cubic-bezier(.35,.05,.2,1)}
.hyp .seg{opacity:0;transition:opacity 400ms}
.hyp.go .seg{opacity:1}
.hyp .tick{stroke:rgba(255,255,255,.15);stroke-dasharray:2 4}
.hyp .head{stroke:#fff;stroke-width:1.4;opacity:.85}
.hyp .headdot{fill:#fff}

details{border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:rgba(8,19,31,.5);margin-top:12px}
summary{cursor:pointer;font-size:14.5px;color:var(--muted)}
summary:hover{color:var(--ink)}
.labtop{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:12px 0 8px}
.play{background:rgba(46,230,168,.14);border:1px solid rgba(46,230,168,.4);color:#9df3d3;border-radius:999px;padding:6px 14px;font-size:13.5px;cursor:pointer}
.clockread{font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums}
.clockread b{color:var(--ink);font-weight:500}
.pill{padding:3px 11px;border-radius:999px;font-size:13px;font-weight:500;color:#05202b;background:#2ee6a8}
canvas{width:100%;height:172px;display:block}
.scrub{margin-top:6px}
.chan{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin-top:6px}
.chan span{display:flex;align-items:center;gap:6px}
.chan i{width:14px;height:2px;border-radius:2px}

.split{display:grid;gap:22px;grid-template-columns:190px 1fr;align-items:center;margin-top:20px}
.donut{width:190px;height:190px;justify-self:center}
.donut circle.arc{fill:none;stroke-width:28;transition:stroke-dasharray 1000ms cubic-bezier(.2,.8,.2,1)}
.donut text{font-family:inherit;text-anchor:middle;fill:var(--ink)}
.donut .big{font-size:32px;font-weight:700}
.donut .small{font-size:11px;fill:var(--muted)}
.legend{display:grid;gap:9px;margin:0;padding:0;list-style:none}
.legend li{display:grid;grid-template-columns:12px 1fr auto;gap:10px;align-items:center;font-size:14px}
.dot{width:12px;height:12px;border-radius:3px}
.legend .amt{color:var(--muted);font-variant-numeric:tabular-nums}
.legend small{display:block;color:var(--muted);font-size:11.5px;line-height:1.2}

.bars{margin-top:22px;display:grid;gap:14px}
.bar .top{display:flex;justify-content:space-between;gap:12px;font-size:13.5px;margin-bottom:6px}
.bar .top span:last-child{color:var(--muted);text-align:right;font-variant-numeric:tabular-nums}
.track2{height:7px;border-radius:4px;background:rgba(255,255,255,.07);overflow:hidden}
.fill{height:100%;width:0;border-radius:4px;transition:width 950ms cubic-bezier(.2,.8,.2,1)}

.tips{margin-top:20px;border-top:1px solid var(--line);padding-top:16px}
.tips p{font-size:14px;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:rgba(71,169,245,.12);border:1px solid rgba(71,169,245,.35);color:#bfe0ff;border-radius:999px;padding:7px 13px;font-size:13.5px;cursor:pointer;font-variant-numeric:tabular-nums;transition:background 300ms}
.chip:hover{background:rgba(71,169,245,.26)}

.banner{display:none;border:1px solid var(--line);border-left:4px solid var(--n1);border-radius:12px;padding:14px 18px;background:rgba(255,209,102,.07);margin-top:14px}
.banner.show{display:block;animation:enter 500ms both}
.week{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.night{border:1px solid var(--line);border-radius:10px;padding:8px 12px;font-size:13px;color:var(--muted);cursor:pointer;background:none;transition:all 260ms}
.night.done{background:rgba(46,230,168,.15);border-color:var(--accent);color:var(--ink)}
footer{color:var(--muted);font-size:12.5px;margin-top:30px;max-width:74ch}
footer a{color:var(--muted)}

@media (max-width:760px){.reveal,.split{grid-template-columns:1fr}.badge{width:170px}}
@media (prefers-reduced-motion:reduce){*{animation-duration:1ms!important;transition-duration:1ms!important}}
    </style>
  </head>
  <body>
<div class="stars" id="stars" aria-hidden="true"></div>

<div class="wrap">
  <div class="rail" id="rail" aria-hidden="true"><div class="on"></div><div></div><div></div><div></div></div>

  <section class="step active" id="s1">
    <h1>Four sleepers walk into a night<em>which one are you?</em></h1>
    <p class="lede">Eight questions drawn fresh each time you play, from a bank of <b id="bankSize">many</b>, one animal, then a full readout of what your bedtime is actually doing to you. Sound on if you can — every animal answers when it wins.</p>
    <div class="herd" id="herd"></div>
    <p class="source"><b>Where this comes from.</b> Sleep specialist Dr. Michael Breus proposed the four-animal chronotype framework — lion, bear, wolf, dolphin — in <i>The Power of When</i>, as a more usable way to describe the circadian differences older research files under lark and owl. The schedules and population shares follow his framework as summarised by Mount Sinai's Health Center with Lara Trevino, AGNP-C, MSN, along with the rule this whole tool is built on: your chronotype is largely hard-wired, you can nudge it 30 to 45 minutes, and forcing more than that feels like jet lag you never booked a flight for.</p>
    <button class="go" id="begin">Find my animal</button>
  </section>

  <section class="step" id="s2">
    <p class="qcount" id="qcount"></p>
    <h2 class="qtext" id="qtext"></h2>
    <div class="opts" id="opts"></div>
    <div class="qnav">
      <button class="ghost" id="back">Back</button>
      <button class="ghost" id="restart">New questions</button>
    </div>
  </section>

  <section class="step" id="s3">
    <div class="reveal">
      <div id="badgeSlot"></div>
      <div>
        <p class="qcount">Your chronotype</p>
        <h2 class="you" id="youAre"></h2>
        <p class="share" id="youShare"></p>
        <p class="lede" id="youDesc"></p>
        <div class="schedule" id="youSched"></div>
        <p class="runner" id="youRunner"></p>
        <p style="margin-top:16px">
          <button class="speak" id="callAgain">Hear it again</button>
          <button class="speak" id="muteBtn">Mute sound</button>
        </p>
      </div>
    </div>
    <button class="go" id="toNight">Score my night</button>
    <button class="ghost" id="more" style="display:none">Ask 8 more to be sure</button>
    <button class="ghost" id="redo">Start again</button>
    <p class="credit" id="credit"></p>
  </section>

  <section class="step" id="s4">
    <div class="panel">
      <div class="fields">
        <div><label for="bed">Lights out</label><input type="time" id="bed"></div>
        <div><label for="wake">Alarm</label><input type="time" id="wake"></div>
        <div><label for="age">Age</label><input type="number" id="age" min="10" max="95" value="32"></div>
        <div><label for="chrono">Chronotype</label>
          <select id="chrono">
            <option value="lion">Lion</option><option value="bear">Bear</option>
            <option value="wolf">Wolf</option><option value="dolphin">Dolphin</option>
          </select>
        </div>
      </div>
      <div class="sliders">
        <div><label for="lat">Minutes to fall asleep — <span class="val" id="latV">15</span></label><input type="range" id="lat" min="0" max="60" step="5" value="15"></div>
        <div><label for="cyc">Cycle length — <span class="val" id="cycV">90</span> min</label><input type="range" id="cyc" min="80" max="110" step="5" value="90"></div>
      </div>
      <p class="share" id="windowLine" style="margin-top:14px"></p>
    </div>

    <div class="panel" id="card"></div>

    <div class="panel">
      <h2>Challenge a colleague</h2>
      <p class="lede" style="font-size:14.5px">Same model, their animal. Highest score takes it, and the winner gets the last word.</p>
      <div class="fields">
        <div><label for="cName">Name</label><input type="text" id="cName" value="Colleague"></div>
        <div><label for="cChrono">Their chronotype</label>
          <select id="cChrono">
            <option value="lion">Lion</option><option value="bear">Bear</option>
            <option value="wolf" selected>Wolf</option><option value="dolphin">Dolphin</option>
          </select>
        </div>
        <div><label for="cBed">Lights out</label><input type="time" id="cBed" value="01:15"></div>
        <div><label for="cWake">Alarm</label><input type="time" id="cWake" value="06:40"></div>
        <div><label for="cAge">Age</label><input type="number" id="cAge" min="10" max="95" value="29"></div>
      </div>
      <div class="banner" id="banner"></div>
      <p style="margin-top:14px"><button class="go" id="fight">Compare nights</button></p>
    </div>

    <div class="panel">
      <h2>The seven-night challenge</h2>
      <p class="lede" id="challengeLine" style="font-size:14.5px"></p>
      <div class="week" id="week"></div>
      <p class="lede" style="font-size:14px;margin-top:14px">Hold the window for a week before judging it. If it fights you, shift both ends by half an hour — not more, or you're back to jet lag. Phone out of reach, no caffeine after midday, room cold and properly dark.</p>
    </div>

    <button class="ghost" id="redo2">New questions</button>
  </section>

  <footer>
    A model, not a sleep study. Cycles are treated as ~90 minutes, deep sleep is weighted early and REM late, and the dolphin profile is modelled with brief awakenings between cycles. Animal framework after Dr. Michael Breus; schedules per Mount Sinai's Health Center summary. Photographs from Wikimedia Commons; animal calls are synthesised in your browser, not recordings. If sleep is genuinely a problem, that's a conversation for a clinician rather than a web page.
  </footer>
</div>

    <!-- is:inline on purpose: plain DOM IIFE, no imports, must not go through the bundler. -->
    <script is:inline>
(function(){
"use strict";

/* ===== photos (Wikimedia Commons, stable file paths) + drawn fallbacks ===== */
/* Self-hosted copies of the Wikimedia Commons files (public/test/). `file` keeps the Commons name for attribution. */
const PHOTO = {
  lion:{src:"/test/lion.jpg", file:"Lion waiting in Namibia.jpg"},
  bear:{src:"/test/bear.jpg", file:"2010-brown-bear.jpg"},
  wolf:{src:"/test/wolf.jpg", file:"Grey wolf P1130270.jpg"},
  dolphin:{src:"/test/dolphin.jpg", file:"Bottlenose dolphin with young.JPG"}
};
const ART = {
  lion:'<svg viewBox="0 0 120 120">'+
    (function(){let s="";for(let i=0;i<12;i++){const a=i/12*Math.PI*2;s+='<circle cx="'+(60+Math.cos(a)*29).toFixed(1)+'" cy="'+(60+Math.sin(a)*29).toFixed(1)+'" r="14" fill="#c97f2a"/>';}return s;})()+
    '<circle cx="60" cy="60" r="30" fill="#f0a537"/><circle cx="44" cy="42" r="8" fill="#e08d2c"/><circle cx="76" cy="42" r="8" fill="#e08d2c"/>'+
    '<ellipse cx="60" cy="72" rx="17" ry="13" fill="#ffd9a0"/><path d="M52 66 L68 66 L60 74 Z" fill="#3b2412"/>'+
    '<circle cx="49" cy="54" r="3.4" fill="#3b2412"/><circle cx="71" cy="54" r="3.4" fill="#3b2412"/></svg>',
  bear:'<svg viewBox="0 0 120 120">'+
    '<circle cx="34" cy="34" r="15" fill="#8a5730"/><circle cx="34" cy="34" r="7" fill="#c48a5c"/>'+
    '<circle cx="86" cy="34" r="15" fill="#8a5730"/><circle cx="86" cy="34" r="7" fill="#c48a5c"/>'+
    '<circle cx="60" cy="64" r="33" fill="#b8763f"/><ellipse cx="60" cy="78" rx="20" ry="15" fill="#e5c39c"/>'+
    '<ellipse cx="60" cy="70" rx="7" ry="5.5" fill="#3b2412"/>'+
    '<circle cx="47" cy="56" r="3.6" fill="#3b2412"/><circle cx="73" cy="56" r="3.6" fill="#3b2412"/></svg>',
  wolf:'<svg viewBox="0 0 120 120">'+
    '<path d="M30 24 L46 46 L26 54 Z" fill="#6f8398"/><path d="M90 24 L74 46 L94 54 Z" fill="#6f8398"/>'+
    '<path d="M32 46 Q60 32 88 46 L84 74 L60 96 L36 74 Z" fill="#8fa3b8"/>'+
    '<path d="M48 70 L72 70 L60 94 Z" fill="#d7e2ec"/><ellipse cx="60" cy="80" rx="5.5" ry="4.2" fill="#22303d"/>'+
    '<path d="M42 56 L54 59 L42 62 Z" fill="#22303d"/><path d="M78 56 L66 59 L78 62 Z" fill="#22303d"/></svg>',
  dolphin:'<svg viewBox="0 0 120 120">'+
    '<path d="M14 62 Q22 34 52 28 Q80 23 104 40 Q92 42 86 50 Q76 74 46 80 Q26 82 14 62 Z" fill="#4fb8e8"/>'+
    '<path d="M54 30 Q60 14 74 8 Q68 20 68 33 Z" fill="#3a9fd0"/><path d="M16 60 Q6 60 2 48 Q12 54 20 52 Z" fill="#3a9fd0"/>'+
    '<path d="M30 74 Q48 84 70 62 Q54 78 30 74 Z" fill="#bfe6f7"/><circle cx="88" cy="43" r="3" fill="#123044"/></svg>'
};
function photoHTML(key, cls){
  const T=TYPES[key];
  return '<div class="photo '+(cls||"")+'" style="--c:'+T.color+'">'+
    '<img src="'+PHOTO[key].src+'" alt="'+T.name+'" loading="lazy" '+
    'onerror="this.closest(\'.photo\').classList.add(\'failed\')">'+
    '<div class="fb">'+ART[key]+'</div></div>';
}

const TYPES = {
