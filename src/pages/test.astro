function drawHyp(card,d){
  const NS="http://www.w3.org/2000/svg";
  const grid=card.querySelector(".tGrid"), ticks=card.querySelector(".tTicks"),
        segsG=card.querySelector(".tSegs"), trace=card.querySelector(".tTrace");
  grid.innerHTML=""; ticks.innerHTML=""; segsG.innerHTML="";
  const span=W-PADL-PADR;
  const x=t=>PADL+(d.sleep?(t/d.sleep)*span:0);
  Object.keys(LEVEL).forEach(function(st){
    const l=document.createElementNS(NS,"line");
    l.setAttribute("x1",PADL); l.setAttribute("x2",W-PADR);
    l.setAttribute("y1",LEVEL[st]); l.setAttribute("y2",LEVEL[st]);
    l.setAttribute("class","grid"); grid.appendChild(l);
    const tx=document.createElementNS(NS,"text");
    tx.setAttribute("x",2); tx.setAttribute("y",LEVEL[st]+3);
    tx.setAttribute("class","lbl"); tx.textContent=st; grid.appendChild(tx);
  });
  for(let c=d.cycle;c<d.sleep;c+=d.cycle){
    const l=document.createElementNS(NS,"line");
    l.setAttribute("x1",x(c)); l.setAttribute("x2",x(c));
    l.setAttribute("y1",8); l.setAttribute("y2",126);
    l.setAttribute("class","tick"); ticks.appendChild(l);
    const tl=document.createElementNS(NS,"text");
    tl.setAttribute("x",x(c)); tl.setAttribute("y",5);
    tl.setAttribute("class","tlbl"); tl.setAttribute("text-anchor","middle");
    tl.textContent=fmt(d.bed+d.lat+c); ticks.appendChild(tl);
  }
  d.segs.forEach(function(s,i){
    const r=document.createElementNS(NS,"rect");
    r.setAttribute("x",x(s.start)); r.setAttribute("y",136);
    r.setAttribute("width",Math.max(0.6,x(s.start+s.len)-x(s.start)));
    r.setAttribute("height",9); r.setAttribute("rx",1.5);
    r.setAttribute("fill",STAGES[s.stage].raw); r.setAttribute("class","seg");
    r.style.transitionDelay=(i*40)+"ms"; segsG.appendChild(r);
  });
  let dd="";
  d.segs.forEach(function(s,i){
    const y=LEVEL[s.stage];
    dd+=(i===0?"M "+x(s.start)+" "+y:" L "+x(s.start)+" "+y);
    dd+=" L "+x(s.start+s.len)+" "+y;
  });
  trace.setAttribute("d",dd||"M "+PADL+" 86");
  trace.setAttribute("stroke",scoreColor(d.score));
  const len=trace.getTotalLength();
  trace.style.transition="none";
  trace.style.strokeDasharray=len; trace.style.strokeDashoffset=len;
  void trace.getBoundingClientRect();
  trace.style.transition="";
  requestAnimationFrame(function(){
    trace.style.strokeDashoffset=0;
    card.querySelector(".hyp").classList.add("go");
  });
  return x;
}

function drawDonut(card,d){
  const NS="http://www.w3.org/2000/svg", g=card.querySelector(".tArcs");
  g.innerHTML="";
  const r=70, C=2*Math.PI*r; let offset=0;
  ["N1","N2","N3","REM","W"].forEach(function(st,i){
    const frac=d.sleep?d.totals[st]/d.sleep:0;
    if(frac<=0) return;
    const c=document.createElementNS(NS,"circle");
    c.setAttribute("class","arc"); c.setAttribute("cx",100); c.setAttribute("cy",100); c.setAttribute("r",r);
    c.setAttribute("stroke",STAGES[st].raw); c.setAttribute("transform","rotate(-90 100 100)");
    c.style.strokeDasharray="0 "+C; c.style.strokeDashoffset=-offset;
    c.style.transitionDelay=(i*130)+"ms"; g.appendChild(c);
    const seg=frac*C;
    requestAnimationFrame(function(){ c.style.strokeDasharray=Math.max(0,seg-1.5)+" "+C; });
    offset+=seg;
  });
  countUp(card.querySelector(".tCycles"),d.cycles);
  const ul=card.querySelector(".tLegend"); ul.innerHTML="";
  ["N3","REM","N2","N1","W"].forEach(function(st){
    if(d.totals[st]<=0) return;
    const pct=d.sleep?Math.round(100*d.totals[st]/d.sleep):0;
    const li=document.createElement("li");
    li.innerHTML='<span class="dot" style="background:'+STAGES[st].raw+'"></span>'+
      '<span><b>'+st+'</b><small>'+STAGES[st].note+'</small></span>'+
      '<span class="amt">'+dur(d.totals[st])+' \u00b7 '+pct+'%</span>';
    ul.appendChild(li);
  });
}

