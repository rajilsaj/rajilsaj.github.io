/* ===== quiz ===== */
let deck=[], qi=0, tally={lion:0,bear:0,wolf:0,dolphin:0}, picks=[], myType="bear";

function newDeck(){
  deck=drawQuestions(QCOUNT);
  qi=0; tally={lion:0,bear:0,wolf:0,dolphin:0}; picks=[];
}
function renderQ(){
  const q=deck[qi];
  el("qcount").textContent="Question "+(qi+1)+" of "+deck.length+" \u00b7 "+DIMS[q.dim];
  el("qtext").textContent=q.q;
  const box=el("opts"); box.innerHTML="";
  box.className = q.a.length===2 ? "opts binary" : "opts";
  q.a.forEach(function(pair,i){
    const b=document.createElement("button");
    b.className="opt"; b.textContent=pair[0];
    b.style.animation="enter "+(220+i*70)+"ms both";
    b.addEventListener("click",function(){ answer(pair[1]); });
    box.appendChild(b);
  });
  el("back").style.visibility=qi===0?"hidden":"visible";
}
function answer(pts){
  picks[qi]=pts;
  Object.keys(pts).forEach(function(k){ tally[k]+=pts[k]; });
  qi++;
  if(qi<deck.length) renderQ(); else finish();
}
el("back").addEventListener("click",function(){
  if(qi===0) return;
  qi--;
  const p=picks[qi]||{};
  Object.keys(p).forEach(function(k){ tally[k]-=p[k]; });
  renderQ();
});
function startQuiz(){ newDeck(); renderQ(); showStep(2); }
["begin","restart","redo","redo2"].forEach(function(id){ el(id).addEventListener("click",startQuiz); });

function finish(){
  const rank=Object.keys(tally).sort(function(a,b){ return tally[b]-tally[a]; });
  myType=rank[0];
  const T=TYPES[myType];
  el("badgeSlot").innerHTML=photoHTML(myType,"badge");
  el("youAre").textContent="You're a "+T.name;
  el("youAre").style.color=T.color;
  el("youShare").textContent=T.share+".";
  el("youDesc").textContent=T.desc;
  el("youSched").innerHTML='<div><span>Wake up</span><b>'+T.wake+'</b></div>'+
    '<div><span>Best hours</span><b>'+T.peak+'</b></div>'+
    '<div><span>Bedtime</span><b>'+T.bed+'</b></div>';
  const second=rank[1];
  let total=0; Object.keys(tally).forEach(function(k){ total+=tally[k]; });
  const margin=total ? (tally[rank[0]]-tally[second])/total : 0;
  const pct=function(k){ return total?Math.round(100*tally[k]/total):0; };
  const level = margin>=0.22 ? "high" : (margin>=0.10 ? "moderate" : "low");
  el("youRunner").textContent = level==="high"
    ? "Confidence high — "+pct(rank[0])+"% of your points went to "+T.name.toLowerCase()+", against "+pct(second)+"% for "+TYPES[second].name.toLowerCase()+". "+deck.length+" questions across "+Object.keys(DIMS).length+" areas."
    : (level==="moderate"
      ? "Confidence moderate — "+pct(rank[0])+"% "+T.name.toLowerCase()+" against "+pct(second)+"% "+TYPES[second].name.toLowerCase()+". Real enough to act on, close enough to be worth another round."
      : "Confidence low — "+pct(rank[0])+"% against "+pct(second)+"%. You sit between "+T.name.toLowerCase()+" and "+TYPES[second].name.toLowerCase()+", which is common. Another eight questions would settle it.");
  el("more").style.display = level==="high" ? "none" : "inline-block";
  el("credit").innerHTML='Photograph: <a href="https://commons.wikimedia.org/wiki/File:'+
    encodeURIComponent(PHOTO[myType].file.replace(/ /g,"_"))+'" target="_blank" rel="noopener">'+
    PHOTO[myType].file+'</a>, Wikimedia Commons. The call is synthesised in your browser.';
  el("chrono").value=myType;
  el("bed").value=T.bed;
  el("wake").value=T.wake;
  showStep(3);
  setTimeout(function(){ Calls.play(myType); }, 420);
}
el("more").addEventListener("click",function(){
  drawQuestions(QCOUNT).forEach(function(q){ deck.push(q); });
  renderQ(); showStep(2);
});
el("callAgain").addEventListener("click",function(){ Calls.play(myType); });
el("muteBtn").addEventListener("click",function(){
  el("muteBtn").textContent = Calls.toggle() ? "Sound off" : "Mute sound";
});
