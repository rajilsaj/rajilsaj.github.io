  .kp-bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--kp-h3), var(--kp-teal)); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .kp-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
