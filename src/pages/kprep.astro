  .kp-formula code { font-family: inherit; font-weight: 600; color: var(--kp-ink); }

  /* heatmap */
  .kp-legend { font-size: 0.72rem; color: var(--kp-muted); display: inline-flex; align-items: center; gap: 3px; }
  .kp-legend i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  .kp-legend i.miss { margin-left: 6px; }
  .kp-heat-scroll { overflow-x: auto; padding-bottom: 4px; }
  .kp-heat-months { display: grid; grid-auto-flow: column; grid-auto-columns: 13px; margin-left: 30px; height: 16px; font-size: 0.66rem; color: var(--kp-muted); }
  .kp-heat-months span { white-space: nowrap; }
  .kp-heat-body { display: flex; gap: 4px; }
  .kp-heat-days { display: grid; grid-template-rows: repeat(7, 11px); gap: 2px; width: 26px; font-size: 0.6rem; color: var(--kp-muted); line-height: 11px; }
  .kp-heat { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 11px); grid-auto-columns: 11px; gap: 2px; }
  .kp-heat button, .kp-heat .pad { width: 11px; height: 11px; padding: 0; border-radius: 2px; border: 0; }
  .kp .kp-heat button { border: 0; padding: 0; border-radius: 2px; }
  .kp-heat .pad { visibility: hidden; }
  .kp .l0, .kp .kp-heat .l0 { background: var(--kp-h0); }
  .kp .l1, .kp .kp-heat .l1 { background: var(--kp-h1); }
  .kp .l2, .kp .kp-heat .l2 { background: var(--kp-h2); }
  .kp .l3, .kp .kp-heat .l3 { background: var(--kp-h3); }
  .kp .l4, .kp .kp-heat .l4 { background: var(--kp-h4); }
  .kp .miss, .kp .kp-heat .miss { background: color-mix(in srgb, var(--kp-red) 45%, var(--kp-h0)); }
  .kp .kp-heat .future { opacity: 0.55; }
  .kp .kp-heat .test { background: var(--kp-amber); opacity: 1; }
  .kp .kp-heat .today { outline: 2px solid var(--kp-ink); outline-offset: 1px; }
  .kp .kp-heat .sel { box-shadow: 0 0 0 2px var(--kp-teal); }
  .kp .kp-heat button:hover { transform: scale(1.35); background-color: var(--kp-teal); }
  .kp .kp-heat button:focus-visible { outline: 2px solid var(--kp-teal); outline-offset: 1px; border-radius: 2px; }

  /* phases */
  .kp-phases { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; counter-reset: ph; }
  .kp-phases li { counter-increment: ph; display: grid; grid-template-columns: 32px 1fr auto; gap: 4px 12px; align-items: center; padding: 10px 12px; border: 1px solid var(--kp-line); border-radius: 12px; }
  .kp-phases li::before { content: counter(ph); grid-row: span 3; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.85rem; background: var(--kp-h0); color: var(--kp-muted); }
  .kp-phases li.now { border-color: var(--kp-teal); background: var(--kp-teal-soft); }
  .kp-phases li.now::before { background: var(--kp-teal); color: var(--kp-teal-ink); }
  .kp-phases li.past::before { content: '✓'; background: var(--kp-h2); color: var(--kp-teal-ink); }
  .kp-ph-name { font-weight: 650; }
  .kp-ph-name em { font-style: normal; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--kp-teal); margin-left: 6px; }
  .kp-ph-pct { font-weight: 700; font-size: 0.9rem; grid-row: span 2; }
  .kp-ph-meta { color: var(--kp-muted); font-size: 0.82rem; }
  .kp-ph-bar { grid-column: 2 / 4; height: 5px; border-radius: 999px; background: var(--kp-h0); overflow: hidden; }
  .kp-ph-bar i { display: block; height: 100%; background: var(--kp-teal); }

  /* scores + settings forms */
  .kp-score-form, .kp-set-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: 8px; align-items: end; }
  .kp-score-form label, .kp-set-form label { display: grid; gap: 4px; font-size: 0.78rem; color: var(--kp-muted); font-weight: 550; }
  .kp-score-form input, .kp-set-form input { width: 100%; min-width: 0; padding: 8px 10px; border: 1px solid var(--kp-line); border-radius: 10px; background: var(--kp-bg); color: var(--kp-ink); font-size: 0.95rem; }
  .kp-table-scroll { overflow-x: auto; }
  .kp-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .kp-table th, .kp-table td { padding: 8px 6px; text-align: right; border-bottom: 1px solid var(--kp-line); white-space: nowrap; }
  .kp-table th:first-child, .kp-table td:first-child { text-align: left; }
  .kp-table th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--kp-muted); font-weight: 600; }
  .kp-table tfoot td { font-weight: 700; border-bottom: 0; }
  .kp-table td.hit { color: var(--kp-teal); font-weight: 650; }
  .kp-table td.empty { color: var(--kp-muted); text-align: center; padding: 16px; }
  .kp .kp-table button { padding: 2px 8px; font-size: 0.8rem; border-radius: 8px; }
  .kp-set-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .kp-file { position: relative; display: inline-flex; align-items: center; }
  .kp-file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .kp-file:focus-within { outline: 3px solid var(--kp-teal); outline-offset: 2px; }
  .kp .kp-file.disabled { opacity: 0.4; pointer-events: none; }
  .kp-unlock { border-top: 1px solid var(--kp-line); padding-top: 12px; display: grid; gap: 8px; }
  .kp-unlock[hidden], .kp-unlock [hidden] { display: none; }
  .kp-unlock h3 { margin: 0; font-size: 0.92rem; font-weight: 650; }
  .kp-unlock label { display: grid; gap: 2px; font-size: 0.85rem; font-weight: 550; }
  .kp-unlock label span { font-weight: 400; color: var(--kp-muted); font-size: 0.8rem; }
  .kp-unlock-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .kp-unlock-row p { margin: 0; font-size: 0.88rem; color: var(--kp-teal); font-weight: 550; flex: 1; }
  .kp-unlock input { flex: 1; min-width: 0; padding: 8px 10px; border: 1px solid var(--kp-line); border-radius: 10px; background: var(--kp-bg); color: var(--kp-ink); font-size: 0.95rem; }
  .kp-readonly .kp-task label { cursor: default; }

  .kp-toast { position: fixed; left: 50%; bottom: 20px; transform: translate(-50%, 20px); background: var(--kp-ink); color: var(--kp-bg); padding: 10px 16px; border-radius: 999px; font-size: 0.88rem; font-weight: 550; opacity: 0; pointer-events: none; transition: all 0.25s; z-index: 50; max-width: calc(100vw - 32px); text-align: center; }
  .kp-toast.show { opacity: 1; transform: translate(-50%, 0); }

  .kp-confetti { position: fixed; top: 0; width: 8px; height: 12px; border-radius: 2px; pointer-events: none; z-index: 60; animation: kp-fall 1.4s cubic-bezier(0.3, 0.6, 0.6, 1) forwards; }
  @keyframes kp-fall { to { transform: translate(var(--dx), 105vh) rotate(var(--r)); opacity: 0.8; } }

  @media (max-width: 640px) {
    .kp-mon-clock { display: none; }
    .kp { padding: 12px; margin-inline: -8px; gap: 12px; }
    .kp-card { padding: 14px; }
    .kp-vitals { grid-template-columns: repeat(2, 1fr); row-gap: 12px; }
    .kp-vital dd { font-size: 1.6rem; }
    .kp-tiles { grid-template-columns: repeat(2, 1fr); }
    .kp-ecg-wrap { height: 100px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kp *, .kp *::before, .kp *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const KEY = 'kprep-v1'
  const TOKEN_KEY = 'kprep-token'
  const API = (document.getElementById('kp')?.dataset.api || '').trim()
  const START = '2026-11-02'
  const MIN_TEST = '2027-06-10'
  const PHASES = [
    { name: 'Baseline', start: '2026-11-02', goal: 'Know the starting score per section.' },
    { name: 'Reading habit', start: '2026-11-16', goal: 'Read daily and build vocabulary.' },
    { name: 'Writing and grammar', start: '2027-01-11', goal: '80% on untimed writing sets.' },
    { name: 'Science review', start: '2027-02-22', goal: 'One summary sheet per body system.' },
    { name: 'Math tune-up', start: '2027-04-26', goal: '90% on math sets.' },
    { name: 'Timed practice', start: '2027-05-17', goal: 'Finish every section on time.' },
    { name: 'Simulation and taper', start: '2027-06-07', goal: 'Above target on two full practice tests.' },
  ]
  const GRAMMAR = ['commas', 'subject-verb agreement', 'pronouns', 'modifiers', 'parallel structure', 'apostrophes', 'verb tenses', 'sentence order in a paragraph', 'run-ons and fragments']
  const SYSTEMS = ['cardiovascular', 'respiratory', 'gastrointestinal', 'renal and urinary', 'fluids and electrolytes', 'endocrine', 'neurological', 'musculoskeletal', 'immune and reproductive']
  const SECTIONS = ['reading', 'math', 'writing', 'science']
  const LABEL = { reading: 'Reading', math: 'Math', writing: 'Writing', science: 'Science' }

  // ---------- dates (local YYYY-MM-DD, never UTC) ----------
  const pad = (n) => String(n).padStart(2, '0')
  const iso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
  const parse = (s) => {
    const [y, m, d] = s.split('-').map(Number)
    return new Date(y, m - 1, d, 12)
  }
  const addDays = (s, n) => {
    const d = parse(s)
    d.setDate(d.getDate() + n)
    return iso(d)
  }
  const between = (a, b) => Math.round((parse(b).getTime() - parse(a).getTime()) / 86400000)
  const weekday = (s) => parse(s).getDay()
  const today = () => iso(new Date())
  const fmt = (s, o) => parse(s).toLocaleDateString('en-US', o)
  const fmtLong = (s) => fmt(s, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })
  const fmtShort = (s) => fmt(s, { month: 'short', day: 'numeric' })
  const isDate = (s) => typeof s === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(s)

  // ---------- state ----------
  // checks: { date: [task text] }, scores + settings form the "meta" synced as one row.
  // queue: pending writes ({ type: 'day', date } | { type: 'meta' }); values are read
  // from the current state when sent, so the latest change always wins.
  const defaultSettings = () => ({ testDate: '2027-07-01', target: 80, vocabGoal: 1500 })
  const defaults = () => ({ checks: {}, scores: [], settings: defaultSettings(), queue: [], metaEdited: false })
  function cleanSettings(s) {
    const d = defaultSettings()
    const set = { ...d, ...(s && typeof s === 'object' ? s : {}) }
    if (!isDate(set.testDate) || set.testDate < MIN_TEST) set.testDate = d.testDate
    set.target = Number(set.target) > 0 ? Math.min(100, Number(set.target)) : d.target
    set.vocabGoal = Number(set.vocabGoal) > 0 ? Number(set.vocabGoal) : d.vocabGoal
    return { testDate: set.testDate, target: set.target, vocabGoal: set.vocabGoal }
  }
  const cleanScores = (a) => (Array.isArray(a) ? a.filter((x) => x && isDate(x.date)) : [])
  const cleanDone = (a) => (Array.isArray(a) ? a.filter((x) => typeof x === 'string') : [])
  function normalize(s) {
    if (!s || typeof s !== 'object') return defaults()
    const checks = {}
    if (s.checks && typeof s.checks === 'object') {
      for (const k in s.checks) {
        const v = cleanDone(s.checks[k])
        if (isDate(k) && v.length) checks[k] = v
      }
    }
    const queue = Array.isArray(s.queue) ? s.queue.filter((q) => q && (q.type === 'meta' || (q.type === 'day' && isDate(q.date)))) : []
    return { checks, scores: cleanScores(s.scores), settings: cleanSettings(s.settings), queue, metaEdited: !!s.metaEdited }
  }
  function load() {
    try {
      const raw = localStorage.getItem(KEY)
      if (raw) return normalize(JSON.parse(raw))
    } catch (e) {}
    return defaults()
  }
  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify(state))
    } catch (e) {
      toast("Couldn't save in this browser. Export a backup to keep your progress.")
    }
  }
  function getToken() {
    try {
      return localStorage.getItem(TOKEN_KEY) || ''
    } catch (e) {
      return ''
    }
  }
  function setToken(t) {
    try {
      t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY)
    } catch (e) {}
    token = t
  }
  let state = load()
  let token = getToken()
  // Editing is allowed when there's no backend at all, or when this device holds the token.
  const canEdit = () => !API || !!token

  // ---------- plan ----------
  function plan() {
    const test = state.settings.testDate
    const last = addDays(test, -1)
    const total = between(START, test)
    const phases = PHASES.map((p, i) => ({ ...p, end: i < PHASES.length - 1 ? addDays(PHASES[i + 1].start, -1) : last }))
    return { test, last, total, phases }
  }
  const phaseIndex = (date, P) => {
    let i = 0
    P.phases.forEach((p, k) => {
      if (date >= p.start) i = k
    })
    return i
  }
  const T = (text, words = 0) => ({ text, words })

  function tasksFor(date, P) {
    if (date < START || date > P.last) return []
    if (date === START) return [T('Take a full timed practice test'), T('Enter your section scores in the log'), T('Set up your vocab deck and error log')]
    if (between(date, P.test) <= 2) return [T('Light vocab review only'), T('Rest and go to sleep early')]
    const pi = phaseIndex(date, P)
    const ph = P.phases[pi]
    const inPhase = between(ph.start, date)
    const sat = weekday(date) === 6
    const sun = weekday(date) === 0
    const section = ['Reading', 'Math', 'Writing', 'Science'][between(START, date) % 4]
    let list
    switch (pi) {
      case 0:
        list = [T('Learn 10 new words with roots', 10), T('Read one short article and summarize it in one sentence'), T('Do 10 practice questions')]
        break
      case 1:
        list = [T('Learn 10 new words', 10), T('Read one health or science article and summarize it in one sentence'), sat ? T('Do a Kaplan reading set, untimed') : T('Note 3 unknown words from the article')]
        break
      case 2:
        list = [T('Learn 10 new words', 10), T('Read for 10 minutes'), T(`Grammar topic: ${GRAMMAR[Math.floor(inPhase / 5) % GRAMMAR.length]}, plus 10 writing questions`)]
        break
      case 3:
        list = [T('Review vocab and learn 5 new words', 5), T('Read for 10 minutes'), T(`Body system of the week: write the ${SYSTEMS[Math.floor(inPhase / 7) % SYSTEMS.length]} summary sheet`)]
        break
      case 4:
        list = [T('Review vocab'), T('Read for 10 minutes'), T('Do 15 problems: conversions, ratios, dosage')]
        break
      case 5:
        list = [T('Review vocab'), T(`Timed ${section} section`), T('Log every mistake in the error log')]
        break
      default:
        list = sat ? [T('Review vocab'), T('Take a full timed practice test'), T('Enter your scores in the log')] : [T('Review vocab'), T(`Timed ${section} section`)]
        list.push(T('Review the error log'))
    }
    if (sun && pi <= 4) list.push(T('Review the error log'))
    return list
  }

  // ---------- derived numbers ----------
  function compute() {
    const P = plan()
    const now = today()
    const days = []
    let sum = 0
    let expected = 0
    let done = 0
    let words = 0
    for (let i = 0; i < P.total; i++) {
      const date = addDays(START, i)
      const tasks = tasksFor(date, P)
      const checked = state.checks[date] || []
      const hit = tasks.filter((t) => checked.includes(t.text))
      const f = tasks.length ? hit.length / tasks.length : 0
      words += hit.reduce((n, t) => n + t.words, 0)
      days.push({ date, tasks, f, i })
      sum += f
      if (date < now) {
        expected++
        done += f
      } else if (date === now) done += f
    }
    const fOf = (d) => (d >= START && d <= P.last ? days[between(START, d)].f : 0)
    let streak = 0
    let d = fOf(now) === 1 ? now : addDays(now, -1)
    while (d >= START && fOf(d) === 1) {
      streak++
      d = addDays(d, -1)
    }
    const latest = {}
    const sorted = [...state.scores].sort((a, b) => (a.date === b.date ? (a.id || 0) - (b.id || 0) : a.date.localeCompare(b.date)))
    for (const s of sorted) for (const k of SECTIONS) if (typeof s[k] === 'number') latest[k] = s[k]
    const target = state.settings.target
    const planPct = sum / P.total
    const vocabPct = Math.min(1, words / state.settings.vocabGoal)
    const practicePct = SECTIONS.reduce((n, k) => n + (k in latest ? Math.min(1, latest[k] / target) : 0), 0) / 4
    const readiness = 35 * planPct + 25 * vocabPct + 40 * practicePct
    return { P, now, days, streak, words, latest, planPct, vocabPct, practicePct, readiness, behind: expected - done }
  }

  // ---------- helpers ----------
  const $ = (s) => document.querySelector(s)
  const el = (tag, cls, html) => {
    const e = document.createElement(tag)
    if (cls) e.className = cls
    if (html != null) e.innerHTML = html
    return e
  }
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let toastTimer
  function toast(msg) {
    const t = $('#kp-toast')
    t.textContent = msg
    t.classList.add('show')
    clearTimeout(toastTimer)
    toastTimer = setTimeout(() => t.classList.remove('show'), 2800)
  }
  function confetti() {
    if (reduced) return
    const colors = ['#3be0a0', '#1f7a6c', '#f2f7a1', '#7fd8ff', '#ffb8e0']
    for (let i = 0; i < 40; i++) {
      const c = el('i', 'kp-confetti')
      c.style.left = Math.random() * 100 + 'vw'
      c.style.background = colors[i % colors.length]
      c.style.setProperty('--dx', (Math.random() - 0.5) * 200 + 'px')
      c.style.setProperty('--r', Math.random() * 720 + 'deg')
      c.style.animationDelay = Math.random() * 0.3 + 's'
      document.body.appendChild(c)
      setTimeout(() => c.remove(), 2000)
    }
  }
  function countUp(node, to, decimals = 0) {
    const from = Number(node.dataset.v || 0)
    node.dataset.v = String(to)
    if (reduced || from === to) {
      node.textContent = to.toFixed(decimals)
      return
    }
    const t0 = performance.now()
    const step = (t) => {
      const k = Math.min(1, (t - t0) / 900)
      const e = 1 - Math.pow(1 - k, 3)
      node.textContent = (from + (to - from) * e).toFixed(decimals)
      if (k < 1) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  }

  // ---------- sync with the Apps Script web app ----------
  const SYNC_TEXT = { local: 'Saved in this browser', saved: 'Saved', syncing: 'Syncing…', offline: 'Offline, will retry', readonly: 'Read-only' }
  function setSync(s) {
    const chip = $('#kp-sync')
    chip.dataset.s = s
    $('#kp-sync-txt').textContent = SYNC_TEXT[s]
  }
  function idleStatus() {
    if (!API) return 'local'
    if (!token) return 'readonly'
    return state.queue.length ? 'offline' : 'saved'
  }
  const metaOf = (s) => ({ ...s.settings, scores: s.scores })
  function enqueue(op) {
    if (!API || !token) return
    if (op.type === 'meta') {
      state.metaEdited = true
      if (!state.queue.some((q) => q.type === 'meta')) state.queue.push(op)
    } else if (!state.queue.some((q) => q.type === 'day' && q.date === op.date)) state.queue.push(op)
    save()
    flushSoon()
  }
  async function post(body) {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ ...body, token }),
    })
    if (!res.ok) throw new Error(`HTTP ${res.status}`)
    return res.json()
  }
  let flushing = false
  let retryTimer = 0
  let backoff = 0
  function flushSoon(delay = 0) {
    clearTimeout(retryTimer)
    retryTimer = setTimeout(flush, delay)
  }
  async function flush() {
    if (!API || !token || flushing) return setSync(idleStatus())
    if (!state.queue.length) return setSync('saved')
    if (!navigator.onLine) return setSync('offline')
    flushing = true
    setSync('syncing')
    try {
      while (state.queue.length && token) {
        const op = state.queue[0]
        const body = op.type === 'day' ? { type: 'day', date: op.date, done: state.checks[op.date] || [] } : { type: 'meta', meta: metaOf(state) }
        const res = await post(body)
        if (res && res.error === 'unauthorized') {
          setToken('')
          renderAll(false)
          toast('That token was rejected. Editing is locked again.')
          break
        }
        if (!res || !res.ok) throw new Error((res && res.error) || 'Bad response')
        // Only drop the op if nothing re-queued the same key while it was in flight.
        if (state.queue[0] === op) state.queue.shift()
        if (op.type === 'meta' && !state.queue.some((q) => q.type === 'meta')) state.metaEdited = false
        save()
      }
      backoff = 0
      setSync(idleStatus())
    } catch (err) {
      setSync('offline')
      backoff = Math.min(backoff + 1, 6)
      flushSoon(Math.min(60000, 2000 * 2 ** (backoff - 1)))
    } finally {
      flushing = false
    }
  }

  // Pull the Sheet and merge it in. Days: the Sheet wins, except days with a local
  // change still waiting to upload. Meta: whichever side has more scores wins; an
  // unsynced local edit with the same count but different content asks.
  async function pull() {
    if (!API) return
    if (token) setSync('syncing')
    let data
    try {
      const res = await fetch(API, { method: 'GET' })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      data = await res.json()
      if (!data || data.error) throw new Error((data && data.error) || 'Bad response')
    } catch (err) {
      setSync(token ? 'offline' : 'readonly')
      if (token && state.queue.length) flushSoon(4000)
      return
    }
    const serverDays = {}
    if (data.days && typeof data.days === 'object') {
      for (const k in data.days) {
        // Empty rows matter: they record a day that was cleared on another device.
        if (isDate(k)) serverDays[k] = cleanDone(data.days[k])
      }
    }
    const serverMeta = data.meta && typeof data.meta === 'object' ? { settings: cleanSettings(data.meta), scores: cleanScores(data.meta.scores) } : null

    if (!token) {
      // Read-only visitors mirror the Sheet exactly.
      state.checks = {}
      for (const k in serverDays) if (serverDays[k].length) state.checks[k] = serverDays[k]
      if (serverMeta) {
        state.settings = serverMeta.settings
        state.scores = serverMeta.scores
      }
      state.queue = []
      state.metaEdited = false
    } else {
      const pendingDays = new Set(state.queue.filter((q) => q.type === 'day').map((q) => q.date))
      for (const k in serverDays) {
        if (pendingDays.has(k)) continue
        if (serverDays[k].length) state.checks[k] = serverDays[k]
        else delete state.checks[k]
      }
      for (const k in state.checks) if (!(k in serverDays) && !pendingDays.has(k)) state.queue.push({ type: 'day', date: k })
      const pendingMeta = state.queue.some((q) => q.type === 'meta')
      if (!serverMeta) {
        if (!pendingMeta) state.queue.push({ type: 'meta' })
      } else if (JSON.stringify(serverMeta) !== JSON.stringify({ settings: state.settings, scores: state.scores })) {
        const takeServer = () => {
          state.settings = serverMeta.settings
          state.scores = serverMeta.scores
          state.queue = state.queue.filter((q) => q.type !== 'meta')
          state.metaEdited = false
        }
        const keepLocal = () => {
          if (!pendingMeta) state.queue.push({ type: 'meta' })
          state.metaEdited = true
        }
        if (!state.metaEdited) takeServer()
        else if (serverMeta.scores.length > state.scores.length) takeServer()
        else if (serverMeta.scores.length < state.scores.length) keepLocal()
        else if (confirm('Your settings or scores on this device differ from the saved copy in the Sheet.\n\nOK keeps the Sheet copy. Cancel keeps this device and uploads it.')) takeServer()
        else keepLocal()
      }
    }
    save()
    renderAll(false)
    if (token) flushSoon()
    else setSync('readonly')
  }

  let sel = null
  let C = compute()

  // ---------- render: monitor ----------
  function renderVitals() {
    const { P, now, streak, words, readiness } = C
    countUp($('#v-ready'), Math.round(readiness))
    countUp($('#v-days'), Math.max(0, between(now, P.test)))
    countUp($('#v-streak'), streak)
    $('#v-streak-u').textContent = streak === 1 ? 'day' : 'days'
    countUp($('#v-words'), words)
    $('#v-words-goal').textContent = `/ ${state.settings.vocabGoal}`
    const sub = $('#kp-sub')
    const wait = between(now, START)
    if (now < START) sub.textContent = `The plan starts ${fmtLong(START)}, in ${wait} day${wait === 1 ? '' : 's'}. Test day is ${fmtLong(P.test)}.`
    else if (now > P.last) sub.textContent = now === P.test ? 'Test day. You did the work. Go get it.' : `Test day was ${fmtLong(P.test)}.`
    else sub.textContent = `Test day is ${fmtLong(P.test)}. One heartbeat a day gets you there.`
  }

  const W = 6
  const BASE = 64
  const H = 112
  function renderEcg(animate) {
    const { P, now, days } = C
    const n = P.total
    const svg = $('#kp-ecg')
    svg.setAttribute('viewBox', `0 0 ${n * W} ${H}`)
    const ti = between(START, now)
    const lastSolid = Math.min(ti, n - 1)
    let line = `M0 ${BASE}`
    let miss = ''
    for (let i = 0; i <= lastSolid; i++) {
      const x = i * W
      const f = days[i].f
      if (f > 0) {
        const a = 48 * f
        line += ` L${x + 1.2} ${BASE} L${x + 1.8} ${BASE - 3 * f} L${x + 2.3} ${BASE} L${x + 2.7} ${BASE + 5 * f} L${x + 3.2} ${BASE - a} L${x + 3.8} ${BASE + 10 * f} L${x + 4.4} ${BASE} L${x + 5.2} ${BASE - 4 * f} L${x + W} ${BASE}`
      } else {
        line += ` L${x + W} ${BASE}`
        if (i < ti) miss += ` M${x + 3} ${BASE + 5} L${x + 3} ${BASE + 13}`
      }
    }
    if (ti < 0) line = ''
    $('#ecg-line').setAttribute('d', line)
    $('#ecg-glow').setAttribute('d', line)
    $('#ecg-miss').setAttribute('d', miss)
    const fx = Math.max(0, Math.min(n, ti + 1)) * W
    $('#ecg-future').setAttribute('d', fx < n * W ? `M${fx} ${BASE} L${n * W} ${BASE}` : '')
    $('#ecg-grid').innerHTML = P.phases
      .slice(1)
      .map((p) => {
        const x = between(START, p.start) * W
        return `<line class="ecg-phase" vector-effect="non-scaling-stroke" x1="${x}" x2="${x}" y1="6" y2="${H - 6}"></line>`
      })
      .join('')
    const dot = $('#kp-ecg-dot')
    if (ti >= 0 && ti < n) {
      dot.hidden = false
      dot.style.left = ((ti + 1) / n) * 100 + '%'
      dot.style.top = (BASE / H) * 100 + '%'
    } else dot.hidden = true
    const done = days.filter((d) => d.f > 0).length
    const missed = days.filter((d) => d.date < now && d.f === 0).length
    $('#kp-ecg-desc').textContent = `Study heartbeat across ${n} plan days: ${done} days with work done, ${missed} missed days, ${Math.max(0, n - Math.max(0, ti))} days ahead.`
    const cur = now >= START && now <= P.last ? phaseIndex(now, P) : -1
    $('#kp-phase-labels').innerHTML = P.phases
      .map((p, i) => {
        const left = (between(START, p.start) / n) * 100
        return `<span class="kp-pl${i % 3 ? ` r${i % 3}` : ''}${left > 80 ? ' end' : ''}${i === cur ? ' now' : ''}" style="left:${left}%"><b><span class="t">${esc(p.name)}</span><span class="n">${i + 1}</span></b>${fmt(p.start, { month: 'short' })}</span>`
      })
      .join('')
    if (animate && !reduced) {
      const wrap = $('#kp-ecg-wrap')
      wrap.classList.remove('draw')
      void wrap.offsetWidth
      wrap.classList.add('draw')
    }
  }

  // ---------- render: day card ----------
  function clampDate(d) {
    const { P } = C
    return d < START ? START : d > P.last ? P.last : d
  }
  function renderDay() {
    const { P, now } = C
    sel = clampDate(sel || now)
    const pi = phaseIndex(sel, P)
    const ph = P.phases[pi]
    const dayIn = between(ph.start, sel) + 1
    const len = between(ph.start, ph.end) + 1
    $('#kp-day-phase').textContent = `Phase ${pi + 1} · ${ph.name} · day ${dayIn} of ${len}`
    $('#kp-day-date').textContent = (sel === now ? 'Today, ' : '') + fmtLong(sel)
    const future = sel > now
    const locked = future || !canEdit()
    const wait = between(now, START)
    let note = ''
    if (future) note = now < START && sel === START ? `Day one. Opens in ${wait} day${wait === 1 ? '' : 's'}. You can look, but you can't check it off yet.` : "This day hasn't happened yet. You can look ahead, but you can't check it off."
    else if (!canEdit()) note = 'Read-only. Unlock editing in settings to check off tasks.'
    else if (between(sel, P.test) <= 2) note = 'Almost there. Keep it light.'
    $('#kp-day-note').textContent = note
    const list = $('#kp-tasks')
    list.innerHTML = ''
    const checked = state.checks[sel] || []
    tasksFor(sel, P).forEach((t, i) => {
      const li = el('li', 'kp-task')
      const on = checked.includes(t.text)
      li.classList.toggle('done', on)
      li.classList.toggle('locked', locked)
      const id = `kp-t-${i}`
      li.innerHTML = `<label for="${id}"><input type="checkbox" id="${id}" ${on ? 'checked' : ''} ${locked ? 'disabled' : ''} /><span class="kp-task-text">${esc(t.text)}${t.words ? `<span class="kp-badge">+${t.words} words</span>` : ''}</span></label>`
      li.querySelector('input').addEventListener('change', (e) => toggleTask(sel, t.text, e.target.checked, li))
      list.appendChild(li)
    })
    $('#kp-prev').disabled = sel <= START
    $('#kp-next').disabled = sel >= P.last
    $('#kp-today').disabled = sel === clampDate(now)
    renderRing()
  }
  function renderRing() {
    const day = C.days[between(START, sel)]
    const total = day ? day.tasks.length : 0
    const done = day ? Math.round(day.f * total) : 0
    $('#kp-ring-fg').style.strokeDashoffset = String(97.4 * (1 - (total ? done / total : 0)))
    $('#kp-ring-txt').textContent = `${done}/${total}`
    $('#kp-ring').setAttribute('aria-label', `${done} of ${total} tasks done`)
  }
  function toggleTask(date, text, on, li) {
    if (!canEdit()) return
    const list = new Set(state.checks[date] || [])
    on ? list.add(text) : list.delete(text)
    if (list.size) state.checks[date] = [...list]
    else delete state.checks[date]
    save()
    enqueue({ type: 'day', date })
    li.classList.toggle('done', on)
    const before = C.days[between(START, date)].f
    C = compute()
    renderRing()
    renderVitals()
    renderEcg(false)
    renderReadiness()
    renderHeat()
    renderPhases()
    if (before < 1 && C.days[between(START, date)].f === 1) {
      confetti()
      toast(C.streak > 1 && date === C.now ? `Day complete. ${C.streak}-day streak.` : 'Day complete. Nice work.')
    }
  }
  function go(d, flash) {
    sel = clampDate(d)
    renderDay()
    renderHeat()
    if (flash) {
      const card = $('#kp-day')
      card.classList.remove('flash')
      void card.offsetWidth
      card.classList.add('flash')
      card.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' })
    }
  }

  // ---------- render: readiness ----------
  function renderReadiness() {
    const { P, now, planPct, vocabPct, practicePct, readiness, behind, latest, words } = C
    const target = state.settings.target
    const status = $('#kp-status')
    const b = Math.round(behind * 10) / 10
    status.classList.toggle('behind', now >= START && now <= P.last && b > 2)
    if (now < START) status.textContent = `Not started yet. Day one is ${fmtLong(START)}.`
    else if (now > P.last) status.textContent = `The plan is over. Final readiness: ${Math.round(readiness)}%.`
    else if (b <= 2) status.textContent = b <= 0 ? 'On track. Fully caught up.' : `On track. ${b} day${b === 1 ? '' : 's'} of work open, which is fine.`
    else status.textContent = `${b} days of work behind. Try doubling up on a few days this week to catch up.`
    const bars = [
      ['Plan completed', planPct, 35, `${Math.round(planPct * 100)}% of all plan days`],
      ['Vocabulary', vocabPct, 25, `${words} of ${state.settings.vocabGoal} words`],
      ['Practice scores', practicePct, 40, `vs the ${target}% target`],
    ]
    $('#kp-bars').innerHTML = bars
      .map(
        ([name, pct, wt, sub]) =>
          `<div><div class="kp-bar-top"><span><b>${name}</b> · ${(pct * wt).toFixed(1)} of ${wt} pts</span><span>${sub}</span></div><div class="kp-bar" role="progressbar" aria-label="${name}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(pct * 100)}"><i style="width:${(pct * 100).toFixed(1)}%"></i></div></div>`,
      )
      .join('')
    $('#kp-tiles').innerHTML = SECTIONS.map((k) => {
      const v = latest[k]
      const has = typeof v === 'number'
      return `<div class="kp-tile${has && v >= target ? ' hit' : ''}"><span>${LABEL[k]}</span><b>${has ? v + '%' : '–'}</b><small>${has ? (v >= target ? 'at target' : `${target - v} to go`) : 'no score yet'}</small></div>`
    }).join('')
    $('#kp-formula').innerHTML = `Readiness <code>${readiness.toFixed(1)}%</code> = 35% × plan done (sum of daily task fractions ÷ ${P.total} days) + 25% × vocabulary (words ÷ ${state.settings.vocabGoal}) + 40% × practice (average over the 4 sections of min(1, latest score ÷ ${target}%)).`
  }

  // ---------- render: heatmap ----------
  function renderHeat() {
    const { P, now, days } = C
    const heat = $('#kp-heat')
    const months = $('#kp-heat-months')
    const lead = weekday(START)
    heat.innerHTML = ''
    months.innerHTML = ''
    for (let i = 0; i < lead; i++) heat.appendChild(el('span', 'pad'))
    const cols = Math.ceil((lead + days.length + 1) / 7)
    let lastMonth = -1
    for (let c = 0; c < cols; c++) {
      const first = addDays(START, c * 7 - lead)
      const shown = first < START ? START : first
      const m = parse(shown).getMonth()
      months.appendChild(el('span', '', m !== lastMonth ? fmt(shown, { month: 'short' }) : ''))
      lastMonth = m
    }
    const frag = document.createDocumentFragment()
    for (const d of days) {
      const b = el('button')
      b.type = 'button'
      const lvl = d.f === 0 ? 0 : d.f < 0.34 ? 1 : d.f < 0.67 ? 2 : d.f < 1 ? 3 : 4
      const cls = [`l${lvl}`]
      if (d.date < now && d.f === 0) cls.push('miss')
      if (d.date > now) cls.push('future')
      if (d.date === now) cls.push('today')
      if (d.date === sel) cls.push('sel')
      b.className = cls.join(' ')
      const done = Math.round(d.f * d.tasks.length)
      const what = d.date > now ? 'upcoming' : d.date < now && d.f === 0 ? 'missed' : `${done} of ${d.tasks.length} tasks done`
      b.setAttribute('aria-label', `${fmtLong(d.date)}: ${what}${d.date === now ? ', today' : ''}`)
      b.title = `${fmtShort(d.date)} · ${what}`
      b.addEventListener('click', () => go(d.date, true))
      frag.appendChild(b)
    }
    const test = el('button', 'test')
    test.type = 'button'
    test.disabled = true
    test.setAttribute('aria-label', `Test day, ${fmtLong(P.test)}`)
    test.title = `Test day · ${fmtShort(P.test)}`
    frag.appendChild(test)
    heat.appendChild(frag)
  }

  // ---------- render: phases ----------
  function renderPhases() {
    const { P, now, days } = C
    const cur = now >= START && now <= P.last ? phaseIndex(now, P) : -1
    $('#kp-phases').innerHTML = P.phases
      .map((p, i) => {
        const a = between(START, p.start)
        const z = between(START, p.end)
        const slice = days.slice(a, z + 1)
        const pct = slice.length ? (slice.reduce((n, d) => n + d.f, 0) / slice.length) * 100 : 0
        const yr = (s) => fmt(s, { month: 'short', day: 'numeric', year: 'numeric' })
        const cls = i === cur ? 'now' : p.end < now ? 'past' : ''
        return `<li class="${cls}"${i === cur ? ' aria-current="step"' : ''}><span class="kp-ph-name">${esc(p.name)}${i === cur ? '<em>Now</em>' : ''}</span><span class="kp-ph-pct">${Math.round(pct)}%</span><span class="kp-ph-meta">${fmtShort(p.start)} – ${yr(p.end)} · ${slice.length} days · ${esc(p.goal)}</span><span class="kp-ph-bar"><i style="width:${pct.toFixed(1)}%"></i></span></li>`
      })
      .join('')
  }

  // ---------- render: scores ----------
  function renderScores() {
    const target = state.settings.target
    const body = $('#kp-score-table tbody')
    const foot = $('#kp-score-table tfoot')
    const rows = [...state.scores].sort((a, b) => (a.date === b.date ? (b.id || 0) - (a.id || 0) : b.date.localeCompare(a.date)))
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="7" class="empty">No scores yet. Day one starts with a full practice test.</td></tr>`
      foot.innerHTML = ''
      return
    }
    const cell = (v) => (typeof v === 'number' ? `<td class="${v >= target ? 'hit' : ''}">${v}%</td>` : '<td>–</td>')
    const avg = (vals) => (vals.length ? Math.round(vals.reduce((a, b) => a + b, 0) / vals.length) : null)
    const dis = canEdit() ? '' : ' disabled'
    body.innerHTML = rows
      .map((r) => {
        const vals = SECTIONS.map((k) => r[k]).filter((v) => typeof v === 'number')
        return `<tr><td>${fmt(r.date, { month: 'short', day: 'numeric', year: 'numeric' })}</td>${SECTIONS.map((k) => cell(r[k])).join('')}${cell(avg(vals))}<td><button type="button" data-del="${r.id}" aria-label="Delete scores from ${fmtLong(r.date)}"${dis}>✕</button></td></tr>`
      })
      .join('')
    const colAvg = SECTIONS.map((k) => avg(rows.map((r) => r[k]).filter((v) => typeof v === 'number')))
    const all = rows.flatMap((r) => SECTIONS.map((k) => r[k]).filter((v) => typeof v === 'number'))
    foot.innerHTML = `<tr><td>Average</td>${colAvg.map(cell).join('')}${cell(avg(all))}<td></td></tr>`
  }

  // ---------- render: settings + editing lock ----------
  function renderSettings() {
    const f = $('#kp-set-form')
    f.elements.testDate.value = state.settings.testDate
    f.elements.target.value = state.settings.target
    f.elements.vocabGoal.value = state.settings.vocabGoal
    const off = !canEdit()
    for (const form of [f, $('#kp-score-form')]) for (const c of form.elements) c.disabled = off
    $('#kp-reset').disabled = off
    $('#kp-import').disabled = off
    $('#kp-import').parentElement.classList.toggle('disabled', off)
    $('#kp').classList.toggle('kp-readonly', off)
    if (API) {
      $('#kp-unlock').hidden = false
      $('#kp-unlock-form').hidden = !!token
      $('#kp-locked-row').hidden = !token
      $('#kp-save-hint').textContent = token
        ? 'Changes save in this browser right away, then sync to the Google Sheet in the background.'
        : 'Showing the saved progress from the Google Sheet. Unlock editing to make changes.'
    }
  }

  function renderAll(animate) {
    C = compute()
    renderVitals()
    renderEcg(animate)
    renderDay()
    renderReadiness()
    renderHeat()
    renderPhases()
    renderScores()
    renderSettings()
  }

  // ---------- events ----------
  $('#kp-prev').addEventListener('click', () => go(addDays(sel, -1)))
  $('#kp-next').addEventListener('click', () => go(addDays(sel, 1)))
  $('#kp-today').addEventListener('click', () => go(C.now))

  const scoreForm = $('#kp-score-form')
  scoreForm.elements.date.value = today()
  scoreForm.addEventListener('submit', (e) => {
    e.preventDefault()
    if (!canEdit()) return
    const entry = { id: Date.now(), date: scoreForm.elements.date.value }
    let any = false
    for (const k of SECTIONS) {
      const raw = scoreForm.elements[k].value.trim()
      if (raw === '') continue
      const v = Math.round(Number(raw))
      if (!(v >= 0 && v <= 100)) return toast(`${LABEL[k]} must be between 0 and 100.`)
      entry[k] = v
      any = true
    }
    if (!isDate(entry.date)) return toast('Pick a date.')
    if (!any) return toast('Enter at least one section score.')
    state.scores.push(entry)
    save()
    enqueue({ type: 'meta' })
    for (const k of SECTIONS) scoreForm.elements[k].value = ''
    renderAll(false)
    toast('Scores added.')
  })
  $('#kp-score-table').addEventListener('click', (e) => {
    const b = e.target.closest('[data-del]')
    if (!b || !canEdit()) return
    if (!confirm('Delete this score entry?')) return
    state.scores = state.scores.filter((s) => String(s.id) !== b.dataset.del)
    save()
    enqueue({ type: 'meta' })
    renderAll(false)
    toast('Entry deleted.')
  })

  const setForm = $('#kp-set-form')
  setForm.addEventListener('submit', (e) => {
    e.preventDefault()
    if (!canEdit()) return
    const testDate = setForm.elements.testDate.value
    const target = Math.round(Number(setForm.elements.target.value))
    const vocabGoal = Math.round(Number(setForm.elements.vocabGoal.value))
    if (!isDate(testDate) || testDate < MIN_TEST) return toast(`The test date must be on or after ${fmtShort(MIN_TEST)}, 2027, so every phase fits.`)
    if (!(target >= 1 && target <= 100)) return toast('Target must be between 1 and 100.')
    if (!(vocabGoal >= 10)) return toast('Vocab goal must be at least 10.')
    state.settings = { testDate, target, vocabGoal }
    save()
    enqueue({ type: 'meta' })
    renderAll(true)
    toast('Settings saved.')
  })

  $('#kp-export').addEventListener('click', () => {
    const { checks, scores, settings } = state
    const blob = new Blob([JSON.stringify({ checks, scores, settings }, null, 2)], { type: 'application/json' })
    const a = document.createElement('a')
    a.href = URL.createObjectURL(blob)
    a.download = `kprep-backup-${today()}.json`
    document.body.appendChild(a)
    a.click()
    a.remove()
    setTimeout(() => URL.revokeObjectURL(a.href), 1000)
    toast('Backup downloaded.')
  })
  // After replacing everything locally, queue every day that changed plus the meta row.
  function queueAllChanges(oldChecks) {
    const dates = new Set([...Object.keys(oldChecks), ...Object.keys(state.checks)])
    for (const date of dates) enqueue({ type: 'day', date })
    enqueue({ type: 'meta' })
  }
  $('#kp-import').addEventListener('change', (e) => {
    const file = e.target.files && e.target.files[0]
    if (!file || !canEdit()) return
    const reader = new FileReader()
    reader.onload = () => {
      try {
        const data = JSON.parse(String(reader.result))
        if (!data || typeof data !== 'object' || !('checks' in data || 'scores' in data)) throw new Error('bad')
        if (!confirm('Replace your current progress with this backup?')) return
        const old = state.checks
        const queue = state.queue
        state = normalize({ ...data, queue })
        save()
        queueAllChanges(old)
        renderAll(true)
        toast('Backup imported.')
      } catch (err) {
        toast("That file isn't a kprep backup.")
      } finally {
        e.target.value = ''
      }
    }
    reader.readAsText(file)
  })
  $('#kp-reset').addEventListener('click', () => {
    if (!canEdit()) return
    const msg = API ? 'Erase all progress, scores and settings, here and in the Google Sheet? This cannot be undone. Export a backup first if you might want it.' : 'Erase all progress, scores and settings? This cannot be undone. Export a backup first if you might want it.'
    if (!confirm(msg)) return
    const old = state.checks
    state = { ...defaults(), queue: state.queue }
    save()
    queueAllChanges(old)
    sel = null
    renderAll(true)
    toast('Everything reset.')
  })

  $('#kp-unlock-form').addEventListener('submit', async (e) => {
    e.preventDefault()
    const input = $('#kp-token')
    const t = input.value.trim()
    if (!t) return
    setSync('syncing')
    try {
      const prev = token
      token = t
      const res = await post({ type: 'ping' })
      token = prev
      if (res && res.error === 'unauthorized') {
        setSync(idleStatus())
        return toast('That token was rejected.')
      }
      if (!res || !res.ok) throw new Error('bad')
    } catch (err) {
      token = ''
      setSync('readonly')
      return toast("Couldn't reach the Sheet to check the token. Try again when you're online.")
    }
    setToken(t)
    input.value = ''
    renderAll(false)
    toast('Editing unlocked on this device.')
    pull()
  })
  $('#kp-lock').addEventListener('click', () => {
    if (state.queue.length && !confirm('Some changes have not synced yet. Lock anyway? They stay in this browser and upload the next time you unlock.')) return
    setToken('')
    renderAll(false)
    setSync(idleStatus())
    toast('Editing locked.')
  })

  window.addEventListener('online', () => {
    backoff = 0
    if (token) flushSoon()
    else pull()
  })
  window.addEventListener('offline', () => {
    if (token) setSync('offline')
  })
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && API && !state.queue.length && !flushing) pull()
  })

  // Clock in the monitor corner, and roll over at midnight without a reload.
  let lastDay = today()
  function tick() {
    const d = new Date()
    $('#kp-clock').textContent = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
    if (today() !== lastDay) {
      const wasToday = sel === clampDate(lastDay)
      lastDay = today()
      if (wasToday) sel = null
      renderAll(false)
    }
  }
  tick()
  setInterval(tick, 15000)

  renderAll(true)
  setSync(idleStatus())
  pull()
</script>
