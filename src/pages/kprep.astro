---
import Layout from '~/layouts/Layout.astro'

// Kaplan nursing admission test prep tracker. Everything is computed in the
// browser from the date and saved to localStorage first, then synced to a
// Google Sheet through an Apps Script web app (see apps-script/README.md).
// The token never ships in the build; it is pasted once into "Unlock editing".
const api = import.meta.env.PUBLIC_KPREP_API ?? ''
---

<Layout title="Kaplan prep" description="Daily tracker for the Kaplan nursing admission test: plan, vocabulary, practice scores and readiness.">
  <div class="kp" id="kp" data-api={api}>
    <header class="kp-head">
      <p class="kp-eyebrow">Kaplan nursing admission test</p>
      <h1>Prep tracker</h1>
      <p class="kp-sub" id="kp-sub">Eight months, seven phases, one heartbeat a day.</p>
    </header>

    <!-- Heart monitor -->
    <section class="kp-monitor" aria-labelledby="kp-mon-title">
      <div class="kp-mon-top">
        <h2 id="kp-mon-title"><span class="kp-rec" aria-hidden="true"></span>Patient: me · study vitals</h2>
        <div class="kp-mon-right">
          <span class="kp-sync" id="kp-sync" data-s="local" role="status" aria-live="polite"><i aria-hidden="true"></i><span id="kp-sync-txt">Saved in this browser</span></span>
          <span class="kp-mon-clock" id="kp-clock" aria-hidden="true"></span>
        </div>
      </div>
      <dl class="kp-vitals">
        <div class="kp-vital">
          <dt>Readiness</dt>
          <dd><span id="v-ready">0</span><small>%</small></dd>
        </div>
        <div class="kp-vital">
          <dt>Days to test</dt>
          <dd><span id="v-days">0</span></dd>
        </div>
        <div class="kp-vital">
          <dt>Streak</dt>
          <dd><span id="v-streak">0</span><small id="v-streak-u">days</small></dd>
        </div>
        <div class="kp-vital">
          <dt>Words learned</dt>
          <dd><span id="v-words">0</span><small id="v-words-goal">/ 3000</small></dd>
        </div>
      </dl>
      <div class="kp-ecg-box">
        <div class="kp-ecg-wrap" id="kp-ecg-wrap">
          <svg id="kp-ecg" class="kp-ecg" preserveAspectRatio="none" role="img" aria-labelledby="kp-ecg-desc">
            <title id="kp-ecg-desc">Study heartbeat for every day of the plan</title>
            <g id="ecg-grid"></g>
            <path id="ecg-future" class="ecg-future" vector-effect="non-scaling-stroke"></path>
            <path id="ecg-glow" class="ecg-glow" vector-effect="non-scaling-stroke"></path>
            <path id="ecg-line" class="ecg-line" vector-effect="non-scaling-stroke"></path>
            <path id="ecg-miss" class="ecg-miss" vector-effect="non-scaling-stroke"></path>
          </svg>
          <span class="kp-ecg-dot" id="kp-ecg-dot" aria-hidden="true"></span>
        </div>
        <div class="kp-phase-labels" id="kp-phase-labels" aria-hidden="true"></div>
      </div>
    </section>

    <!-- Day card -->
    <section class="kp-card kp-day" aria-labelledby="kp-day-date" id="kp-day">
      <div class="kp-day-head">
        <div>
          <p class="kp-day-phase" id="kp-day-phase"></p>
          <h2 id="kp-day-date"></h2>
        </div>
        <div class="kp-ring" id="kp-ring" role="img" aria-label="">
          <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="kp-ring-bg" cx="18" cy="18" r="15.5"></circle><circle class="kp-ring-fg" id="kp-ring-fg" cx="18" cy="18" r="15.5"></circle></svg>
          <span id="kp-ring-txt">0/0</span>
        </div>
      </div>
      <p class="kp-day-note" id="kp-day-note"></p>
      <ul class="kp-tasks" id="kp-tasks"></ul>
      <nav class="kp-day-nav" aria-label="Change day">
        <button type="button" id="kp-prev" aria-label="Previous day">← Prev</button>
        <button type="button" id="kp-today">Today</button>
        <button type="button" id="kp-next" aria-label="Next day">Next →</button>
      </nav>
    </section>

    <!-- How close am I -->
    <section class="kp-card" aria-labelledby="kp-close-title">
      <h2 id="kp-close-title">How close am I?</h2>
      <p class="kp-status" id="kp-status" role="status"></p>
      <div class="kp-bars" id="kp-bars"></div>
      <div class="kp-tiles" id="kp-tiles"></div>
      <p class="kp-formula" id="kp-formula"></p>
    </section>

    <!-- Heatmap -->
    <section class="kp-card" aria-labelledby="kp-heat-title">
      <div class="kp-row">
        <h2 id="kp-heat-title">Every day of the plan</h2>
        <span class="kp-legend" aria-hidden="true">less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> more <i class="miss"></i> missed</span>
      </div>
      <div class="kp-heat-scroll">
        <div class="kp-heat-months" id="kp-heat-months" aria-hidden="true"></div>
        <div class="kp-heat-body">
          <div class="kp-heat-days" aria-hidden="true"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div>
          <div class="kp-heat" id="kp-heat" role="group" aria-label="Plan days heatmap. Choose a day to open it."></div>
        </div>
      </div>
    </section>

    <!-- Phases -->
    <section class="kp-card" aria-labelledby="kp-phase-title">
      <h2 id="kp-phase-title">Phases</h2>
      <ol class="kp-phases" id="kp-phases"></ol>
    </section>

    <!-- Scores -->
    <section class="kp-card" aria-labelledby="kp-score-title">
      <h2 id="kp-score-title">Practice score log</h2>
      <form class="kp-score-form" id="kp-score-form">
        <label>Date<input type="date" name="date" required /></label>
        <label>Reading %<input type="number" name="reading" min="0" max="100" step="1" inputmode="numeric" /></label>
        <label>Math %<input type="number" name="math" min="0" max="100" step="1" inputmode="numeric" /></label>
        <label>Writing %<input type="number" name="writing" min="0" max="100" step="1" inputmode="numeric" /></label>
        <label>Science %<input type="number" name="science" min="0" max="100" step="1" inputmode="numeric" /></label>
        <button type="submit" class="kp-primary">Add scores</button>
      </form>
      <p class="kp-hint">Every section is optional. Leave a box empty if you didn't take it.</p>
      <div class="kp-table-scroll">
        <table class="kp-table" id="kp-score-table">
          <thead><tr><th scope="col">Date</th><th scope="col">Reading</th><th scope="col">Math</th><th scope="col">Writing</th><th scope="col">Science</th><th scope="col">Avg</th><th scope="col"><span class="sr-only">Delete</span></th></tr></thead>
          <tbody></tbody>
          <tfoot></tfoot>
        </table>
      </div>
    </section>

    <!-- Settings -->
    <section class="kp-card" aria-labelledby="kp-set-title">
      <h2 id="kp-set-title">Settings</h2>
      <form class="kp-set-form" id="kp-set-form">
        <label>Test date<input type="date" name="testDate" min="2027-06-10" required /></label>
        <label>Target score %<input type="number" name="target" min="1" max="100" step="1" required /></label>
        <label>Vocab goal<input type="number" name="vocabGoal" min="10" max="100000" step="10" required /></label>
        <button type="submit" class="kp-primary">Save settings</button>
      </form>
      <div class="kp-set-actions">
        <button type="button" id="kp-export">Export backup</button>
        <label class="kp-file">Import backup<input type="file" id="kp-import" accept="application/json,.json" /></label>
        <button type="button" id="kp-reset" class="kp-danger">Reset everything</button>
      </div>
      <p class="kp-hint" id="kp-save-hint">Progress is saved in this browser only. Export a backup to move it to another device.</p>
      <div class="kp-unlock" id="kp-unlock" hidden>
        <h3>Editing</h3>
        <form class="kp-unlock-form" id="kp-unlock-form" hidden>
          <label for="kp-token">Unlock editing<span>Paste your token once. It stays in this browser only.</span></label>
          <div class="kp-unlock-row">
            <input type="password" id="kp-token" name="token" autocomplete="off" spellcheck="false" placeholder="Token" required />
            <button type="submit" class="kp-primary">Unlock</button>
          </div>
        </form>
        <div class="kp-unlock-row" id="kp-locked-row" hidden>
          <p>Editing is unlocked on this device.</p>
          <button type="button" id="kp-lock">Lock</button>
        </div>
      </div>
    </section>

    <p class="kp-toast" id="kp-toast" role="status" aria-live="polite"></p>
  </div>
</Layout>

<style is:global>
  .kp {
    --kp-bg: #f3f8f7;
    --kp-card: #ffffff;
    --kp-ink: #12302b;
    --kp-muted: #587069;
    --kp-line: #d8e5e2;
    --kp-teal: #1f7a6c;
    --kp-teal-ink: #ffffff;
    --kp-teal-soft: #e2f1ed;
    --kp-red: #c2413b;
    --kp-red-soft: #f8e1df;
    --kp-amber: #a86a00;
    --kp-h0: #e5eeec;
    --kp-h1: #b7ddd4;
    --kp-h2: #7cc1b1;
    --kp-h3: #3c9886;
    --kp-h4: #1f7a6c;
    --kp-mon: #06110c;
    --kp-mon-2: #0b1d15;
    --kp-mon-line: #3be0a0;
    --kp-mon-dim: #5c8e79;
    --kp-mon-grid: rgba(59, 224, 160, 0.07);
    color: var(--kp-ink);
    background: var(--kp-bg);
    border-radius: 18px;
    padding: 18px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    font-variant-numeric: tabular-nums;
    margin-inline: -4px;
  }
  @media (prefers-color-scheme: dark) {
    .kp {
      --kp-bg: #0d1513;
      --kp-card: #141f1c;
      --kp-ink: #e2eeeb;
      --kp-muted: #8fa6a0;
      --kp-line: #24332f;
      --kp-teal: #3fb39f;
      --kp-teal-ink: #04130f;
      --kp-teal-soft: #183531;
      --kp-red: #ff7b72;
      --kp-red-soft: #3a1d1c;
      --kp-amber: #f2b84b;
      --kp-h0: #1b2825;
      --kp-h1: #1c463d;
      --kp-h2: #216657;
      --kp-h3: #2a8a76;
      --kp-h4: #3fb39f;
    }
  }
  .kp *, .kp *::before, .kp *::after { box-sizing: border-box; }
  .kp h1, .kp h2, .kp p { margin: 0; }
  .kp h2 { font-size: 1.05rem; font-weight: 650; letter-spacing: -0.01em; }
  .kp button, .kp input { font: inherit; color: inherit; }
  .kp :focus-visible { outline: 3px solid var(--kp-teal); outline-offset: 2px; border-radius: 6px; }
  .kp .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .kp-head h1 { font-size: 1.9rem; font-weight: 750; letter-spacing: -0.03em; line-height: 1.1; }
  .kp-eyebrow { color: var(--kp-teal); font-size: 0.78rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px !important; }
  .kp-sub { color: var(--kp-muted); margin-top: 6px !important; font-size: 0.95rem; }

  /* ---------- monitor ---------- */
  .kp-monitor {
    background:
      radial-gradient(120% 90% at 50% 0%, var(--kp-mon-2), var(--kp-mon) 70%),
      var(--kp-mon);
    color: var(--kp-mon-line);
    border-radius: 16px;
    padding: 16px 16px 12px;
    box-shadow: inset 0 0 0 1px rgba(59, 224, 160, 0.14), inset 0 0 40px rgba(0, 0, 0, 0.6), 0 10px 30px -12px rgba(6, 17, 12, 0.6);
    position: relative;
    overflow: hidden;
  }
  .kp-monitor::after {
    /* scanlines */
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .kp-mon-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .kp-mon-top h2 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--kp-mon-dim); font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .kp-rec { width: 8px; height: 8px; border-radius: 50%; background: #ff5a5a; box-shadow: 0 0 8px #ff5a5a; animation: kp-blink 1.6s steps(2, start) infinite; }
  .kp-mon-clock { font-size: 0.72rem; color: var(--kp-mon-dim); letter-spacing: 0.08em; }
  .kp-mon-right { display: flex; align-items: center; gap: 10px; position: relative; z-index: 1; }
  .kp-sync { display: inline-flex; align-items: center; gap: 6px; font-size: 0.68rem; letter-spacing: 0.04em; color: var(--kp-mon-line); border: 1px solid rgba(59, 224, 160, 0.3); border-radius: 999px; padding: 2px 9px 2px 7px; white-space: nowrap; }
  .kp-sync i { width: 7px; height: 7px; border-radius: 50%; background: var(--kp-mon-line); box-shadow: 0 0 6px var(--kp-mon-line); }
  .kp-sync[data-s='syncing'] i { animation: kp-pulse 0.9s ease-in-out infinite; }
  .kp-sync[data-s='offline'] { color: #f2c46b; border-color: rgba(242, 196, 107, 0.4); }
  .kp-sync[data-s='offline'] i { background: #f2c46b; box-shadow: 0 0 6px #f2c46b; }
  .kp-sync[data-s='readonly'], .kp-sync[data-s='local'] { color: var(--kp-mon-dim); border-color: rgba(92, 142, 121, 0.4); }
  .kp-sync[data-s='readonly'] i, .kp-sync[data-s='local'] i { background: var(--kp-mon-dim); box-shadow: none; }
  @keyframes kp-blink { to { visibility: hidden; } }
  .kp-vitals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 12px 0 10px; }
  .kp-vital { border-left: 2px solid rgba(59, 224, 160, 0.25); padding-left: 10px; min-width: 0; }
  .kp-vital dt { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--kp-mon-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kp-vital dd { margin: 2px 0 0; font-size: 1.9rem; font-weight: 700; line-height: 1; text-shadow: 0 0 12px rgba(59, 224, 160, 0.55); white-space: nowrap; }
  .kp-vital dd small { font-size: 0.7rem; font-weight: 500; margin-left: 3px; color: var(--kp-mon-dim); text-shadow: none; }
  .kp-vital:nth-child(2) dd { color: #f2f7a1; text-shadow: 0 0 12px rgba(242, 247, 161, 0.45); }
  .kp-vital:nth-child(3) dd { color: #7fd8ff; text-shadow: 0 0 12px rgba(127, 216, 255, 0.45); }
  .kp-vital:nth-child(4) dd { color: #ffb8e0; text-shadow: 0 0 12px rgba(255, 184, 224, 0.4); }

  .kp-ecg-box { position: relative; }
  .kp-ecg-wrap { position: relative; height: 120px; background-image: linear-gradient(var(--kp-mon-grid) 1px, transparent 1px), linear-gradient(90deg, var(--kp-mon-grid) 1px, transparent 1px); background-size: 12px 12px; border-radius: 6px; }
  .kp-ecg { width: 100%; height: 100%; display: block; overflow: visible; }
  .ecg-line { fill: none; stroke: var(--kp-mon-line); stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .ecg-glow { fill: none; stroke: var(--kp-mon-line); stroke-width: 6; opacity: 0.22; filter: blur(3px); stroke-linejoin: round; }
  .ecg-future { fill: none; stroke: var(--kp-mon-dim); stroke-width: 1.4; stroke-dasharray: 2 5; opacity: 0.7; }
  .ecg-miss { fill: none; stroke: #ff5a5a; stroke-width: 1.6; stroke-linecap: round; }
  .ecg-phase { stroke: rgba(59, 224, 160, 0.18); stroke-width: 1; stroke-dasharray: 3 3; }
  .kp-ecg-wrap.draw { animation: kp-draw 2.4s cubic-bezier(0.4, 0, 0.2, 1) both; }
  @keyframes kp-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .kp-ecg-dot { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #eafff6; box-shadow: 0 0 0 3px rgba(59, 224, 160, 0.35), 0 0 16px 4px var(--kp-mon-line); animation: kp-pulse 1.1s ease-in-out infinite; }
  .kp-ecg-dot[hidden] { display: none; }
  @keyframes kp-pulse { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.45); } 30% { transform: scale(0.95); } 45% { transform: scale(1.2); } }
  .kp-phase-labels { position: relative; height: 74px; margin-top: 6px; }
  .kp-pl { position: absolute; top: 0; font-size: 0.64rem; line-height: 1.25; color: var(--kp-mon-dim); white-space: nowrap; padding-left: 4px; border-left: 1px solid rgba(59, 224, 160, 0.3); }
  .kp-pl.r1 { top: 24px; }
  .kp-pl.r2 { top: 48px; }
  .kp-pl.end { transform: translateX(-100%); text-align: right; padding: 0 4px 0 0; border-left: 0; border-right: 1px solid rgba(59, 224, 160, 0.3); }
  .kp-pl b { display: block; color: var(--kp-mon-line); font-weight: 600; }
  .kp-pl.now b { text-shadow: 0 0 8px var(--kp-mon-line); }
  .kp-pl .n { display: none; }
  @media (max-width: 640px) {
    .kp-phase-labels { height: 30px; }
    .kp-pl.r1, .kp-pl.r2 { top: 0; }
    .kp-pl.end { transform: none; text-align: left; padding: 0 0 0 4px; border-right: 0; border-left: 1px solid rgba(59, 224, 160, 0.3); }
    .kp-pl .t { display: none; }
    .kp-pl .n { display: inline; }
  }

  /* ---------- cards ---------- */
  .kp-card { min-width: 0; background: var(--kp-card); border: 1px solid var(--kp-line); border-radius: 16px; padding: 18px; display: grid; gap: 12px; }
  .kp-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .kp-hint { color: var(--kp-muted); font-size: 0.82rem; }
  .kp button, .kp .kp-file { border: 1px solid var(--kp-line); background: var(--kp-card); border-radius: 10px; padding: 8px 14px; cursor: pointer; font-size: 0.9rem; font-weight: 550; transition: background 0.15s, border-color 0.15s; }
  .kp button:hover:not(:disabled), .kp .kp-file:hover { border-color: var(--kp-teal); background: var(--kp-teal-soft); }
  .kp button:disabled { opacity: 0.4; cursor: not-allowed; }
  .kp .kp-primary { background: var(--kp-teal); color: var(--kp-teal-ink); border-color: var(--kp-teal); }
  .kp .kp-primary:hover:not(:disabled) { background: var(--kp-teal); filter: brightness(1.08); }
  .kp .kp-danger { color: var(--kp-red); }
  .kp .kp-danger:hover:not(:disabled) { border-color: var(--kp-red); background: var(--kp-red-soft); }

  /* day card */
  .kp-day { border-top: 4px solid var(--kp-teal); }
  .kp-day-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .kp-day-head h2 { font-size: 1.25rem; }
  .kp-day-phase { color: var(--kp-teal); font-size: 0.8rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px !important; }
  .kp-day-note { color: var(--kp-muted); font-size: 0.88rem; }
  .kp-day-note:empty { display: none; }
  .kp-ring { position: relative; width: 58px; height: 58px; flex: none; }
  .kp-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .kp-ring circle { fill: none; stroke-width: 3.2; }
  .kp-ring-bg { stroke: var(--kp-h0); }
  .kp-ring-fg { stroke: var(--kp-teal); stroke-linecap: round; stroke-dasharray: 97.4; stroke-dashoffset: 97.4; transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
  .kp-ring span { position: absolute; inset: 0; display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; }
  .kp-tasks { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .kp-task label { display: flex; gap: 12px; align-items: flex-start; padding: 11px 12px; border: 1px solid var(--kp-line); border-radius: 12px; cursor: pointer; transition: background 0.15s, border-color 0.15s; }
  .kp-task label:hover { border-color: var(--kp-teal); }
  .kp-task input { appearance: none; flex: none; width: 22px; height: 22px; margin: 0; border: 2px solid var(--kp-muted); border-radius: 7px; display: grid; place-items: center; cursor: pointer; transition: all 0.15s; }
  .kp-task input::after { content: ''; width: 6px; height: 11px; border: solid var(--kp-teal-ink); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg) scale(0); margin-top: -2px; transition: transform 0.15s; }
  .kp-task input:checked { background: var(--kp-teal); border-color: var(--kp-teal); }
  .kp-task input:checked::after { transform: rotate(45deg) scale(1); }
  .kp-task.done label { background: var(--kp-teal-soft); border-color: transparent; }
  .kp-task.done .kp-task-text { text-decoration: line-through; text-decoration-color: var(--kp-teal); color: var(--kp-muted); }
  .kp-task.locked label { cursor: not-allowed; opacity: 0.6; }
  .kp-task.locked input { cursor: not-allowed; border-style: dashed; }
  .kp-task-text { line-height: 1.4; padding-top: 1px; }
  .kp-badge { display: inline-block; margin-left: 6px; font-size: 0.72rem; font-weight: 650; color: var(--kp-teal); background: var(--kp-teal-soft); border-radius: 999px; padding: 1px 8px; vertical-align: 1px; }
  .kp-task.done .kp-badge { background: var(--kp-card); }
  .kp-day-nav { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; }
  .kp-day-nav #kp-next { justify-self: end; }
  .kp-day-nav #kp-prev { justify-self: start; }
  .kp-day.flash { animation: kp-flash 0.7s ease-out; }
  @keyframes kp-flash { from { box-shadow: 0 0 0 4px var(--kp-teal-soft); } to { box-shadow: 0 0 0 0 transparent; } }

  /* readiness */
  .kp-status { padding: 10px 12px; border-radius: 10px; font-weight: 550; font-size: 0.92rem; background: var(--kp-teal-soft); }
  .kp-status.behind { background: var(--kp-red-soft); color: var(--kp-red); }
  .kp-bars { display: grid; gap: 10px; }
  .kp-bar-top { display: flex; justify-content: space-between; font-size: 0.86rem; margin-bottom: 4px; }
  .kp-bar-top span:last-child { color: var(--kp-muted); }
