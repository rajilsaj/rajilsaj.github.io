---
/**
 * Shared shell for the 100 Days Challenge pages (/run, /bingobook):
 * lime-on-navy palette, header with badge and black & white theme switch, footer.
 * Page-specific styles and scripts live in each page.
 */
interface Props {
  title: string
  description: string
  /** Emoji shown in the round badge next to the title */
  badge: string
  heading: string
  subtitle: string
}
const { title, description, badge, heading, subtitle } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0e13" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      try {
        var t = localStorage.getItem('run-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <style is:global>
      :root {
        --bg: #0b0e13;
        --card: #151b22;
        --card-2: #1b222b;
        --line: #252c35;
        --track: #2a323c;
        --text: #fff;
        --muted: #8b95a3;
        --lime: #c8f22b;
        --yellow: #fff;
        --blue: #fff;
        --red: #ff5c7a;
        --green: #c8f22b;
        --cyan: #fff;
        --orange: #fff;
        --purple: #fff;
        --bar: #c8f22b;
        --bar-track: rgba(200, 242, 43, 0.22);
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: dark;
      }
      :root[data-theme='light'] {
        --bg: #fff;
        --card: #f3f5f7;
        --card-2: #eaedf1;
        --line: #dde2e8;
        --track: #e3e7ec;
        --text: #0b0e13;
        --muted: #66707c;
        --lime: #c8f22b;
        --yellow: #0b0e13;
        --blue: #0b0e13;
        --red: #d7263d;
        --green: #6c9600;
        --cyan: #0b0e13;
        --orange: #0b0e13;
        --purple: #0b0e13;
        --bar: #c8f22b;
        --bar-track: #ebf8b8;
        --bar-pill-bg: #0b0e13;
        --bar-pill-text: #c8f22b;
        color-scheme: light;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--text); -webkit-text-size-adjust: 100%; }
      body {
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.3;
        min-height: 100vh;
        overflow-x: hidden;
      }
      main { max-width: 760px; margin: 0 auto; padding: 28px 16px 60px; }

      header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
      header .titles { flex: 1; min-width: 0; }

      /* black & white theme switch */
      .theme-toggle {
        flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; padding: 0;
        border: 2px solid var(--text);
        background: linear-gradient(90deg, #000 0 50%, #fff 50% 100%);
        box-shadow: 0 0 0 2px var(--bg), 0 2px 10px rgba(0, 0, 0, 0.3);
        transition: transform 0.35s ease;
      }
      .theme-toggle:hover { transform: rotate(180deg); }
      .theme-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
      :root[data-theme='light'] .theme-toggle { transform: rotate(180deg); }
      :root[data-theme='light'] .theme-toggle:hover { transform: rotate(360deg); }
      .badge {
        width: 52px; height: 52px; border-radius: 50%;
        background: var(--lime);
        display: grid; place-items: center; font-size: 26px; flex: none;
        box-shadow: 0 0 24px rgba(200, 242, 43, 0.3);
      }
      h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
      header p { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
      h2 { font-size: 1.2rem; font-weight: 700; margin: 26px 0 10px; }
      @media (max-width: 559px) {
        h1 { font-size: clamp(1.25rem, 6.2vw, 1.5rem); }
      }

      /* performance level chip: icon + level name + smiley */
      .lvl { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px 4px 6px; border-radius: 999px; background: var(--card-2); border: 1px solid var(--line); font-size: 0.78rem; font-weight: 700; color: var(--text); white-space: nowrap; line-height: 1; vertical-align: middle; }
      .lvl svg { width: 16px; height: 16px; flex: none; }
      .lvl .smile { font-size: 0.95rem; font-weight: 400; }

      /* pill button / link */
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; background: var(--bar-pill-bg); color: var(--bar-pill-text); border: 1px solid var(--track); font-weight: 700; font-size: 0.9rem; text-decoration: none; line-height: 1; cursor: pointer; min-height: 44px; }
      .btn:hover { border-color: var(--lime); }
      .btn:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }
      .btn.ghost { background: transparent; color: var(--text); }
      .btn svg { width: 18px; height: 18px; flex: none; }

      .note { color: var(--muted); font-size: 0.85rem; margin-top: 10px; }
      footer { color: var(--muted); font-size: 0.8rem; margin-top: 30px; text-align: center; }
      footer a { color: var(--muted); }
    </style>
    <slot name="head" />
  </head>
  <body>
    <main>
      <header>
        <div class="badge">{badge}</div>
        <div class="titles">
          <h1>{heading}</h1>
          <p>{subtitle}</p>
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode"></button>
      </header>

      <slot />

      <footer>Outdoor runs recorded with Apple Watch · <a href="/run">100 Days Challenge</a> · <a href="/">rajil.me</a></footer>
    </main>
    <script>
      // Black & white switch: toggles between dark (default) and light, remembered per browser.
      const root = document.documentElement
      const toggle = document.getElementById('theme-toggle')!
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!
      const applyTheme = (theme: 'dark' | 'light') => {
        root.dataset.theme = theme
        themeColor.content = theme === 'light' ? '#fff' : '#0b0e13'
        const label = theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
        toggle.setAttribute('aria-label', label)
        toggle.title = label
      }
      applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark')
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light'
        applyTheme(next)
        try { localStorage.setItem('run-theme', next) } catch {}
      })
    </script>
  </body>
</html>
